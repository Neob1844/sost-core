#!/usr/bin/env bash
# =============================================================================
# v15-final.env.example — TEMPLATE. Copy to v15-final.env and fill in.
#
# v15-final.env itself is gitignored (*.env) and MUST stay out of this public
# repository: it carries the real host, ssh key path and install paths.
#
# single source of truth for the V15 FINAL cutover.
# Sourced by the local drivers AND by the server-side executor.
# Edit here, nowhere else.
# =============================================================================

# ---- release identity -------------------------------------------------------
V15_CODE_COMMIT="16b50a4bf5e910e25862b3a54b41a9a80cf48b6c"
V15_BRANCH="release/v15-final-blockers"

# ---- authoritative SHA256 of the four release binaries ----------------------
# Full 64-hex digests. Any file that does not match is NEVER installed.
SHA_NODE="8c8ff89740d1b43a8c925d7d9ec398e4989a3d4de5759785aa84e3945b79bc4c"
SHA_CLI="7379d34b74a34463745ad0885c170d2ca3bbd77efadf689aef6039ae34c1dace"
SHA_MINER="1a21a962c67b400814edde214d52176c28538c35ae67c8a366d7fde6ad34b9ab"
SHA_SIGNTX="ac08c347ad315d3e1fb6bbbd49ebb6079ecdf5f1e914278a9df0f295e0fa67d9"

# ---- SHA256 of what is installed RIGHT NOW (pre-cutover, for sanity checks) --
SHA_NODE_PRE="f7c625fd7b203fd140f0142208ab1184fd69358187ececf36d13e9962d0e6661"
SHA_CLI_PRE="1a50a1cc599eaa96342cdcdde2eba8537a5c442d745c79dc9496cd518d73103c"
SHA_MINER_PRE="fb9eecddbc26a44fd95e2ba8fb800a5e34b45b02123100067aba6db4b297f041"
SHA_SIGNTX_PRE="3b1194deb22168c243b2ef9030977a1dbf6e80822d517b3aff2e7e80d44372a5"

# ---- the four binaries we install -------------------------------------------
V15_BINARIES=(sost-node sost-cli sost-miner sost-signtx)

# ---- IRREPLACEABLE STATE that lives in the SAME directory as the binaries ----
# /opt/sost/build is both the install dir and the node's WorkingDirectory, so
# these files sit next to the binaries. They are NEVER written by the cutover,
# but they ARE backed up before the service is stopped: TimeoutStopSec=30 means
# systemd SIGKILLs the node, and this box already has a
# chain.json.TAINTED-by-broken-binary-20260524_224347 from a previous swap.
V15_DATA_FILES=(chain.json wallet.json genesis_block.json popc_registry.json)

# ---- where the freshly built binaries live on the build machine -------------
BUILD_DIR="${BUILD_DIR:?set BUILD_DIR to your release build directory}"

# ---- VPS ---------------------------------------------------------------------
VPS_HOST="${VPS_HOST:?set VPS_HOST, e.g. user@your-node-host}"
VPS_SSH_KEY="${VPS_SSH_KEY:?set VPS_SSH_KEY, e.g. $HOME/.ssh/id_ed25519}"
VPS_INSTALL_DIR="${VPS_INSTALL_DIR:-/opt/sost/build}"
VPS_STAGING_DIR="${VPS_STAGING_DIR:-/opt/sost/v15final-staging}"
VPS_STATE_DIR="${VPS_STATE_DIR:-/opt/sost/v15final-state}"
VPS_LOCK_FILE="${VPS_LOCK_FILE:-/opt/sost/v15final.lock}"
VPS_NODE_SERVICE="${VPS_NODE_SERVICE:-sost-node}"
VPS_RPC_URL="${VPS_RPC_URL:-http://127.0.0.1:18232/}"
VPS_RPC_ENV="${VPS_RPC_ENV:-/etc/sost/rpc.env}"

# ---- consensus deadline ------------------------------------------------------
V15_HEIGHT=25000
CUTOVER_DEADLINE_HEIGHT=24900

# ---- health-check tuning -----------------------------------------------------
# Stability window: how long after start we re-check that the node did not enter
# a crash-loop. The unit drop-in uses RestartSec=10 / StartLimitBurst=10, so a
# crash-looping node still reads "active" seconds after start.
HEALTH_STABILITY_SECONDS="${HEALTH_STABILITY_SECONDS:-90}"
# How often we re-check during the stability window (a node that dies and is
# restarted mid-window must not slip through between two end-point samples).
HEALTH_STABILITY_POLL="${HEALTH_STABILITY_POLL:-5}"

# ---- clean-shutdown guard ----------------------------------------------------
# The unit has TimeoutStopSec=30, so systemd SIGKILLs a node that has not exited
# by then — with a 341 MB chain.json open in the same directory. A normal cutover
# must NEVER rely on that SIGKILL arriving. We therefore give the node a budget
# strictly BELOW the systemd timeout and abort the whole cutover if it is not
# gone by then, rather than forcing it. Nothing has been installed at that point,
# so aborting is free.
STOP_GRACE_SECONDS="${STOP_GRACE_SECONDS:-20}"     # must stay < TimeoutStopSec (30)
STOP_POLL_SECONDS="${STOP_POLL_SECONDS:-1}"
# Bounded wait for the NEXT block. Blocks land ~12 min apart, but the miner is
# external and real gaps of 14.4 h have been measured, so a timeout here is
# EXPLICITLY NOT a failure — it yields TIMEOUT_INCONCLUSIVE.
NEXTBLOCK_WAIT_SECONDS="${NEXTBLOCK_WAIT_SECONDS:-1800}"

# ---- command hooks (overridable ONLY so the test harness can simulate) -------
# Production leaves these at their defaults.
SYSTEMCTL="${SYSTEMCTL:-systemctl}"
CURL="${CURL:-curl}"
SYSTEMD_RUN="${SYSTEMD_RUN:-systemd-run}"

# ---- miner (untouched by the node scripts; listed for completeness) ----------
MINER_STATE_DIR="${MINER_STATE_DIR:-$HOME/.sost-v15final-cutover}"

# =============================================================================
# shared helpers
# =============================================================================
c_red()  { printf '\033[31m%s\033[0m\n' "$*"; }
c_grn()  { printf '\033[32m%s\033[0m\n' "$*"; }
c_ylw()  { printf '\033[33m%s\033[0m\n' "$*"; }
say()    { printf '[v15] %s\n' "$*"; }
ok()     { c_grn "[v15] OK    $*"; }
warn()   { c_ylw "[v15] WARN  $*"; }
die()    { c_red  "[v15] FATAL $*"; exit 1; }

sha256_of() { sha256sum "$1" | cut -d' ' -f1; }

# require_sha <file> <expected> <label> — aborts on any mismatch.
require_sha() {
  local f="$1" want="$2" label="$3" got
  [ -f "$f" ] || die "$label: file not found: $f"
  got="$(sha256_of "$f")"
  if [ "$got" != "$want" ]; then
    c_red "[v15] FATAL $label SHA256 MISMATCH — refusing to install"
    c_red "        file:     $f"
    c_red "        expected: $want"
    c_red "        actual:   $got"
    exit 1
  fi
  ok "$label sha256 verified ($want)"
}

# expected_sha_for <basename> — the release digest for one of the four binaries.
expected_sha_for() {
  case "$1" in
    sost-node)   printf '%s' "$SHA_NODE";;
    sost-cli)    printf '%s' "$SHA_CLI";;
    sost-miner)  printf '%s' "$SHA_MINER";;
    sost-signtx) printf '%s' "$SHA_SIGNTX";;
    *) return 1;;
  esac
}
