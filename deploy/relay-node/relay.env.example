# /etc/sost/relay.env  (root:sost 0640)
RPC_USER=sostrelay
# Reference node. Never this host's own address.
SOST_CONNECT=--connect seed.sostcore.com:19333
# Ports. Mainnet defaults are 19333 (P2P) / 18232 (RPC); change them on a host where
# they are taken (e.g. a machine whose miner reaches the reference node through an
# SSH tunnel on 127.0.0.1:18232). RPC always binds 127.0.0.1 only.
P2P_PORT=19333
RPC_PORT=18232
