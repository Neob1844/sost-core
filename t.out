:[]},{"name":"Western Queensland AusLAMP 1280m","hidden":false,"description":"1280m depth slice from the 3-D resistivity model derived from long-period magnetotelluric (MT) data collected from 162 sites in the western Queensland region. The data were collected for the Australian Lithospheric Architecture Magnetotelluric Project (AusLAMP) under Geoscience Australia's Exploring for the Future (EFTF) program with contributions from the Geological Survey of Queensland. The resistivity model maps the electrical resistivity structures in the region and provides information about the lithospheric architecture and geodynamic processes, as well as valuable precompetitive data for resource exploration in this region.","id":"wqa-new-magnetotellurics-1280m","proxyUrl":null,"proxyGetFeatureInfoUrl":null,"proxyCountUrl":null,"proxyStyleUrl":null,"proxyDownloadUrl":null,"mapStyles":null,"feature_count":0,"singleTile":false,"legendImg":null,"previewImg":null,"group":"Magnetotellurics","layerMode":"NA","cswRecords":[{"name":"Western Queensland AusLAMP resistivity model 1280m depth slice","resourceProvider":"Unknown","id":"1f25bf7670a7ca68386f47572b13691e8530effb","recordInfoUrl":"https://portal.auscope.org.au/geonetwork/srv/eng/catalog.search#/metadata/1f25bf7670a7ca68386f47572b13691e8530effb","description":"1280m depth slice from the 3-D resistivity model derived from long-period magnetotelluric (MT) data collected from 162 sites in the western Queensland region.  The data were collected for the Australian Lithospheric Architecture Magnetotelluric Project (AusLAMP) under Geoscience Australia's Exploring for the Future (EFTF) program with contributions from the Geological Survey of Queensland.  The resistivity model maps the electrical resistivity structures in the region and provides information about the lithospheric architecture and geodynamic processes, as well as valuable precompetitive data for resource exploration in this region.","noCache":false,"service":false,"adminArea":n