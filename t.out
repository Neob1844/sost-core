://thredds.nci.org.au/thredds/catalog/my80/AuScope_MT_collection/The_University_of_Adelaide_Legacy_MT_collection/States_and_Territories/NSW/catalog.html","type":"WWW","name":"NCI THREDDS Data Server","description":"","version":"","applicationProfile":"","protocolRequest":""}],"geographicElements":[{"type":"bbox","eastBoundLongitude":153.7687,"westBoundLongitude":140.6947,"northBoundLatitude":-27.9675,"southBoundLatitude":-37.6423}],"descriptiveKeywords":["magnetotellurics, electrical resistivity, impedance, long period, NSW",""],"datasetURIs":["10.4225/41/5a79326ea898d"],"constraints":["https://creativecommons.org/licenses/by/4.0/","RestrictionCode: license","Creative Commons Attribution 4.0 International"],"useLimitConstraints":["Creative Commons Attribution 4.0 International","RestrictionCode: license"],"accessConstraints":["RestrictionCode: license"],"childRecords":[],"date":"2019-07-15T00:00:00 UTC","minScale":null,"maxScale":null,"knownLayerIds":["auscope-mt-collection-4"],"knownLayerNames":["AuScope MT: Uni of Adelaide Legacy"],"knownLayerDescriptions":["Magnetotelluric survey data taken from the University of Adelaide Legacy Collection, created by the GeoPhysics 2030 Project, hosted by NCI. The collection contains individual survey grids of MT data derived conducted by The University of Adelaide or associated contractors. The datasets were collected predominantly under various grants/projects including: AuScope, AWAGS, AGOS, ARC LIEF, AusLAMP and NCRIS."]}],"relatedRecords":[],"capabilityRecords":[]},{"name":"3D Geoscience Models","hidden":false,"description":"Various geoscientific models sourced from Australian geological surveys and universities","id":"portal-geo-models","proxyUrl":null,"proxyGetFeatureInfoUrl":null,"proxyCountUrl":null,"proxyStyleUrl":null,"proxyDownloadUrl":null,"mapStyles":null,"feature_count":0,"singleTile":false,"legendImg":null,"previewImg":null,"group":"Models","layerMode":"NA","cswRecords":[{"name":"Sandstone, 2015: 3D Geomodel Series","resourceProvider":"Unknown","id":"9d8d8f91-39b9-454b-b47b-8bb231e710bc","recordInfoUrl":"https://portal.auscope.org.au/geonetwork/srv/eng/catalog.search#/metadata/9d8d8f91-39b9-454b-b47b-8bb231e710bc","description":"The Sandstone, 2015: 3D Geomodel Series contains both 3D and 2D geoscientific data that complements GSWA Record 2015/11. Themes vary between 3D and 2D, with the emphasis being on 3D modelling at 1:1 000 000 scale, while 2D data supports context for the region at various scales from 1:100 000 to 1:2 500 000 scale. The 3D and 2D data are held in Map Grid of Australia 1994 (MGA94) zone 50 eastings and northings.","noCache":false,"service":false,"adminArea":"Western Australia","contactOrg":"Western Australian Department of Mines, Industry Regulation and Safety - Geological Survey","contactPerson":null,"funderOrg":"Unknown","authors":[],"onlineResources":[{"url":"https://geomodels.auscope.org/model/sandstone","type":"WWW","name":"View 3D Geological Model","description":"","version":"","applicationProfile":"","protocolRequest":""},{"url":"https://dmpbookshop.eruditetechnologies.com.au/product/the-sandstone-greenstone-belt-northern-central-yilgarn-craton-3d-modelling-using-geological-and-geophysical-constraints.do","type":"Unsupported","name":"Download model report","description":"","version":"","applicationProfile":"","protocolRequest":""}],"geographicElements":[{"type":"bbox","eastBoundLongitude":119.51,"westBoundLongitude":118.99,"northBoundLatitude":-27.55,"southBoundLatitude":-28.34}],"descriptiveKeywords":["Western Australia","Earth Science","Earth Sciences","3D Geological Models","Earth Sciences"],"datasetURIs":[],"constraints":["Subject to licence agreement"],"useLimitConstraints":["Subject to licence agreement"],"accessConstraints":[],"childRecords":[],"date":"2025-06-19T00:00:00 UTC","minScale":1000000.0,"maxScale":null,"knownLayerIds":["portal-geo-models"],"knownLayerNames":["3D Geoscience Models"],"knownLayerDescriptions":["Various geoscientific models sourced from Australian geological surveys and universities"]},{"name":"3D Geological Model of North Queensland","resourceProvider":"Unknown","id":"15601807-c86f-409f-b27d-0d5ad8ea0d68","recordInfoUrl":"https://portal.auscope.org.au/geonetwork/srv/eng/catalog.search#/metadata/15601807-c86f-409f-b27d-0d5ad8ea0d68","description":"3D data for the Geoscience Australia Record 2009/029 - 3D Map and Supporting Geophysical Studies in the North Queensland Region","noCache":false,"service":false,"adminArea":"ACT","contactOrg":"Commonwealth of Australia (Geoscience Australia)","contactPerson":"MNHD","funderOrg":"Unknown","authors":["Meixner, A.J."],"onlineResources":[{"url":"https://d28rz98at9flks.cloudfront.net/69581/Rec2009_029.pdf","type":"WWW","name":"View Related PDF Report","description":"","version":"","applicationProfile":"","protocolRequest":""},{"url":"https://ecat.ga.gov.au/geonetwork/srv/eng/catalog.search?node=srv#/metadata/a05f7892-eeeb-7506-e044-00144fdd4fa6","type":"WWW","name":"Download Metadata","description":"","version":"","applicationProfile":"","protocolRequest":""},{"url":"https://geomodels.auscope.org/model/nqueensland","type":"WWW","name":"View 3D Geological Model","description":"","version":"","applicationProfile":"","protocolRequest":""}],"geographicElements":[{"type":"bbox","eastBoundLongitude":147.0,"westBoundLongitude":139.5,"northBoundLatitude":-17.0,"southBoundLatitude":-22.0}],"descriptiveKeywords":["Queensland","North Queensland","Earth Science","3D Geological Models","Earth Sciences"],"datasetURIs":[],"constraints":["https://creativecommons.org/licenses/by/4.0/"],"useLimitConstraints":["https://creativecommons.org/licenses/by/4.0/"],"accessConstraints":[],"childRecords":[],"date":"2025-06-19T00:00:00 UTC","minScale":null,"maxScale":null,"knownLayerIds":["portal-geo-models"],"knownLayerNames":["3D Geoscience Models"],"knownLayerDescriptions":["Various geoscientific models sourced from Australian geological surveys and universities"]},{"name":"Bendigo 3D model","resourceProvider":"Unknown","id":"3b3fa2fa-7967-470c-baef-45e6abbf1169","recordInfoUrl":"https://portal.auscope.org.au/geonetwork/srv/eng/catalog.search#/metadata/3b3fa2fa-7967-470c-baef-45e6abbf1169","description":"The document contains metadata-like information about each of the serial cross-sections created as part of the Bendigo Zone basement 3D modelling program. Discussions of constraints such as the biostratigraphy are included as are notes on issues that arose as a result of the construction of these sections. The full size 1:250000 sections and potential field and mapping datasets are available on request but these are not available for download.","noCache":false,"service":false,"adminArea":null,"contactOrg":"Geological Survey of Victoria","contactPerson":null,"funderOrg":"Unknown","authors":[],"onlineResources":[{"url":"https://geomodels.auscope.org/model/bendigo","type":"WWW","name":"View 3D Geological Model","description":"","version":"","applicationProfile":"","protocolRequest":""}],"geographicElements":[{"type":"bbox","eastBoundLongitude":149.56530105350984,"westBoundLongitude":140.51867286702068,"northBoundLatitude":-34.17659760706804,"southBoundLatitude":-39.692268022171106}],"descriptiveKeywords":["geology","Phanerozoic","3D Geological Models","Earth Science","Earth Sciences"],"datasetURIs":[],"constraints":[],"useLimitConstraints":[],"accessConstraints":[],"childRecords":[],"date":"2025-06-19T00:00:00 UTC","minScale":null,"maxScale":null,"knownLayerIds":["portal-geo-models"],"knownLayerNames":["3D Geoscience Models"],"knownLayerDescriptions":["Various geoscientific models sourced from Australian geological surveys and universities"]},{"name":"3D Geological Model of North Gawler Province - Understanding and modelling potential field anomalies.","resourceProvider":"Unknown","id":"bf9fc04e-682e-4918-a60c-15bde3ec2ea5","recordInfoUrl":"https://portal.auscope.org.au/geonetwork/srv/eng/catalog.search#/metadata/bf9fc04e-682e-4918-a60c-15bde3ec2ea5","description":"This model was produced by The South Australian Centre for Mineral Exploration Under Cover (CMXUC), a collaborative research initiative of the Government of South Australia and the University of Adelaide.\n\nIn this area, basement is buried beneath Neoproterozoic-Recent cover, of the Eastern Officer, Arckaringa and Eromanga Basins. The depth to basement horizon, shows the complex geometry of the Munyarai Trough which forms a foreland to the uplifted Musgrave Block; the Marla Overthrust Zone and Ammaroodinna Ridge which were uplifted after the deposition of Cambrian to Silurian sedimentary rocks; the Middle Bore Fault Zone which was last active during deposition of the Arckaringa Basin and the Wintinna Trough.\n\nLarge potential field anomalies have been observed in the Marla Region of Northern South Australia and have been used to define the northern limit of the Gawler Craton. This project’s aim was to model the source of those anomalies in order to understand the sources of those anomalies.","noCache":false,"service":false,"adminArea":"South Australia","contactOrg":"Geological Survey of South Australia","contactPerson":"George Gouthas","funderOrg":"Unknown","authors":["Gouthas, G."],"onlineResources":[{"url":"https://catalog.sarig.sa.gov.au/model/mesac25692","type":"WWW","name":"SARIG Catalogue Record","description":"","version":"","applicationProfile":"","protocolRequest":""},{"url":"https://dsd-gdp.s3.amazonaws.com/GDP00026_PDF.ZIP","type":"WWW","name":"Download Metadata and 3D PDF Reports","description":"","version":"","applicationProfile":"","protocolRequest":""},{"url":"https://geomodels.auscope.org/model/ngawler","type":"WWW","name":"View 3D Geological Model","description":"","version":"","applicationProfile":"","protocolRequest":""}],"geographicElements":[{"type":"bbox","eastBoundLongitude":134.4664,"westBoundLongitude":132.7053,"northBoundLatitude":-26.9293,"southBoundLatitude":-28.3847}],"descriptiveKeywords":["Magnetic Anomalies","Report","Earth Science","3D Geological Models","Earth Sciences"],"datasetURIs":[],"constraints":["https://creativecommons.org/licenses/by/4.0/"],"useLimitConstraints":["https://creativecommons.org/licenses/by/4.0/"],"accessConstraints":[],"childRecords":[],"date":"2025-12-09T00:00:00 UTC","minScale":null,"maxScale":null,"knownLayerIds":["portal-geo-models"],"knownLayerNames":["3D Geoscience Models"],"knownLayerDescriptions":["Various geoscientific models sourced from Australian geological surveys and universities"]},{"name":"3D MINERAL POTENTIAL OF THE QUAMBY AREA","resourceProvider":"Unknown","id":"5b7163f7-5313-416b-b6ac-6ec72751b166","recordInfoUrl":"https://portal.auscope.org.au/geonetwork/srv/eng/catalog.search#/metadata/5b7163f7-5313-416b-b6ac-6ec72751b166","description":"3D geological and geophysical modelling was used in conjunction with mineral potential modelling \nto assess unrealised Cu-Au potential in the Quamby area in the Eastern Succession of the Mount Isa \nInlier. This report documents the process used by the Geological Survey of Queensland, including 3D \nmodelling and geophysical inversion, to create a Common Earth Model (CEM) for 3D mineral potential \nmodelling over the Quamby Project area. The area is divided into three main geological domains, the \nMary Kathleen, Constantine and Soldiers Cap Domains (adapted from the North-West Queensland \nMineral and Energy Province Report (NWQMEPR), Geological Survey of Queensland, 2011b).\n The Quamby Project area contains the major operating Ernest Henry Cu-Au mine as well as other \nsignificant Cu-Au projects and is highly prospective for a range of mineralisation styles including \nCu±Au±Fe deposits and stratabound sediment-hosted Cu deposits. Mesozoic and Cenozoic sediments \ncover more than 70% of the project area. Although interpreted cover depths are generally less than \n150m, much of the area remains under-explored.\n\nA 3D geological model was created using GOCAD and SKUA software incorporating new \ninterpretations from recent mapping by the Geological Survey of Queensland (Geological Survey of \nQueensland, 2011b) as well as drillhole and seismic data. This 3D model was used as a starting model \nto constrain potential field inversions yielding 3D physical property models (density and magnetic \nsusceptibility).","noCache":false,"service":false,"adminArea":"Queensland","contactOrg":"Geological Survey of Queensland","contactPerson":null,"funderOrg":"Unknown","authors":["M L Greenwood","C R Dhnaram"],"onlineResources":[{"url":"https://geoscience.data.qld.gov.au/dataset/ds000006","type":"Unsupported","name":"Model Download","description":"","version":"","applicationProfile":"","protocolRequest":""},{"url":"https://geoscience.data.qld.gov.au/data/report/cr089698","type":"Unsupported","name":"Download model information","description":"","version":"","applicationProfile":"","protocolRequest":""},{"url":"https://geomodels.auscope.org/model/quamby","type":"WWW","name":"View 3D Geological Model","description":"","version":"","applicationProfile":"","protocolRequest":""}],"geographicElements":[{"type":"bbox","eastBoundLongitude":141.0,"westBoundLongitude":140.1,"northBoundLatitude":-20.0,"southBoundLatitude":-20.72}],"descriptiveKeywords":["Queensland","Quamby","3D Geological Models","Earth Sciences"],"datasetURIs":[],"constraints":["https://creativecommons.org/licenses/by/4.0/"],"useLimitConstraints":["https://creativecommons.org/licenses/by/4.0/"],"accessConstraints":[],"childRecords":[],"date":"2025-06-19T00:00:00 UTC","minScale":null,"maxScale":null,"knownLayerIds":["portal-geo-models"],"knownLayerNames":["3D Geoscience Models"],"knownLayerDescriptions":["Various geoscientific models sourced from Australian geological surveys and universities"]},{"name":"3D Geological Model of Rosebery Mt Lyell","resourceProvider":"Unknown","id":"c20396fc-6cee-437d-bec3-1b3608641574","recordInfoUrl":"https://portal.auscope.org.au/geonetwork/srv/eng/catalog.search#/metadata/c20396fc-6cee-437d-bec3-1b3608641574","description":"The Rosebery-Lyell 3D geological and geophysical model is an extension and refinement of previous MRT 3D models in the region.  It expresses a new structural synthesis based on mapping and multiple cross sections produced by numerous geologists over several decades. It extends to a depth of 10 km within the area depicted at left.  The model is constrained by 3D geophysical modelling using MRT's gravity and magnetic survey data coupled with drilling and rock physical property databases.   This information has been used to derive uncertainty estimates for each element in the model volume.  The model files also include nominal density and magnetic susceptibility estimates obtained for each voxel, thus incorporating intra-unit variations.","noCache":false,"service":false,"adminArea":"Tasmania","contactOrg":"Mineral Resources Tasmania","contactPerson":"Daniel Bombardieri","funderOrg":"Unknown","authors":[],"onlineResources":[{"url":"https://geomodels.auscope.org/model/rosebery","type":"WWW","name":"View 3D Geological Model","description":"","version":"","applicationProfile":"","protocolRequest":""},{"url":"https://www.mrt.tas.gov.au/geoscience/3d_geological_and_geophysical_modelling/west_tasmania_3d_geological_and_geophysical_modelling","type":"Unsupported","name":"Model Information Page","description":"","version":"","applicationProfile":"","protocolRequest":""},{"url":"https://doi.org/10.3390/min11111195","type":"DOI","name":"Bombardieri, D., Duffett, M., McNeill, A., Cracknell, M. and Reading, A. 2021. Insights and Lessons from 3D Geological and Geophysical Modeling of Mineralized Terranes in Tasmania. Minerals, 11(11):1195.","description":"Citation Information","version":"","applicationProfile":"","protocolRequest":""}],"geographicElements":[{"type":"bbox","eastBoundLongitude":145.80020084,"westBoundLongitude":145.22452006,"northBoundLatitude":-41.58299022,"southBoundLatitude":-42.26579909}],"descriptiveKeywords":["Mt Lyell","Earth Science","3D Geological Models","Earth Sciences"],"datasetURIs":[],"constraints":["https://creativecommons.org/licenses/by/4.0/"],"useLimitConstraints":["https://creativecommons.org/licenses/by/4.0/"],"accessConstraints":[],"childRecords":[],"date":"2025-06-19T00:00:00 UTC","minScale":null,"maxScale":null,"knownLayerIds":["portal-geo-models"],"knownLayerNames":["3D Geoscience Models"],"knownLayerDescriptions":["Various geoscientific models sourced from Australian geological surveys and universities"]},{"name":"Windimurra, 2015: 3D Geomodel Series","resourceProvider":"Unknown","id":"1a547dc6-30ce-4d75-a4bf-57f9f3ea37c8","recordInfoUrl":"https://portal.auscope.org.au/geonetwork/srv/eng/catalog.search#/metadata/1a547dc6-30ce-4d75-a4bf-57f9f3ea37c8","description":"The Windimurra, 2015: 3D Geomodel Series contains both 3D and 2D geoscientific data that complements GSWA Record 2015/12. Themes vary between 3D and 2D, with the emphasis being on 3D modelling at 1:1 000 000 scale, while 2D data supports context for the region at various scales from 1:100 000 to 1:2 500 000 scale. The 3D and 2D data are held in Map Grid of Australia 1994 (MGA94) zone 50 eastings and northings.","noCache":false,"service":false,"adminArea":"Western Australia","contactOrg":"Western Australian Department of Mines, Industry Regulation and Safety - Geological Survey","contactPerson":null,"funderOrg":"Unknown","authors":[],"onlineResources":[{"url":"https://geomodels.auscope.org/model/windimurra","type":"WWW","name":"View 3D Geological Model","description":"","version":"","applicationProfile":"","protocolRequest":""},{"url":"https://dasc.dmirs.wa.gov.au/home?productAlias=Windimurra3D","type":"Unsupported","name":"Download Windimurra 3D model data","description":"","version":"","applicationProfile":"","protocolRequest":""}],"geographicElements":[{"type":"bbox","eastBoundLongitude":119.12,"westBoundLongitude":117.55,"northBoundLatitude":-27.57,"southBoundLatitude":-29.37}],"descriptiveKeywords":["Western Australia","Earth Science","Earth Science","3D Geological Models","Earth Sciences"],"datasetURIs":[],"constraints":["Subject to licence agreement"],"useLimitConstraints":["Subject to licence agreement"],"accessConstraints":[],"childRecords":[],"date":"2025-06-19T00:00:00 UTC","minScale":1000000.0,"maxScale":null,"knownLayerIds":["portal-geo-models"],"knownLayerNames":["3D Geoscience Models"],"knownLayerDescriptions":["Various geoscientific models sourced from Australian geological surveys and universities"]},{"name":"3D model of the greater McArthur Basin","resourceProvider":"Unknown","id":"d9050168-2450-429e-8be2-b683826b0a50","recordInfoUrl":"https://portal.auscope.org.au/geonetwork/srv/eng/catalog.search#/metadata/d9050168-2450-429e-8be2-b683826b0a50","description":"The Northern Territory Geological Survey (NTGS) is building 3D structural models of the greater McArthur Basin (Northern Territory, Australia). The models are generated from a series of 1D, 2D and 3D data. The present DIP contains an amended model based on the previous regional model of the Wilton package, amended on the western margin using new field data (completed 07/11/2015).\nIn terms of digital data, the DIP contains 2D GIS objects, 2D cross sections and 3D digital objects grouped as wells, faults and horizons. These objects were used to build previous released models (Bruna and Dhu 2016) but are not necessarily used in the present model update. Newly considered data are summarised herein. The model currently provided in this update is the following:\nRegional model of the Wilton package, amended on the south eastern section of the Mallapunyah fault, in the Tanumbirini area (completed 15/06/2016)\nThis report provides a short explanation of how objects were created and lists the names of these objects. The data objects and GOCAD project are all referenced in GDA 94 zone 53.","noCache":false,"service":false,"adminArea":"NT","contactOrg":"Northern Territory Geological Survey (NTGS)","contactPerson":null,"funderOrg":"Unknown","authors":["P-O. Bruna","T. Dhu"],"onlineResources":[{"url":"https://geoscience.nt.gov.au/gemis/ntgsjspui/handle/1/81751","type":"WWW","name":"Download Digital Information Package","description":"","version":"","applicationProfile":"","protocolRequest":""},{"url":"https://geomodels.auscope.org/model/mcarthur","type":"WWW","name":"View 3D Geological Model","description":"","version":"","applicationProfile":"","protocolRequest":""}],"geographicElements":[{"type":"bbox","eastBoundLongitude":135.5984,"westBoundLongitude":132.5142,"northBoundLatitude":-13.9739,"southBoundLatitude":-17.525}],"descriptiveKeywords":["Northern Territory","McArthur Basin","3D Geological Models","Earth Sciences"],"datasetURIs":[],"constraints":["https://creativecommons.org/licenses/by/4.0/"],"useLimitConstraints":["https://creativecommons.org/licenses/by/4.0/"],"accessConstraints":[],"childRecords":[],"date":"2025-06-19T00:00:00 UTC","minScale":null,"maxScale":null,"knownLayerIds":["portal-geo-models"],"knownLayerNames":["3D Geoscience Models"],"knownLayerDescriptions":["Various geoscientific models sourced from Australian geological surveys and universities"]},{"name":"3D Geological Map of the southern New England Orogen western Tamworth Belt","resourceProvider":"Unknown","id":"74df8347-92ef-46fc-a230-a43edb6a1def","recordInfoUrl":"https://portal.auscope.org.au/geonetwork/srv/eng/catalog.search#/metadata/74df8347-92ef-46fc-a230-a43edb6a1def","description":"A regional scale structural and stratigraphic 3D model has been developed for the western \nTamworth Belt within the New England Orogen in northeastern New South Wales. \nThe western Tamworth Belt is bound by the crustal scale Hunter-Mooki and Peel-Manning Fault \nsystems, which together form a wedge of deformed Devonian to Permian rocks. \nThe model consists of broad lithological volumes representing Devonian, Devonian-Carboniferous, \nCarboniferous and Permian rocks that are folded and offset by numerous second and third \norder fault systems with minor intrusion by Permian granitoids. \nThe model is based on a \nseries of 2 dimensional cross sections developed based on the integration of surface mapping, \n16 reflection seismic profiles as well as magnetic and gravity data. \nInterpretation confidence volumes are provided with the model to visually represent constraint\nlocation and constraint quality. The results of the modelling provide a basis for understanding\nthe regional structural architecture  and  controls  on  mineral  systems. The  model  illustrates\n the contrast  in deformation style from the northern Tamworth Belt, relative to the southeast of\nthe belt that is more structurally complex in terms of folding and faulting. The distribution of\nknown hydrothermal mineral systems in the Tamworth Belt appear closely linked to the fault-architecture, \nwith most occurring around steep west-dipping fault zones that intersect or splay from the \nHunter-Mooki Fault at depth. Faults of this style are more common in the southeastern Tamworth Belt\nthan they are to the north.","noCache":false,"service":false,"adminArea":"NSW","contactOrg":"The Department of Regional New South Wales","contactPerson":null,"funderOrg":"Unknown","authors":["Jamie Robinson","Glen Phillips"],"onlineResources":[{"url":"https://search.geoscience.nsw.gov.au/report/R00035231?q=3D%20Geological%20Map%20of%20the%20southern%20New%20England%20Orogen%20western%20Tamworth%20Belt&sort=score%20desc&t=all&a=true&p=false&s=false","type":"WWW","name":"Download PDF Report","description":"","version":"","applicationProfile":"","protocolRequest":""},{"url":"https://www.resources.nsw.gov.au/geological-survey/products-and-data/3d-geological-mapping-data","type":"WWW","name":"Download 3D Models","description":"","version":"","applicationProfile":"","protocolRequest":""},{"url":"https://geomodels.auscope.org/model/tamworth","type":"WWW","name":"View 3D Geological Model","description":"","version":"","applicationProfile":"","protocolRequest":""}],"geographicElements":[{"type":"bbox","eastBoundLongitude":153.67,"westBoundLongitude":149.0,"northBoundLatitude":-28.0,"southBoundLatitude":-33.0}],"descriptiveKeywords":["New South Wales","Tamworth","Earth Science","3D Geological Models","Earth Sciences"],"datasetURIs":[],"constraints":["https://creativecommons.org/licenses/by/4.0/"],"useLimitConstraints":["https://creativecommons.org/licenses/by/4.0/"],"accessConstraints":[],"childRecords":[],"date":"2025-06-19T00:00:00 UTC","minScale":null,"maxScale":null,"knownLayerIds":["portal-geo-models"],"knownLayerNames":["3D Geoscience Models"],"knownLayerDescriptions":["Various geoscientific models sourced from Australian geological surveys and universities"]},{"name":"3D geological model of the Otway and Torquay Basin 2011","resourceProvider":"Unknown","id":"5ebc3cb7-a3b5-4760-a8ff-851d5d5beb32","recordInfoUrl":"https://portal.auscope.org.au/geonetwork/srv/eng/catalog.search#/metadata/5ebc3cb7-a3b5-4760-a8ff-851d5d5beb32","description":"A 3D model of the Otway and Torquay basins has been produced at 1:250 000 scale as part of GeoScience Victorias state-wide 3D geological model. To date there has been a “knowledge gap” in the transition between the basement and basin environments. This regional scale integration of the basement and basin models addresses this gap and provides a regional framework within which more detailed work can be carried out in the future.\n\nThe construction and integration of the basin model has involved both the interpretation and building of new faults and stratigraphic surfaces, as well as utilising existing stratigraphic surfaces and structural interpretations from previous studies, predominantly the Otway Basin HSA SEEBASE project by FrOG Tech (Jorand et. al., 2010).","noCache":false,"service":false,"adminArea":"Victoria","contactOrg":"Earth Resources Victoria","contactPerson":"Anthony Hurst","funderOrg":"Unknown","authors":[],"onlineResources":[{"url":"https://gsv.vic.gov.au/SearchAssistant2/search?q=parent_id:37363","type":"WWW","name":"View Reports","description":"","version":"","applicationProfile":"","protocolRequest":""},{"url":"https://gsv.vic.gov.au/SearchAssistant2/search?q=parent_id:107513","type":"WWW","name":"Download Metadata and 3D model data","description":"","version":"","applicationProfile":"","protocolRequest":""},{"url":"https://geomodels.auscope.org/model/otway","type":"WWW","name":"View 3D Geological Model","description":"","version":"","applicationProfile":"","protocolRequest":""}],"geographicElements":[{"type":"bbox","eastBoundLongitude":144.0,"westBoundLongitude":143.0,"northBoundLatitude":-38.4,"southBoundLatitude":-39.4}],"descriptiveKeywords":["Victoria","Otway Basin","Torquay Basin","Earth Science","3D Geological Models","Earth Sciences"],"datasetURIs":[],"constraints":["https://creativecommons.org/licenses/by/4.0/"],"useLimitConstraints":["https://creativecommons.org/licenses/by/4.0/"],"accessConstraints":[],"childRecords":[],"date":"2025-12-09T00:00:00 UTC","minScale":null,"maxScale":null,"knownLayerIds":["portal-geo-models"],"knownLayerNames":["3D Geoscience Models"],"knownLayerDescriptions":["Various geoscientific models sourced from Australian geological surveys and universities"]}],"relatedRecords":[],"capabilityRecords":[]},{"name":"National Virtual Core Library V-2.0","hidden":false,"description":"A collection of services implementing the National Virtual Core Library Profile v2 for gsml:Borehole and a collection of observations","id":"nvcl-v2-borehole","proxyUrl":"doBoreholeViewFilter.do","proxyGetFeatureInfoUrl":null,"proxyCountUrl":null,"proxyStyleUrl":null,"proxyDownloadUrl":"doNVCLBoreholeViewCSVDownload.do","mapStyles":null,"feature_count":0,"singleTile":false,"legendImg":null,"previewImg":null,"group":"Boreholes","layerMode":"NA","filterCollection":{"optionalFilters":[{"label":"Name","xpath":"gsmlp:name","value":null,"predicate":"ISLIKE","toolTi