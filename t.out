atasetURIs":["10.25914/5f224f0797a66"],"constraints":["https://creativecommons.org/licenses/by/4.0/","RestrictionCode: restricted","Creative Commons Attribution 4.0 International","RestrictionCode: license"],"useLimitConstraints":["Creative Commons Attribution 4.0 International","RestrictionCode: license"],"accessConstraints":["RestrictionCode: restricted"],"childRecords":[],"date":"2018-04-11T00:00:00 UTC","minScale":null,"maxScale":null,"knownLayerIds":["aster-aloh"],"knownLayerNames":["AlOH group composition"],"knownLayerDescriptions":["1. Band ratio: B5/B7Blue is well ordered kaolinite, Al-rich muscovite/illite, paragonite, pyrophyllite Red is Al-poor Si-rich) muscovite phengite)"]}],"relatedRecords":[],"capabilityRecords":[]},{"name":"Ferrous iron index","hidden":false,"description":"1. Band ratio: B5/B4Blue is low abundance, Red is high abundance","id":"aster-ferrous","proxyUrl":null,"proxyGetFeatureInfoUrl":null,"proxyCountUrl":null,"proxyStyleUrl":null,"proxyDownloadUrl":null,"mapStyles":null,"feature_count":0,"singleTile":false,"legendImg":null,"previewImg":null,"group":"ASTER Mineral Maps","layerMode":"NA","cswRecords":[{"name":"National ASTER Map Ferrous iron index","resourceProvider":"Resources Division","id":"f3532_2246_1929_4927","recordInfoUrl":"https://geonetwork.nci.org.au/geonetwork/srv/eng/catalog.search#/metadata/f3532_2246_1929_4927","description":"1. Band ratio: B5/B4 Blue is low abundance, Red is high abundance\r\nThis product can help map exposed \"fresh\" (un-oxidised) rocks (warm colours) especially mafic and ultramafic lithologies rich in ferrous silicates (e.g. actinolite, chlorite) and/or ferrous carbonates (e.g. ferroan dolomite, ankerite, siderite). Applying an MgOH Group content mask to this product helps to isolate ferrous bearing non-OH bearing minerals like pyroxenes (e.g. jadeite) from OH-bearing or carbonate-bearing ferrous minerals like actinolite or ankerite, respectively. Also combine with the FeOH Group content product to find evidence for ferrous-bearing chlorite (e.g. chamosite).\n\n\n--\nThis record represents data published by NCI. It uses catalogue metadata modified from Geoscience Australia. See our Record Lineage Information for more details.","noCache":false,"service":false,"adminArea":null,"contactOrg":"Commonwealth Scientific & Industrial Research Organisation (CSIRO)","contactPerson":"Cudahy, T.","funderOrg":"Unknown","authors":["Cudahy, T.","Caccetta, M.","Lau, I.","Rodger, A.","Laukamp, C.","Ong, C.","Chia, J.","Collings, S.","Rankine, T.","Fraser, R.","Woodcock, R.","Vote, J.","Warren, P.","Thomas, M.","Tyler, I.","Mauger, A.","Close, D.","Jones, M.","Abrams, M.","Cudahy, T.","Caccetta, M.","Lau, I.","Rodger, A.","Laukamp, C.","Ong, C.","Chia, J.","Collings, S.","Rankine, T.","Fraser, R.","Woodcock, R.","Vote, J.","Warren, P.","Thomas, M.","Tyler, I.","Mauger, A.","Close, D.","Jones, M.","Abrams, M.","Cudahy, T.","Caccetta, M.","Lau, I.","Rodger, A.","Laukamp, C.","Ong, C.","Chia, J.","Collings, S.","Rankine, T.","Fraser, R.","Woodcock, R.","Vote, J.","Warren, P.","Thomas, M.","Tyler, I.","Mauger, A.","Close, D.","Jones, M.","Abrams, M.","Cudahy, T.","Caccetta, M.","Lau, I.","Rodger, A.","Laukamp, C.","Ong, C.","Chia, J.","Collings, S.","Rankine, T.","Fraser, R.","Woodcock, R.","Vote, J.","Warren, P.","Thomas, M.","Tyler, I.","Mauger, A.","Close, D.","Jones, M.","Abrams, M."],"onlineResources":[{"url":"https://gsky.nci.org.au/ows/aster?service=WMS&version=1.1.1&request=GetCapabilities","type":"WMS","name":"Ferrous_Iron_Index","description":"NCI GSKY Web Map Service (WMS)","version":"1.1.1","applicationProfile":"","protocolRequest":""},{"url":"https://gsky.nci.org.au/ows/aster?service=WCS&version=1.0.0&request=GetCapabilities","type":"WCS","name":"Ferrous_Iron_Index","description":"NCI GSKY Web Coverage Service (WCS)","version":"","applicationProfile":"","protocolRequest":""},{"url":"https://thredds.nci.org.au/thredds/dodsC/wx7/aster/vnir/Aus_Mainland/Aus_Mainland_Ferrous_Iron_Index_reprojected.nc4.html","type":"Unsupported","name":"Ferrous_Iron_Index","description":"NCI OPeNDAP landing page - mainland Australia","version":"","applicationProfile":"","protocolRequest":""},{"url":"https://thredds.nci.org.au/thredds/dodsC/wx7/aster/vnir/Tasmania/Tas_Ferrous_Iron_index_reprojected.nc4.html","type":"Unsupported","name":"Ferrous_Iron_Index","description":"NCI OPeNDAP landing page - Tasmania","version":"","applicationProfile":"","protocolRequest":""},{"url":"https://thredds.nci.org.au/thredds/ncss/grid/wx7/aster/vnir/Aus_Mainland/Aus_Mainland_Ferrous_Iron_Index_reprojected.nc4/dataset.html","type":"WWW","name":"Ferrous_Iron_Index","description":"NCI NetCDF Subset Service - mainland Australia","version":"","applicationProfile":"","protocolRequest":""},{"url":"https://thredds.nci.org.au/thredds/ncss/grid/wx7/aster/vnir/Tasmania/Tas_Ferrous_Iron_index_reprojected.nc4/dataset.html","type":"WWW","name":"Ferrous_Iron_Index","description":"NCI NetCDF Subset Service - Tasmania","version":"","applicationProfile":"","protocolRequest":""},{"url":"https://thredds.nci.org.au/thredds/fileServer/wx7/aster/vnir/Aus_Mainland/Aus_Mainland_Ferrous_Iron_Index_reprojected.nc4","type":"WWW","name":"Ferrous_Iron_Index","description":"NCI NetCDF file download via HTTP - mainland Australia","version":"","applicationProfile":"","protocolRequest":""},{"url":"https://thredds.nci.org.au/thredds/fileServer/wx7/aster/vnir/Tasmania/Tas_Ferrous_Iron_index_reprojected.nc4","type":"WWW","name":"Ferrous_Iron_Index","description":"NCI NetCDF file download via HTTP - Tasmania","version":"","applicationProfile":"","protocolRequest":""},{"url":"https://doi.org/10.4225/08/51400D6F7B335","type":"WWW","name":"CSIRO Data Access Portal Record","description":"","version":"","applicationProfile":"","protocolRequest":""}],"geographicElements":[{"type":"bbox","eastBoundLongitude":155.0,"westBoundLongitude":111.5,"northBoundLatitude":-9.0,"southBoundLatitude":-44.5}],"descriptiveKeywords":["Earth Sciences",""],"datasetURIs":["10.25914/5f224f0cc2844"],"constraints":["https://creativecommons.org/licenses/by/4.0/","RestrictionCode: restricted","Creative Commons Attribution 4.0 International","RestrictionCode: license"],"useLimitConstraints":["Creative Commons Attribution 4.0 International","RestrictionCode: license"],"accessConstraints":["RestrictionCode: restricted"],"childRecords":[],"date":"2018-04-11T00:00:00 UTC","minScale":null,"maxScale":null,"knownLayerIds":["aster-ferrous"],"knownLayerNames":["Ferrous iron index"],"knownLayerDescriptions":["1. Band ratio: B5/B4Blue is low abundance, Red is high abundance"]}],"relatedRecords":[],"capabilityRecords":[]},{"name":"Opaque index","hidden":false,"description":"1. Band ratio: B1/B4Blue is low abundance, Red is high abundancepotentially includes  carbon black e.g. ash), magnetite, Mn oxides, and sulphides in unoxidised envornments","id":"aster-opaque","proxyUrl":null,"proxyGetFeatureInfoUrl":null,"proxyCountUrl":null,"proxyStyleUrl":null,"proxyDownloadUrl":null,"mapStyles":null,"feature_count":0,"singleTile":false,"legendImg":null,"previewImg":null,"group":"ASTER Mineral Maps","layerMode":"NA","cswRecords":[{"name":"National ASTER Map Opaque index","resourceProvider":"Resources Division","id":"f3401_6961_4148_6080","recordInfoUrl":"https://geonetwork.nci.org.au/geonetwork/srv/eng/catalog.search#/metadata/f3401_6961_4148_6080","description":"1. Band ratio: B1/B4 Blue is low abundance, Red is high abundance (potentially includes carbon black (e.g. ash), magnetite, Mn oxides, and sulphides in unoxidised envornments\r\nUseful for mapping: (1) magnetite-bearing rocks (e.g. BIF); (2) maghemite gravels; (3) manganese oxides; (4) graphitic shales. Note 1: (1) and (4) above can be evidence for \"reduced\" rocks when interpreting REDOX gradients. Combine with AlOH group Content (high values) and Composition (high values) products, to find evidence for any invading \"oxidised\" hydrothermal fluids which may have interacted with reduced rocks evident in the Opaques index product.\n\n\n--\nThis record represents data published by NCI. It uses catalogue metadata modified from Geoscience Australia. See our Record Lineage Information for more details.","noCache":false,"service":false,"adminArea":null,"contactOrg":"Commonwealth Scientific & Industrial Research Organisation (CSIRO)","contactPerson":"Cudahy, T.","funderOrg":"Unknown","authors":["Cudahy, T.","Caccetta, M.","Lau, I.","Rodger, A.","Laukamp, C.","Ong, C.","Chia, J.","Collings, S.","Rankine, T.","Fraser, R.","Woodcock, R.","Vote, J.","Warren, P.","Thomas, M.","Tyler, I.","Mauger, A.","Close, D.","Jones, M.","Abrams, M.","Cudahy, T.","Caccetta, M.","Lau, I.","Rodger, A.","Laukamp, C.","Ong, C.","Chia, J.","Collings, S.","Rankine, T.","Fraser, R.","Woodcock, R.","Vote, J.","Warren, P.","Thomas, M.","Tyler, I.","Mauger, A.","Close, D.","Jones, M.","Abrams, M.","Cudahy, T.","Caccetta, M.","Lau, I.","Rodger, A.","Laukamp, C.","Ong, C.","Chia, J.","Collings, S.","Rankine, T.","Fraser, R.","Woodcock, R.","Vote, J.","Warren, P.","Thomas, M.","Tyler, I.","Mauger, A.","Close, D.","Jones, M.","Abrams, M.","Cudahy, T.","Caccetta, M.","Lau, I.","Rodger, A.","Laukamp, C.","Ong, C.","Chia, J.","Collings, S.","Rankine, T.","Fraser, R.","Woodcock, R.","Vote, J.","Warren, P.","Thomas, M.","Tyler, I.","Mauger, A.","Close, D.","Jones, M.","Abrams, M."],"onlineResources":[{"url":"https://gsky.nci.org.au/ows/aster?service=WMS&version=1.1.1&request=GetCapabilities","type":"WMS","name":"Opaque_Index","description":"NCI GSKY Web Map Service (WMS)","version":"1.1.1","applicationProfile":"","protocolRequest":""},{"url":"https://gsky.nci.org.au/ows/aster?service=WCS&version=1.0.0&request=GetCapabilities","type":"WCS","name":"Opaque_Index","description":"NCI GSKY Web Coverage Service (WCS)","version":"","applicationProfile":"","protocolRequest":""},{"url":"https://thredds.nci.org.au/thredds/dodsC/wx7/aster/vnir/Aus_Mainland/Aus_Mainland_Opaque_Index_