,"World","borehole"],"datasetURIs":[],"constraints":["","https://creativecommons.org/licenses/by/4.0"],"useLimitConstraints":["https://creativecommons.org/licenses/by/4.0"],"accessConstraints":[],"childRecords":[],"date":"2023-08-18T00:00:00 UTC","minScale":null,"maxScale":null,"knownLayerIds":["mscl-gssa-borehole"],"knownLayerNames":["GSSA GeoSciML v4.1 Boreholes"],"knownLayerDescriptions":["South Australian boreholes with an OGC WFS service which outputs GeoSciML v4.1 Borehole XML. Some boreholes include petrophysical data acquired using Geotek MSCL-S by Geological Survey of South Australia"]},{"name":"Borehole","resourceProvider":"Unknown","id":"20609e1c2a8dda5e317ea7dea19bf6ef9855d870","recordInfoUrl":"https://portal.auscope.org.au/geonetwork/srv/eng/catalog.search#/metadata/20609e1c2a8dda5e317ea7dea19bf6ef9855d870","description":"Boreholes submitted to CSIRO by industry and government organisations for analysis with HyLogging technology.  Data provided is spectral data, automated mineral predicitions and interpretations.","noCache":false,"service":false,"adminArea":null,"contactOrg":"AuScope","contactPerson":"AuScope AVRE Program","funderOrg":"Unknown","authors":[],"onlineResources":[{"url":"https://research-community.geoanalytics.csiro.au/geoserver/wfs","type":"WFS","name":"gsmlbh:Borehole","description":"Borehole","version":"","applicationProfile":"","protocolRequest":""}],"geographicElements":[{"type":"bbox","eastBoundLongitude":180.0,"westBoundLongitude":-180.0,"northBoundLatitude":90.0,"southBoundLatitude":-90.0}],"descriptiveKeywords":["World","Earth Sciences"],"datasetURIs":[],"constraints":["","https://creativecommons.org/licenses/by/4.0"],"useLimitConstraints":["https://creativecommons.org/licenses/by/4.0"],"accessConstraints":[],"childRecords":[],"date":"2023-08-18T00:00:00 UTC","minScale":null,"maxScale":null,"knownLayerIds":["mscl-gssa-borehole"],"knownLayerNames":["GSSA GeoSciML v4.1 Boreholes"],"knownLayerDescriptions":["South Australian boreholes with an OGC WFS service which outputs GeoSciML v4.1 Borehole XML. Some boreholes include petrophysical data acquired using Geotek MSCL-S by Geological Survey of South Australia"]}],"relatedRecords":[],"capabilityRecords":[]},{"name":"Seismographs in Schools Network","hidden":false,"description":"Seismographs in Schools data feed from AusPass: the Australian Passive Seismic Server.","id":"seismology-in-schools-site","proxyUrl":"getIRISStations.do","proxyGetFeatureInfoUrl":null,"proxyCountUrl":null,"proxyStyleUrl":null,"proxyDownloadUrl":null,"mapStyles":null,"feature_count":0,"singleTile":false,"legendImg":null,"previewImg":null,"group":"Passive Seismic","layerMode":"NA","cswRecords":[{"name":"AusPASS - Seismographs In Schools","resourceProvider":"Unknown","id":"16750fd6-f865-4fc1-a94a-3f5a32e2f9da","recordInfoUrl":"https://portal.auscope.org.au/geonetwork/srv/eng/catalog.search#/metadata/16750fd6-f865-4fc1-a94a-3f5a32e2f9da","description":"AusPass is a service dedicated to the acquisition, management, and distribution of passive seismological data in Australia. Extensive fieldwork projects are conducted across the country, organized in seismic arrays (i.e. groups of seismic stations).\n\nAustralian Seismometers in Schools is a dual purpose seismic network. The program offers both education outreach and provides quality data for monitoring and research. We use Guralp CMG-6TD seismometers and stream data live data to the schools and Geoscience Australia as well as providing the data to IRIS and the Australian AusPass data server. AuSIS infrastructure is supported by AuScope Geophysical Observatory program.","noCache":false,"service":false,"adminArea":"ACT","contactOrg":"ANU Research School of Earth Sciences","contactPerson":null,"funderOrg":"AuScope","authors":[],"onlineResources":[{"url":"https://auspass.edu.au","type":"IRIS","name":"S1","description":"Seismographs in Schools Network, FDSN code \"S1\"","version":"","applicationProfile":"","protocolRequest":""},{"url":"https://doi.org/10.7914/SN/S1","type":"DOI","name":"Australian National University (ANU, Australia). (2011). Australian Seismometers in Schools [Data set]. International Federation of Digital Seismograph Networks.","description":"Citation Information","version":"","applicationProfile":"","protocolRequest":""}],"geographicElements":[{"type":"bbox","eastBoundLongitude":156.0,"westBoundLongitude":112.0,"northBoundLatitude":-10.0,"southBoundLatitude":-45.0}],"descriptiveKeywords":["seismology","Earth Sciences"],"datasetURIs":[],"constraints":["https://creativecommons.org/licenses/by/4.0/"],"useLimitConstraints":["https://creativecommons.org/licenses/by/4.0/"],"accessConstraints":[],"childRecords":[],"date":"2025-06-19T00:00:00 UTC","minScale":null,"maxScale":null,"knownLayerIds":["seismology-in-schools-site"],"knownLayerNames":["Seismographs in Schools Network"],"knownLayerDescriptions":["Seismographs in Schools data feed from AusPass: the Australian Passive Seismic Server."]}],"relatedRecords":[],"capabilityRecords":[]},{"name":"SKIPPY","hidden":false,"description":"The SKIPPY seismic array feed from AusPass: the Australian Passive Seismic Server.","id":"seismology-skippy","proxyUrl":"getIRISStations.do","proxyGetFeatureInfoUrl":null,"proxyCountUrl":null,"proxyStyleUrl":null,"proxyDownloadUrl":null,"mapStyles":null,"feature_count":0,"singleTile":false,"legendImg":null,"previewImg":null,"group":"Passive Seismic","layerMode":"NA","cswRecords":[{"name":"AusPASS - SKIPPY","resourceProvider":"Unknown","id":"9d631fd3-e68f-497c-97ab-86495e837ced","recordInfoUrl":"https://portal.auscope.org.au/geonetwork/srv/eng/catalog.search#/metadata/9d631fd3-e68f-497c-97ab-86495e837ced","description":"AusPass is a service dedicated to the acquisition, management, and distribution of passive seismological data in Australia. Extensive fieldwork projects are conducted across the country, organized in seismic arrays (i.e. groups of seismic stations).\n\nThe SKIPPY array was a continental scale experiment aiming to cover the entire Australian Continent with station spacings of approximately 400 km. Data was collected in stages as a rolling array using 8 to 12 broadband seismometers. Guralp CMG-3ESP seismometers and Reftek recorders were used.","noCache":false,"service":false,"adminArea":"ACT","contactOrg":"ANU Research School of Earth Sciences","contactPerson":null,"funderOrg":"AuScope","authors":[],"onlineResources":[{"url":"https://auspass.edu.au","type":"IRIS","name":"7B","description":"SKIPPY, FDSN code \"7B (1993-1996)\"","version":"","applicationProfile":"","protocolRequest":""},{"url":"https://doi.org/10.7914/SN/7B_1993","type":"DOI","name":"Rob van der Hilst, & Brian Kennett. (1993). SKIPPY. Australian Passive Seismic Server","description":"Citation Information","version":"","applicationProfile":"","protocolRequest":""}],"geographicElements":[{"type":"bbox","eastBoundLongitude":156.0,"westBoundLongitude":112.0,"northBoundLatitude":-10.0,"southBoundLatitude":-45.0}],"descriptiveKeywords":["seismology","Earth Science","Earth Sciences"],"datasetURIs":[],"constraints":["https://creativecommons.org/licenses/by/4.0/"],"useLimitConstraints":["https://creativecommons.org/licenses/by/4.0/"],"accessConstraints":[],"childRecords":[],"date":"2025-06-19T00:00:00 UTC","minScale":null,"maxScale":null,"knownLayerIds":["seismology-skippy"],"knownLayerNames":["SKIPPY"],"knownLayerDescriptions":["The SKIPPY seismic array feed from AusPass: the Australian Passive Seismic Server."]}],"relatedRecords":[],"capabilityRecords":[]},{"name":"KIMBA97: Kimberley Region in 1997","hidden":false,"description":"The KIMBA97 seismic array feed from AusPass: the Australian Passive Seismic Server.","id":"seismology-kimba97","proxyUrl":"getIRISStations.do","proxyGetFeatureInfoUrl":null,"proxyCountUrl":null,"proxyStyleUrl":null,"proxyDownloadUrl":null,"mapStyles":null,"feature_count":0,"singleTile":false,"legendImg":null,"previewImg":null,"group":"Passive Seismic","layerMode":"NA","cswRecords":[{"name":"AusPASS - KIMBA97","resourceProvider":"Unknown","id":"106a3d98-6f68-4815-a55a-a4e1c4e3406f","recordInfoUrl":"https://portal.auscope.org.au/geonetwork/srv/eng/catalog.search#/metadata/106a3d98-6f68-4815-a55a-a4e1c4e3406f","description":"AusPass is a service dedicated to the acquisition, management, and distribution of passive seismological data in Australia. Extensive fieldwork projects are conducted across the country, organized in seismic arrays (i.e. groups of seismic stations).\n\nFrom July to October 1997 a set of broadband instruments were deployed in the Kimberley region, Australia, both on the King Leopold and Halls creek fold belt and the interior of the block. Station placements were designed to build on the information obtained from the stations in the SKIPPY experiment to improve knowledge of the region. Instruments used are Guralp CMG-3ESP and Reftek recorders.","noCache":false,"service":false,"adminArea":"ACT","contactOrg":"ANU Research School of Earth Sciences","contactPerson":null,"funderOrg":"AuScope","authors":[],"onlineResources":[{"url":"https://auspass.edu.au","type":"IRIS","name":"7D","description":"KIMBA97: Seismic deployments in the Kimberley Region in 1997, FDSN code \"7D (1997-1997)\"","version":"","applicationProfile":"","protocolRequest":""},{"url":"https://doi.org/10.7914/SN/7D_1997","type":"DOI","name":"Brian Kennett. (1997). KIMBA97. International Federation of Digital Seismograph Networks.","description":"Citation Information","version":"","applicationProfile":"","protocolRequest":""}],"geographicElements":[{"type":"bbox","eastBoundLongitude":156.0,"westBoundLongitude":112.0,"northBoundLatitude":-10.0,"southBoundLatitude":-45.0}],"descriptiveKeywords":["Earth Sciences"],"datasetURIs":[],"constraints":["https://creativecommons.org/licenses/by/4.0/"],"useLimitConstraints":["https://creativecommons.org/licenses/by/4.0/"],"accessConstraints":[],"childRecords":[],"date":"2025-06-19T00:00:00 UTC","minScale":null,"maxScale":null,"knownLayerIds":["seismology-kimba97"],"knownLayerNames":["KIMBA97: Kimberley Region in 1997"],"knownLayerDescriptions":["The KIMBA97 seismic array feed from AusPass: the Australian Passive Seismic Server."]}],"relatedRecords":[],"capabilityRecords":[]},{"name":"KIMBA98: Kimberley Region in 1998","hidden":false,"description":"The KIMBA98 seismic array feed from AusPass: the Australian Passive Seismic Server.","id":"seismology-kimba98","proxyUrl":"getIRISStations.do","proxyGetFeatureInfoUrl":null,"proxyCountUrl":null,"proxyStyleUrl":null,"proxyDownloadUrl":null,"mapStyles":null,"feature_count":0,"singleTile":false,"legendImg":null,"previewImg":null,"group":"Passive Seismic","layerMode":"NA","cswRecords":[{"name":"AusPASS - KIMBA98","resourceProvider":"Unknown","id":"9e1084ac-2c0e-4e37-8e13-b87630a05bbd","recordInfoUrl":"https://portal.auscope.org.au/geonetwork/srv/eng/catalog.search#/metadata/9e1084ac-2c0e-4e37-8e13-b87630a05bbd","description":"AusPass is a service dedicated to the acquisition, management, and distribution of passive seismological data in Australia. Extensive fieldwork projects are conducted across the country, organized in seismic arrays (i.e. groups of seismic stations).\n\nFrom May to October 1998 a set of broad-band instruments were deployed through the Kimberley region, Australia, crossing both the King Leopold and Halls Creek fold belts and the interior of the block including the remote northern region. The instruments deployed were placed to improve the coverage from the KIMBA97 deployment and SKIPPY experiment indicated. Instruments used were Guralp CMG-3ESP seismometers and Reftek recorders.","noCache":false,"service":false,"adminArea":"ACT","contactOrg":"ANU Research School of Earth Sciences","contactPerson":null,"funderOrg":"AuScope","authors":[],"onlineResources":[{"url":"https://auspass.edu.au","type":"IRIS","name":"7E","description":"KIMBA98: Seismic deployments in the Kimberley Region in 1998, FDSN code \"7E (1998-1998)\"","version":"","applicationProfile":"","protocolRequest":""},{"url":"https://doi.org/10.7914/SN/7E_1998","type":"DOI","name":"Brian Kennett. (1998). KIMBA98. International Federation of Digital Seismograph Networks.","description":"Citation Information","version":"","applicationProfile":"","protocolRequest":""}],"geographicElements":[{"type":"bbox","eastBoundLongitude":156.0,"westBoundLongitude":112.0,"northBoundLatitude":-10.0,"southBoundLatitude":-45.0}],"descriptiveKeywords":["seismology","Earth Sciences"],"datasetURIs":[],"constraints":["https://creativecommons.org/licenses/by/4.0/"],"useLimitConstraints":["https://creativecommons.org/licenses/by/4.0/"],"accessConstraints":[],"childRecords":[],"date":"2025-06-19T00:00:00 UTC","minScale":null,"maxScale":null,"knownLayerIds":["seismology-kimba98"],"knownLayerNames":["KIMBA98: Kimberley Region in 1998"],"knownLayerDescriptions":["The KIMBA98 seismic array feed from AusPass: the Australian Passive Seismic Server."]}],"relatedRecords":[],"capabilityRecords":[]},{"name":"WACRATON: Western Australia","hidden":false,"description":"The West Australian Cratons seismic array feed from AusPass: the Australian Passive Seismic Server.","id":"seismology-wacraton","proxyUrl":"getIRISStations.do","proxyGetFeatureInfoUrl":null,"proxyCountUrl":null,"proxyStyleUrl":null,"proxyDownloadUrl":null,"mapStyles":null,"feature_count":0,"singleTile":false,"legendImg":null,"previewImg":null,"group":"Passive Seismic","layerMode":"NA","cswRecords":[{"name":"AusPASS - Seismic deployments in Western Australia 2000-2001 (WACRATON)","resourceProvider":"Unknown","id":"9e1f55bd-fa8b-4a44-8578-7d23059c4e4c","recordInfoUrl":"https://portal.auscope.org.au/geonetwork/srv/eng/catalog.search#/metadata/9e1f55bd-fa8b-4a44-8578-7d23059c4e4c","description":"AusPass is a service dedicated to the acquisition, management, and distribution of passive seismological data in Australia. Extensive fieldwork projects are conducted across the country, organized in seismic arrays (i.e. groups of seismic stations).\n\nThe 2000-2001 deployment of broad-band instruments is designed to try to understand the crustal variations associated with the cratons of Western Australia and to provide improved coverage of the western part of the continent using surface wave paths to compensate for equipment problems encountered in the later stages of the SKIPPY project. Instruments included Guralp 40T and 3ESP sensors, a STS2 sensor, and Orion and Reftek digitisers. Data was sampled at 25 samples/sec","noCache":false,"service":false,"adminArea":"ACT","contactOrg":"ANU Research School of Earth Sciences","contactPerson":null,"funderOrg":"AuScope","authors":[],"onlineResources":[{"url":"https://auspass.edu.au","type":"IRIS","name":"7G","description":"WACRATON: Seismic deployments in Western Australia 2000-2001, FDSN code \"7G (2000-2001)\"","version":"","applicationProfile":"","protocolRequest":""},{"url":"https://doi.org/10.7914/SN/7G_2000","type":"DOI","name":"Brian Kennet. (2000). West Australian Cratons [Data set]. International Federation of Digital Seismograph Networks.","description":"Citation Information","version":"","applicationProfile":"","protocolRequest":""}],"geographicElements":[{"type":"bbox","eastBoundLongitude":156.0,"westBoundLongitude":112.0,"northBoundLatitude":-10.0,"southBoundLatitude":-45.0}],"descriptiveKeywords":["seismology","Earth Science","Earth Sciences"],"datasetURIs":[],"constraints":["https://creativecommons.org/licenses/by/4.0/"],"useLimitConstraints":["https://creativecommons.org/licenses/by/4.0/"],"accessConstraints":[],"childRecords":[],"date":"2025-06-19T00:00:00 UTC","minScale":null,"maxScale":null,"knownLayerIds":["seismology-wacraton"],"knownLayerNames":["WACRATON: Western Australia"],"knownLayerDescriptions":["The West Australian Cratons seismic array feed from AusPass: the Australian Passive Seismic Server."]}],"relatedRecords":[],"capabilityRecords":[]},{"name":"SEAL: South East Australia Linkage","hidden":false,"description":"The SEAL seismic array feed from AusPass: the Australian Passive Seismic Server.","id":"seismology-seal","proxyUrl":"getIRISStations.do","proxyGetFeatureInfoUrl":null,"proxyCountUrl":null,"proxyStyleUrl":null,"proxyDownloadUrl":null,"mapStyles":null,"feature_count":0,"singleTile":false,"legendImg":null,"previewImg":null,"group":"Passive Seismic","layerMode":"NA","cswRecords":[{"name":"AusPASS - South East Australia Linkage (SEAL)","resourceProvider":"Unknown","id":"5c087f70-90f5-4ef9-b13a-798b441220da","recordInfoUrl":"https://portal.auscope.org.au/geonetwork/srv/eng/catalog.search#/metadata/5c087f70-90f5-4ef9-b13a-798b441220da","description":"AusPass is a service dedicated to the acquisition, management, and distribution of passive seismological data in Australia. Extensive fieldwork projects are conducted across the country, organized in seismic arrays (i.e. groups of seismic stations).","noCache":false,"service":false,"adminArea":"ACT","contactOrg":"ANU Research School of Earth Sciences","contactPerson":null,"funderOrg":"AuScope","authors":[],"onlineResources":[{"url":"https://auspass.edu.au","type":"IRIS","name":"7Q","description":"South East Australia Linkage(SEAL), FDSN code \"7Q\"","version":"","applicationProfile":"","protocolRequest":""},{"url":"https://www.fdsn.org/networks/detail/7Q_2004/","type":"WWW","name":"FDSN Network Information","description":"FDSN Network Information","version":"","applicationProfile":"","protocolRequest":""}],"geographicElements":[{"type":"bbox","eastBoundLongitude":156.0,"westBoundLongitude":112.0,"northBoundLatitude":-10.0,"southBoundLatitude":-45.0}],"descriptiveKeywords":["seismology","Earth Science","Earth Sciences"],"datasetURIs":[],"constraints":["https://creativecommons.org/licenses/by/4.0/"],"useLimitConstraints":["https://creativecommons.org/licenses/by/4.0/"],"accessConstraints":[],"childRecords":[],"date":"2025-06-19T00:00:00 UTC","minScale":null,"maxScale":null,"knownLayerIds":["seismology-seal"],"knownLayerNames":["SEAL: South East Australia Linkage"],"knownLayerDescriptions":["The SEAL seismic array feed from AusPass: the Australian Passive Seismic Server."]}],"relatedRecords":[],"capabilityRecords":[]},{"name":"SEAL2: South East Australia Linkage","hidden":false,"description":"The SEAL2 seismic array feed from AusPass: the Australian Passive Seismic Server.","id":"seismology-seal2","proxyUrl":"getIRISStations.do","proxyGetFeatureInfoUrl":null,"proxyCountUrl":null,"proxyStyleUrl":null,"proxyDownloadUrl":null,"mapStyles":null,"feature_count":0,"singleTile":false,"legendImg":null,"previewImg":null,"group":"Passive Seismic","layerMode":"NA","cswRecords":[{"name":"AusPASS - South East Australia Linkage (SEAL2)","resourceProvider":"Unknown","id":"94eacbc9-e4e1-41a1-8f9e-d4a12b2cbe87","recordInfoUrl":"https://portal.auscope.org.au/geonetwork/srv/eng/catalog.search#/metadata/94eacbc9-e4e1-41a1-8f9e-d4a12b2cbe87","description":"AusPass is a service dedicated to the acquisition, management, and distribution of passive seismological data in Australia. Extensive fieldwork projects are conducted across the country, organized in seismic arrays (i.e. groups of seismic stations).\n\nThis array is part of the WOMBAT rolling array. It consist of 31 short-period (Lennartz 3D-Lite MkII) and 5 broadband seismometers. Station spacing is approximately 50 km. Funding was provided by the Australian Research Council as part of a Discovery Project DP0556282.","noCache":false,"service":false,"adminArea":"ACT","contactOrg":"ANU Research School of Earth Sciences","contactPerson":null,"funderOrg":"AuScope","authors":[],"onlineResources":[{"url":"https://auspass.edu.au","type":"IRIS","name":"7T","description":"South East Australia Linkage(SEAL2), FDSN code \"7T\"","version":"","applicationProfile":"","protocolRequest":""},{"url":"https://doi.org/10.7914/SN/7T_2007","type":"DOI","name":"Nick Rawlinson. (2007). SEAL2 [Data set]. International Federation of Digital Seismograph Networks.","description":"Citation Information","version":"","applicationProfile":"","protocolRequest":""}],"geographicElements":[{"type":"bbox","eastBoundLongitude":156.0,"westBoundLongitude":112.0,"northBoundLatitude":-10.0,"southBoundLatitude":-45.0}],"descriptiveKeywords":["seismology","Earth Science","Earth Sciences"],"datasetURIs":[],"constraints":["https://creativecommons.org/licenses/by/4.0/"],"useLimitConstraints":["https://creativecommons.org/licenses/by/4.0/"],"accessConstraints":[],"childRecords":[],"date":"2025-06-19T00:00:00 UTC","minScale":null,"maxScale":null,"knownLayerIds":["seismology-seal2"],"knownLayerNames":["SEAL2: South East Australia Linkage"],"knownLayerDescriptions":["The SEAL2 seismic array feed from AusPass: the Australian Passive Seismic Server."]}],"relatedRecords":[],"capabilityRecords":[]},{"name":"SEAL3: South East Australia Linkage","hidden":false,"description":"The SEAL3 seismic array feed from AusPass: the Australian Passive Seismic Server.","id":"seismology-seal3","proxyUrl":"getIRISStations.do","proxyGetFeatureInfoUrl":null,"proxyCountUrl":null,"proxyStyleUrl":null,"proxyDownloadUrl":null,"mapStyles":null,"feature_count":0,"singleTile":false,"legendImg":null,"previewImg":null,"group":"Passive Seismic","layerMode":"NA","cswRecords":[{"name":"AusPASS - South East Australia Linkage (SEAL3)","resourceProvider":"Unknown","id":"f494f37b-d5db-468d-b048-0d2df886255e","recordInfoUrl":"https://portal.auscope.org.au/geonetwork/srv/eng/catalog.search#/metadata/f494f37b-d5db-468d-b048-0d2df886255e","description":"AusPass is a service dedicated to the acquisition, management, and distribution of passive seismological data in Australia. Extensive fieldwork projects are conducted across the country, organized in seismic arrays (i.e. groups of seismic stations).","noCache":false,"service":false,"adminArea":"ACT","contactOrg":"ANU Research School of Earth Sciences","contactPerson":null,"funderOrg":"AuScope","authors":[],"onlineResources":[{"url":"https://auspass.edu.au","type":"IRIS","name":"7U","description":"South East Australia Linkage(SEAL3), FDSN code \"7U\"","version":"","applicationProfile":"","protocolRequest":""},{"url":"https://www.fdsn.org/networks/detail/7U_2007/","type":"WWW","name":"FDSN Network Information","description":"FDSN Network Information","version":"","applicationProfile":"","protocolRequest":""}],"geographicElements":[{"type":"bbox","eastBoundLongitude":156.0,"westBoundLongitude":112.0,"northBoundLatitude":-10.0,"southBoundLatitude":-45.0}],"descriptiveKeywords":["seismology","Earth Sciences"],"datasetURIs":[],"constraints":["https://creativecommons.org/licenses/by/4.0/"],"useLimitConstraints":["https://creativecommons.org/licenses/by/4.0/"],"accessConstraints":[],"childRecords":[],"date":"2025-06-19T00:00:00 UTC","minScale":null,"maxScale":null,"knownLayerIds":["seismology-seal3"],"knownLayerNames":["SEAL3: South East Australia Linkage"],"knownLayerDescriptions":["The SEAL3 seismic array feed from AusPass: the Australian Passive Seismic Server."]}],"relatedRecords":[],"capabilityRecords":[]},{"name":"CAPRAL: Northwest Australia","hidden":false,"description":"The CAPRAL seismic array feed from AusPass: the Australian Passive Seismic Server.","id":"seismology-capral","proxyUrl":"getIRISStations.do","proxyGetFeatureInfoUrl":null,"proxyCountUrl":null,"proxyStyleUrl":null,"proxyDownloadUrl":null,"mapStyles":null,"feature_count":0,"singleTile":false,"legendImg":null,"previewImg":null,"group":"Passive Seismic","layerMode":"NA","cswRecords":[{"name":"AusPASS - Seismic deployments in Northwest Australia from 2005 to 2008 (CAPRAL)","resourceProvider":"Unknown","id":"88f554bf-886a-4489-8d77-3860bba3418a","recordInfoUrl":"https://portal.auscope.org.au/geonetwork/srv/eng/catalog.search#/metadata/88f554bf-886a-4489-8d77-3860bba3418a","description":"AusPass is a service dedicated to the acquisition, management, and distribution of passive seismological data in Australia. Extensive fieldwork projects are conducted across the country, organized in seismic arrays (i.e. groups of seismic stations).\n\nThe CAPRAL array was designed to improve local earthquake location and hence understanding of neotectonics in northwestern Australia. These stations provide a useful framework to improve coverage of the Pilbara craton and the Capricorn orogen. The array consists of 27 site with Guralp CMG-3ESP seismometers and Earthdata digitisers. Sample rates are 25 samples/sec.","noCache":false,"service":false,"adminArea":"ACT","contactOrg":"ANU Research School of Earth Sciences","contactPerson":null,"funderOrg":"AuScope","authors":[],"onlineResources":[{"url":"https://auspass.edu.au","type":"IRIS","name":"7J","description":"Seismic deployments in Northwest Australia from 2005 to 2008 (CAPRAL), FDSN code \"7J (2005-2008)\"","version":"","applicationProfile":"","protocolRequest":""},{"url":"https://doi.org/10.7914/SN/7J_2005","type":"DOI","name":"Anya Reading, & Brian Kennett. (2005). CAPRA - Linkage [Data set]. International Federation of Digital Seismograph Networks.","description":"Citation Information","version":"","applicationProfile":"","protocolRequest":""}],"geographicElements":[{"type":"bbox","eastBoundLongitude":156.0,"westBoundLongitude":112.0,"northBoundLatitude":-10.0,"southBoundLatitude":-45.0}],"descriptiveKeywords":["seismology","Earth Science","Earth Sciences"],"datasetURIs":[],"constraints":["https://creativecommons.org/licenses/by/4.0/"],"useLimitConstraints":["https://creativecommons.org/licenses/by/4.0/"],"accessConstraints":[],"childRecords":[],"date":"2025-06-19T00:00:00 UTC","minScale":null,"maxScale":null,"knownLayerIds":["seismology-capral"],"knownLayerNames":["CAPRAL: Northwest Australia"],"knownLayerDescriptions":["The CAPRAL seismic array feed from AusPass: the Australian Passive Seismic Server."]}],"relatedRecords":[],"capabilityRecords":[]},{"name":"SOC: Southern Craton","hidden":false,"description":"The SOC seismic array feed from AusPass: the Australian Passive Seismic Server.","id":"seismology-soc","proxyUrl":"getIRISStations.do","proxyGetFeatureInfoUrl":null,"proxyCountUrl":null,"proxyStyleUrl":null,"proxyDownloadUrl":null,"mapStyles":null,"feature_count":0,"singleTile":false,"legendImg":null,"previewImg":null,"group":"Passive Seismic","layerMode":"NA","cswRecords":[{"name":"AusPASS - Southern Craton (SOC)","resourceProvider":"Unknown","id":"0517e1e4-b765-48b6-8ebd-f660a326146c","recordInfoUrl":"https://portal.auscope.org.au/geonetwork/srv/eng/catalog.search#/metadata/0517e1e4-b765-48b6-8ebd-f660a326146c","description":"AusPass is a service dedicated to the acquisition, management, and distribution of passive seismological data in Australia. Extensive fieldwork projects are conducted across the country, organized in seismic arrays (i.e. groups of seismic stations).\n\nThis array was deployed to examine crustal and lithospheric thickness across Southern Australia in a corridor extending from the Curnamona Craton in South Australia to the east coast of Australia, crossing the transition from Precambrian to Phanerozoic belts. Guralp 40T and 3ESP sensor were used with Orion and Earthdata digitisers sampling at 25 samples per second.","noCache":false,"service":false,"adminArea":"ACT","contactOrg":"ANU Research School of Earth Sciences","contactPerson":null,"funderOrg":"AuScope","authors":[],"onlineResources":[{"url":"https://auspass.edu.au","type":"IRIS","name":"7K","description":"Southern Craton (SOC), FDSN code \"7K (2007-2008)\"","version":"","applicationProfile":"","protocolRequest":""},{"url":"https://doi.org/10.7914/SN/7K_2007","type":"DOI","name":"Fabrice Fontaine, & Brian Kennet. (2007). SOC - Southern Craton [Data set]. International Federation of Digital Seismograph Networks.","description":"Citation Information","version":"","applicationProfile":"","protocolRequest":""}],"geographicElements":[{"type":"bbox","eastBoundLongitude":156.0,"westBoundLongitude":112.0,"northBoundLatitude":-10.0,"southBoundLatitude":-45.0}],"descriptiveKeywords":["seismology","Earth Science","Earth Sciences"],"datasetURIs":[],"constraints":["https://creativecommons.org/licenses/by/4.0/"],"useLimitConstraints":["https://creativecommons.org/licenses/by/4.0/"],"accessConstraints":[],"childRecords":[],"date":"2025-06-19T00:00:00 UTC","minScale":null,"maxScale":null,"knownLayerIds":["seismology-soc"],"knownLayerNames":["SOC: Southern Craton"],"knownLayerDescriptions":["The SOC seismic array feed from AusPass: the Australian Passive Seismic Server."]}],"relatedRecords":[],"capabilityRecords":[]},{"name":"GAWLER","hidden":false,"description":"The GAWLER seismic array feed from AusPass: the Australian Passive Seismic Server.","id":"seismology-gawler","proxyUrl":"getIRISStations.do","proxyGetFeatureInfoUrl":null,"proxyCountUrl":null,"proxyStyleUrl":null,"proxyDownloadUrl":null,"mapStyles":null,"feature_count":0,"singleTile":false,"legendImg":null,"previewImg":null,"group":"Passive Seismic","layerMode":"NA","cswRecords":[{"name":"AusPASS - GAWLER","resourceProvider":"Unknown","id":"67cf00eb-c42e-429c-bc7a-794e3a19cd1c","recordInfoUrl":"https://portal.auscope.org.au/geonetwork/srv/eng/catalog.search#/metadata/67cf00eb-c42e-429c-bc7a-794e3a19cd1c","description":"As part of a wider AuScope project 35 short-period (Lennartz 3D-Lite MkII) seismometers were deployed across the Gawler Craton in South Australia. Station spacing was approximately 60 km and covers the area of over 118000 square km encompassing the Eyre Peninsula, Yorke Peninsula, Stuart Shelf and Torrens Hinge zone. Stations recorded continuous three component data for a period of 6-8 months. The instruments are capable of recording data from both local and distant earthquakes. The primary aim of this arrays is to increase data coverage in this part of Australia for seismic imaging. There are few permanent seismographs in the region covered by this array. This area of South Australia is also seismically active and local earthquake data recorded on this array will help improve our ability to locate and characterize these events.","noCache":false,"service":false,"adminArea":"ACT","contactOrg":"ANU Research School of Earth Sciences","contactPerson":null,"funderOrg":"AuScope","authors":[],"onlineResources":[{"url":"https://auspass.edu.au","type":"IRIS","name":"1G","description":"GAWLER, FDSN code \"1G (2008-2009)\"","version":"","applicationProfile":"","protocolRequest":""},{"url":"https://doi.org/10.7914/SN/1G_2008","type":"DOI","name":"Michelle Salmon, & Brian Kennet. (2008). Gawler [Data set]. International Federation of Digital Seismograph Networks","description":"Citation Information","version":"","applicationProfile":"","protocolRequest":""}],"geographicElements":[{"type":"bbox","eastBoundLongitude":156.0,"westBoundLongitude":112.0,"northBoundLatitude":-10.0,"southBoundLatitude":-45.0}],"descriptiveKeywords":["seismology","Earth Science","Earth Sciences"],"datasetURIs":[],"constraints":["https://creativecommons.org/licenses/by/4.0/"],"useLimitConstraints":["https://creativecommons.org/licenses/by/4.0/"],"accessConstraints":[],"childRecords":[],"date":"2025-06-19T00:00:00 UTC","minScale":null,"maxScale":null,"knownLayerIds":["seismology-gawler"],"knownLayerNames":["GAWLER"],"knownLayerDescriptions":["The GAWLER seismic array feed from AusPass: the Australian Passive Seismic Server."]}],"relatedRecords":[],"capabilityRecords":[]},{"name":"BILBY: Australian Cratonic Lithosphere","hidden":false,"description":"The BILBY seismic array feed from AusPass: the Australian Passive Seismic Server.","id":"seismology-bilby","proxyUrl":"getIRISStations.do","proxyGetFeatureInfoUrl":null,"proxyCountUrl":null,"proxyStyleUrl":null,"proxyDownloadUrl":null,"mapStyles":null,"feature_count":0,"singleTile":false,"legendImg":null,"previewImg":null,"group":"Passive Seismic","layerMode":"NA","cswRecords":[{"name":"AusPASS - Exploring the Australian Cratonic Lithosphere(BILBY)","resourceProvider":"Unknown","id":"2d856acc-c667-4f85-9190-b906b2e867c7","recordInfoUrl":"https://portal.auscope.org.au/geonetwork/srv/eng/catalog.search#/metadata/2d856acc-c667-4f85-9190-b906b2e867c7","description":"AusPass is a service dedicated to the acquisition, management, and distribution of passive seismological data in Australia. Extensive fieldwork projects are conducted across the country, organized in seismic arrays (i.e. groups of seismic stations).\n\nThis array was deployed to examine the lithospheric transitions between the northern and southern Australian cratonic regions and across parts of the intercratonic suture belts. The experiment configuration is designed specifically to connect the Gawler Craton in the south through the Musgrave Block and to the northern side of the Arunta Block, and to connect the Arunta Block with the Mt. Isa Block. 25 Guralp 3ESP sensor were used.","noCache":false,"service":false,"adminArea":"ACT","contactOrg":"ANU Research School of Earth Sciences","contactPerson":null,"funderOrg":"AuScope","authors":[],"onlineResources":[{"url":"https://auspass.edu.au","type":"IRIS","name":"6F","description":"Exploring the Australian Cratonic Lithosphere(BILBY), FDSN code \"6F (2008-2011)\"","version":"","applicationProfile":"","protocolRequest":""},{"url":"https://doi.org/10.7914/SN/6F_2008","type":"DOI","name":"Sara Rawlinson, & Brian Kennet. (2008). BILBY [Data set]. Australian Passive Seismic Server.","description":"Citation Information","version":"","applicationProfile":"","protocolRequest":""}],"geographicElements":[{"type":"bbox","eastBoundLongitude":156.0,"westBoundLongitude":112.0,"northBoundLatitude":-10.0,"southBoundLatitude":-45.0}],"descriptiveKeywords":["seismology","Earth Science","Earth Sciences"],"datasetURIs":[],"constraints":["https://creativecommons.org/licenses/by/4.0/"],"useLimitConstraints":["https://creativecommons.org/licenses/by/4.0/"],"accessConstraints":[],"childRecords":[],"date":"2025-06-19T00:00:00 UTC","minScale":null,"maxScale":null,"knownLayerIds":["seismology-bilby"],"knownLayerNames":["BILBY: Australian Cratonic Lithosphere"],"knownLayerDescriptions":["The BILBY seismic array feed from AusPass: the Australian Passive Seismic Server."]}],"relatedRecords":[],"capabilityRecords":[]},{"name":"CURNAMONA: Seismic structure of South Australia","hidden":false,"description":"The CURNAMONA seismic array feed from AusPass: the Australian Passive Seismic Server.","id":"seismology-curnamona","proxyUrl":"getIRISStations.do","proxyGetFeatureInfoUrl":null,"proxyCountUrl":null,"proxyStyleUrl":null,"proxyDownloadUrl":null,"mapStyles":null,"feature_count":0,"singleTile":false,"legendImg":null,"previewImg":null,"group":"Passive Seismic","layerMode":"NA","cswRecords":[{"name":"AusPASS - Exploring the seismic structure of South Australia (CURNAMONA)","resourceProvider":"Unknown","id":"1da972b3-c428-49ee-8109-e943ba26ba21","recordInfoUrl":"https://portal.auscope.org.au/geonetwork/srv/eng/catalog.search#/metadata/1da972b3-c428-49ee-8109-e943ba26ba21","description":"AusPass is a service dedicated to the acquisition, management, and distribution of passive seismological data in Australia. Extensive fieldwork projects are conducted across the country, organized in seismic arrays (i.e. groups of seismic stations).\n\nAs part of a wider AuScope project 35 short-period (Lennartz 3D-Lite MkII) seismometers were deployed across the Curnamona Craton in South Australia. Station spacing was approximately 60 km and covers the area of over 100000 square km encompassing the Curnamona Craton and the Adelaide Geosyncline. Stations recorded continuous three component data for a period of 6-8 months. The instruments are capable of recording data from both local and distant earthquakes. The primary aim of this arrays is to increase data coverage in this part of Australia for seismic imaging. There are few permanent seismographs in the region covered by this array. This area of South Australia is also seismically active and local earthquake data recorded on this array will help improve our ability to locate and characterize these events.","noCache":false,"service":false,"adminArea":"ACT","contactOrg":"ANU Research School of Earth Sciences","contactPerson":null,"funderOrg":"AuScope","authors":[],"onlineResources":[{"url":"https://auspass.edu.au","type":"IRIS","name":"1F","description":"Exploring the seismic structure of South Australia (CURNAMONA), FDSN code \"1F (2009-2009)\"","version":"","applicationProfile":"","protocolRequest":""},{"url":"https://doi.org/10.7914/SN/1F_2009","type":"DOI","name":"Michelle Salmon. (2009). Curnamona [Data set]. International Federation of Digital Seismograph Networks.","description":"Citation Information","version":"","applicationProfile":"","protocolRequest":""}],"geographicElements":[{"type":"bbox","eastBoundLongitude":156.0,"westBoundLongitude":112.0,"northBoundLatitude":-10.0,"southBoundLatitude":-45.0}],"descriptiveKeywords":["seismology","Earth Science","Earth Sciences"],"datasetURIs":[],"constraints":["https://creativecommons.org/licenses/by/4.0/"],"useLimitConstraints":["https://creativecommons.org/licenses/by/4.0/"],"accessConstraints":[],"childRecords":[],"date":"2025-06-19T00:00:00 UTC","minScale":null,"maxScale":null,"knownLayerIds":["seismology-curnamona"],"knownLayerNames":["CURNAMONA: Seismic structure of South Australia"],"knownLayerDescriptions":["The CURNAMONA seismic array feed from AusPass: the Australian Passive Seismic Server."]}],"relatedRecords":[],"capabilityRecords":[]},{"name":"MINQ: Mount Isa Northern Queensland","hidden":false,"description":"The MINQ seismic array feed from AusPass: the Australian Passive Seismic Server.","id":"seismology-minq","proxyUrl":"getIRISStations.do","proxyGetFeatureInfoUrl":null,"proxyCountUrl":null,"proxyStyleUrl":null,"proxyDownloadUrl":null,"mapStyles":null,"feature_count":0,"singleTile":false,"legendImg":null,"previewImg":null,"group":"Passive Seismic","layerMode":"NA","cswRecords":[{"name":"AusPASS - Mount Isa Northern Queensland (MINQ)","resourceProvider":"Unknown","id":"81281255-a5e4-4c49-81ce-874faf971d4c","recordInfoUrl":"https://portal.auscope.org.au/geonetwork/srv/eng/catalog.search#/metadata/81281255-a5e4-4c49-81ce-874faf971d4c","description":"AusPass is a service dedicated to the acquisition, management, and distribution of passive seismological data in Australia. Extensive fieldwork projects are conducted across the country, organized in seismic arrays (i.e. groups of seismic stations).\n\n \t\n\nThe MINQ experiment was conducted by the Australian National University and the Geological Survey of Queensland as part of the AuScope Infrastructure program, and involved setting up an array of portable earthquake recorders on a rectangular grid with approximately 50km spacing, beginning in the Mount Isa area. Instruments are ANU solid state recorders and Lennartz 3Dlite-MII seismometers.\n\nThe instruments recorded seismic waves passing through the Earth from distant earthquakes in the Pacific, Indian and Southern Oceans. By comparing the signals and their arrival times at different sites it is possible to learn about the geological history of North Queensland from structures we can see deep in the crust. We can resolve these seismic velocity changes in this way down as far as 50 to 100km depth. The images are constructed from the travel times of seismic waves using ray tracing and seismic tomography.\n\nAn initial 21 instruments were installed in the Mount Isa area in June 2009 as the first phase of a deployment that moved progressively to the east over several years. The network was expanded to 25 instruments when the first data was collected on an instrument service run in September. Most of the instruments were moved in late 2010 to the second phase of the experiment, MINQ-B, is installed on the plains east of Cloncurry.","noCache":false,"service":false,"adminArea":"ACT","contactOrg":"ANU Research School of Earth Sciences","contactPerson":null,"funderOrg":"AuScope","authors":[],"onlineResources":[{"url":"https://auspass.edu.au","type":"IRIS","name":"ZR","description":"Mount Isa Northern Queensland (MINQ), FDSN code \"ZR (2009-2011)\"","version":"","applicationProfile":"","protocolRequest":""},{"url":"https://doi.org/10.7914/SN/ZR_2009","type":"DOI","name":"Brian Kennett, & Herb McQueen. (2009). Mt Isa Norther Queensland - AuScope [Data set]. Australian Passive Seismic Server.","description":"Citation Information","version":"","applicationProfile":"","protocolRequest":""}],"geographicElements":[{"type":"bbox","eastBoundLongitude":156.0,"westBoundLongitude":112.0,"northBoundLatitude":-10.0,"southBoundLatitude":-45.0}],"descriptiveKeywords":["seismology","Earth Science","Earth Sciences"],"datasetURIs":[],"constraints":["https://creativecommons.org/licenses/by/4.0/"],"useLimitConstraints":["https://creativecommons.org/licenses/by/4.0/"],"accessConstraints":[],"childRecords":[],"date":"2025-06-19T00:00:00 UTC","minScale":null,"maxScale":null,"knownLayerIds":["seismology-minq"],"knownLayerNames":["MINQ: Mount Isa Northern Queensland"],"knownLayerDescriptions":["The MINQ seismic array feed from AusPass: the Australian Passive Seismic Server."]}],"relatedRecords":[],"capabilityRecords":[]},{"name":"EAL1: Eastern Australia Linkage","hidden":false,"description":"The EAL1 seismic array feed from AusPass: the Australian Passive Seismic Server.","id":"seismology-eal1","proxyUrl":"getIRISStations.do","proxyGetFeatureInfoUrl":null,"proxyCountUrl":null,"proxyStyleUrl":null,"proxyDownloadUrl":null,"mapStyles":null,"feature_count":0,"singleTile":false,"legendImg":null,"previewImg":null,"group":"Passive Seismic","layerMode":"NA","cswRecords":[{"name":"AusPASS - Eastern Australia Linkage (EAL1)","resourceProvider":"Unknown","id":"20e34442-7359-4fda-bd36-29d19a3b1887","recordInfoUrl":"https://portal.auscope.org.au/geonetwork/srv/eng/catalog.search#/metadata/20e34442-7359-4fda-bd36-29d19a3b1887","description":"AusPass is a service dedicated to the acquisition, management, and distribution of passive seismological data in Australia. Extensive fieldwork projects are conducted across the country, organized in seismic arrays (i.e. groups of seismic stations).","noCache":false,"service":false,"adminArea":"ACT","contactOrg":"ANU Research School of Earth Sciences","contactPerson":null,"funderOrg":"AuScope","authors":[],"onlineResources":[{"url":"https://auspass.edu.au","type":"IRIS","name":"4H","description":"Eastern Australia Linkage (EAL1), FDSN code \"4H\"","version":"","applicationProfile":"","protocolRequest":""},{"url":"https://www.fdsn.org/networks/detail/4H_2009/","type":"WWW","name":"FDSN Network Information","description":"FDSN Network Information","version":"","applicationProfile":"","protocolRequest":""}],"geographicElements":[{"type":"bbox","eastBoundLongitude":156.0,"westBoundLongitude":112.0,"northBoundLatitude":-10.0,"southBoundLatitude":-45.0}],"descriptiveKeywords":["seismology","Earth Science","Earth Sciences"],"datasetURIs":[],"constraints":["https://creativecommons.org/licenses/by/4.0/"],"useLimitConstraints":["https://creativecommons.org/licenses/by/4.0/"],"accessConstraints":[],"childRecords":[],"date":"2025-06-19T00:00:00 UTC","minScale":null,"maxScale":null,"knownLayerIds":["seismology-eal1"],"knownLayerNames":["EAL1: Eastern Australia Linkage"],"knownLayerDescriptions":["The EAL1 seismic array feed from AusPass: the Australian Passive Seismic Server."]}],"relatedRecords":[],"capabilityRecords":[]},{"name":"EAL2: Eastern Australia Linkage","hidden":false,"description":"The EAL2 seismic array feed from AusPass: the Australian Passive Seismic Server.","id":"seismology-eal2","proxyUrl":"getIRISStations.do","proxyGetFeatureInfoUrl":null,"proxyCountUrl":null,"proxyStyleUrl":null,"proxyDownloadUrl":null,"mapStyles":null,"feature_count":0,"singleTile":false,"legendImg":null,"previewImg":null,"group":"Passive Seismic","layerMode":"NA","cswRecords":[{"name":"AusPASS - Eastern Australia Linkage (EAL2)","resourceProvider":"