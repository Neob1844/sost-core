5914/5f224f3c14a64"],"constraints":["https://creativecommons.org/licenses/by/4.0/","RestrictionCode: restricted","Creative Commons Attribution 4.0 International","RestrictionCode: license"],"useLimitConstraints":["Creative Commons Attribution 4.0 International","RestrictionCode: license"],"accessConstraints":["RestrictionCode: restricted"],"childRecords":[],"date":"2018-04-11T00:00:00 UTC","minScale":null,"maxScale":null,"knownLayerIds":["aster-quartz-index"],"knownLayerNames":["TIR Quartz index"],"knownLayerDescriptions":["1. Band ratio: B11/(B10+B12)Blue is low quartz contentRed is high quartz content"]}],"relatedRecords":[],"capabilityRecords":[]},{"name":"MgOH group content","hidden":false,"description":"1. Band ratio: (B6+B9/(B7+B8)Blue is low content, Red is high contentpotentially includes: calcite, dolomite, magnesite, chlorite, epidote, amphibole, talc, serpentine)","id":"aster-mgoh-content","proxyUrl":null,"proxyGetFeatureInfoUrl":null,"proxyCountUrl":null,"proxyStyleUrl":null,"proxyDownloadUrl":null,"mapStyles":null,"feature_count":0,"singleTile":false,"legendImg":null,"previewImg":null,"group":"ASTER Mineral Maps","layerMode":"NA","cswRecords":[{"name":"National ASTER Map MgOH group content","resourceProvider":"Resources Division","id":"f1734_9663_3557_9883","recordInfoUrl":"https://geonetwork.nci.org.au/geonetwork/srv/eng/catalog.search#/metadata/f1734_9663_3557_9883","description":"1. Band ratio: (B6+B9/(B7+B8) Blue is low content, Red is high content (potentially includes: calcite, dolomite, magnesite, chlorite, epidote, amphibole, talc, serpentine)\r\nUseful for mapping: (1) \"hydrated\" ferromagnesian rocks rich in OH-bearing tri-octahedral silicates like actinolite, serpentine, chlorite and talc; (2) carbonate-rich rocks, including shelf (palaeo-reef) and valley carbonates(calcretes, dolocretes and magnecretes); and (3) lithology-overprinting hydrothermal alteration, e.g. \"propyllitic alteration\" comprising chlorite, amphibole and carbonate. The nature (composition) of the silicate or carbonate mineral can be further assessed using the MgOH composition product.\n\n\n--\nThis record represents data published by NCI. It uses catalogue metadata modified from Geoscience Australia. See our Record Lineage Information for more details.","noCache":false,"service":false,"adminArea":null,"contactOrg":"Commonwealth Scientific & Industrial Research Organisation (CSIRO)","contactPerson":"Cudahy, T.","funderOrg":"Unknown","authors":["Cudahy, T.","Caccetta, M.","Lau, I.","Rodger, A.","Laukamp, C.","Ong, C.","Chia, J.","Collings, S.","Rankine, T.","Fraser, R.","Woodcock, R.","Vote, J.","Warren, P.","Thomas, M.","Tyler, I.","Mauger, A.","Close, D.","Jones, M.","Abrams, M.","Cudahy, T.","Caccetta, M.","Lau, I.","Rodger, A.","Laukamp, C.","Ong, C.","Chia, J.","Collings, S.","Rankine, T.","Fraser, R.","Woodcock, R.","Vote, J.","Warren, P.","Thomas, M.","Tyler, I.","Mauger, A.","Close, D.","Jones, M.","Abrams, M.","Cudahy, T.","Caccetta, M.","Lau, I.","Rodger, A.","Laukamp, C.","Ong, C.","Chia, J.","Collings, S.","Rankine, T.","Fraser, R.","Woodcock, R.","Vote, J.","Warren, P.","Thomas, M.","Tyler, I.","Mauger, A.","Close, D.","Jones, M.","Abrams, M.","Cudahy, T.","Caccetta, M.","Lau, I.","Rodger, A.","Laukamp, C.","Ong, C.","Chia, J.","Collings, S.","Rankine, T.","Fraser, R.","Woodcock, R.","Vote, J.","Warren, P.","Thomas, M.","Tyler, I.","Mauger, A.","Close, D.","Jones, M.","Abrams, M."],"onlineResources":[{"url":"https://gsky.nci.org.au/ows/aster?service=WMS&version=1.1.1&request=GetCapabilities","type":"WMS","name":"MgOH_Group_Content","description":"NCI GSKY Web Map Service (WMS)","version":"1.1.1","applicationProfile":"","protocolRequest":""},{"url":"https://gsky.nci.org.au/ows/aster?service=WCS&version=1.0.0&request=GetCapabilities","type":"WCS","name":"MgOH_Group_Content","description":"NCI GSKY Web Coverage Service (WCS)","version":"","applicationProfile":"","protocolRequest":""},{"url":"https://thredds.nci.org.au/thre