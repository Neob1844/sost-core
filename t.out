hBoundLatitude":-28.14546056929112,"southBoundLatitude":-37.549235295845264}],"descriptiveKeywords":["NSW_2024-10-30_Gravity_Air_Iso_Boug_ES_on_TMI_RTP_Tilt_GDA94_MGA55_v2.rgba","WCS","GeoTIFF","World","Earth Sciences"],"datasetURIs":[],"constraints":["https://creativecommons.org/licenses/by/4.0"],"useLimitConstraints":["https://creativecommons.org/licenses/by/4.0"],"accessConstraints":[],"childRecords":[],"date":"2023-08-18T00:00:00 UTC","minScale":null,"maxScale":null,"knownLayerIds":["geop-isos-grav-over-tmi-rtp-tilt"],"knownLayerNames":["NSW Isostatic Gravity Over Tmi Rtp Tilt"],"knownLayerDescriptions":["NSW isostatic gravity over TMI RTP tilt"]}],"relatedRecords":[],"capabilityRecords":[]},{"name":"Geological Provinces","hidden":false,"description":"Geological Provinces provided by GA","id":"geological-provinces","proxyUrl":null,"proxyGetFeatureInfoUrl":null,"proxyCountUrl":null,"proxyStyleUrl":null,"proxyDownloadUrl":null,"mapStyles":null,"feature_count":0,"singleTile":false,"legendImg":null,"previewImg":null,"group":"Boundaries","layerMode":"NA","filterCollection":{"optionalFilters":[{"label":"Name","xpath":"NAME","value":null,"predicate":"ISLIKE","toolTip":null,"type":"OPTIONAL.TEXT"},{"label":"Polygon BBox","xpath":"the_geom","value":null,"predicate":"ISEQUAL","toolTip":null,"type":"OPTIONAL.POLYGONBBOX"}],"hiddenParams":null,"mandatoryFilters":null},"supportsCsvDownloads":true,"cswRecords":[{"name":"ProvinceFullExtent","resourceProvider":"Unknown","id":"598fe40881bf4395dae2b0919b4dc57a844c1bf8","recordInfoUrl":"https://portal.auscope.org.au/geonetwork/srv/eng/catalog.search#/metadata/598fe40881bf4395dae2b0919b4dc57a844c1bf8","description":"Australian Geological Provinces 2018.01 edition\n\nCitation identifierDigital Object Identifier/https://dx.doi.org/10.26186/116823\nPublisher\tCommonwealth of Australia (Geoscience Australia)\tVoice\nAuthor\tRaymond, O.L.\n\nThe Australian Geological Provinces Database contains descriptions and spatial extents of the fundamental geological elements of the Australian continent and offshore surrounds. Province types include sedimentary basins, tectonic provinces such as cratons and orogens, igneous provinces, and metallogenic provinces. Spatial data has been captured largely at approximately 1:1M scale for intended use between 1:2M and 1:5M scale.\n\nThis edition (2018.01) of the dataset is NOT a complete representation of all of Australia's geological provinces. Further work is required to complete the national geological province collection. Additionally, not all the provinces supplied herein have undergone a rigorous quality assurance (QA) check to ensure the accuracy and completeness of their descriptions.\n\nWhere possible, provinces have been attributed with their age, contained lithostratigraphic units, relationships to other provinces, geological history, mineral resource occurrences, and selected published references. The geological definition of some provinces is contentious. While every effort has been made to achieve a consensus interpretation of each province, including significant collaboration with state and territory geological surveys, scientific debate may still occur about the nature and extent of some provinces.\n\nThe full 2D spatial extent (ie, including the extent of a province under any overlying cover material) of provinces has been captured. Additionally, the extent of outcrop of some provinces has also been captured. Where possible, the full extent outlines of provinces have been attributed with information about the source, accuracy, and observation method of those lines.","noCache":false,"service":false,"adminArea":null,"contactOrg":"AuScope","contactPerson":"AuScope AVRE Program","funderOrg":"Unknown","authors":[],"onlineResources":[{"url":"https://research-community.geoanalytics.csiro.au/geoserver/wfs","type":"WFS","name":"gml:ProvinceFullExtent","description":"ProvinceFullExtent","version":"","applicationProfile":"","protocolRequest":""},{"url":"https://research-community.geoanalytics.csiro.au/geoserver/ows?SERVICE=WMS&","type":"WMS","name":"gml:ProvinceFullExtent","description":"ProvinceFullExtent","version":"1.1.1","applicationProfile":"","protocolRequest":""}],"geographicElements":[{"type":"bbox","eastBoundLongitude":171.88106000000005,"westBoundLongitude":106.56906097500001,"northBoundLatitude":-3.6270000000000095,"southBoundLatitude":-49.861429999999984}],"descriptiveKeywords":["features","Earth Sciences","ProvinceFullExtent","World"],"datasetURIs":[],"constraints":["","https://creativecommons.org/licenses/by/4.0"],"useLimitConstraints":["https://creativecommons.org/licenses/by/4.0"],"accessConstraints":[],"childRecords":[],"date":"2023-08-18T00:00:00 UTC","minScale":null,"maxScale":null,"knownLayerIds":["geological-provinces"],"knownLayerNames":["Geological Provinces"],"knownLayerDescriptions":["Geological Provinces provided by GA"]}],"relatedRecords":[],"capabilityRecords":[]},{"name":"NSW Geology - Provinces and Basins","hidden":false,"description":"NSW Geology - Provinces and Basins","id":"nsw-geological-provinces","proxyUrl":null,"proxyGetFeatureInfoUrl":null,"proxyCountUrl":null,"proxyStyleUrl":null,"proxyDownloadUrl":null,"mapStyles":null,"feature_count":0,"singleTile":false,"legendImg":null,"previewImg":null,"group":"Boundaries","layerMode":"NA","supportsCsvDownloads":true,"cswRecords":[{"name":"Geology-provinces and basins","resourceProvider":"Unknown","id":"fecdab7f4e048a2c1c26f3d05a5b50b7215ed27b","recordInfoUrl":"https://portal.auscope.org.au/geonetwork/srv/eng/catalog.search#/metadata/fecdab7f4e048a2c1c26f3d05a5b50b7215ed27b","description":"","noCache":false,"service":false,"adminArea":null,"contactOrg":"Geological Survey of NSW","contactPerson":null,"funderOrg":"Unknown","authors":[],"onlineResources":[{"url":"https://public-gs.geoscience.nsw.gov.au/geoserver/ows?SERVICE=WMS&","type":"WMS","name":"geology-misc:geology_provinces_basins","description":"Geology-provinces and basins","version":"1.