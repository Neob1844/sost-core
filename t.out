tyleUrl":null,"proxyDownloadUrl":null,"mapStyles":null,"feature_count":0,"singleTile":false,"legendImg":null,"previewImg":null,"group":"Passive Seismic","layerMode":"NA","cswRecords":[{"name":"AusPASS - Eastern Australia Linkage (EAL3)","resourceProvider":"Unknown","id":"99fa01c5-76f4-4d74-a5ce-5c33f7af4be5","recordInfoUrl":"https://portal.auscope.org.au/geonetwork/srv/eng/catalog.search#/metadata/99fa01c5-76f4-4d74-a5ce-5c33f7af4be5","description":"AusPass is a service dedicated to the acquisition, management, and distribution of passive seismological data in Australia. Extensive fieldwork projects are conducted across the country, organized in seismic arrays (i.e. groups of seismic stations).","noCache":false,"service":false,"adminArea":"ACT","contactOrg":"ANU Research School of Earth Sciences","contactPerson":null,"funderOrg":"AuScope","authors":[],"onlineResources":[{"url":"https://auspass.edu.au","type":"IRIS","name":"7L","description":"Eastern Australia Linkage (EAL3), FDSN code \"7L\"","version":"","applicationProfile":"","protocolRequest":""},{"url":"https://www.fdsn.org/networks/detail/7L_2011/","type":"WWW","name":"FDSN Network Information","description":"FDSN Network Information","version":"","applicationProfile":"","protocolRequest":""}],"geographicElements":[{"type":"bbox","eastBoundLongitude":156.0,"westBoundLongitude":112.0,"northBoundLatitude":-10.0,"southBoundLatitude":-45.0}],"descriptiveKeywords":["seismology","Earth Science","Earth Sciences"],"datasetURIs":[],"constraints":["https://creativecommons.org/licenses/by/4.0/"],"useLimitConstraints":["https://creativecommons.org/licenses/by/4.0/"],"accessConstraints":[],"childRecords":[],"date":"2025-06-19T00:00:00 UTC","minScale":null,"maxScale":null,"knownLayerIds":["seismology-eal3"],"knownLayerNames":["EAL3: Eastern Australia Linkage"],"knownLayerDescriptions":["The EAL3 seismic array feed from AusPass: the Australian Passive Seismic Server."]}],"relatedRecords":[],"capabilityRecords":[]},{"name":"BASS: Bass strait from 2011 to 2013","hidden":false,"description":"The BASS seismic array feed from AusPass: the Australian Passive Seismic Server.","id":"seismology-bass","proxyUrl":"getIRISStations.do","proxyGetFeatureInfoUrl":null,"proxyCountUrl":null,"proxyStyleUrl":null,"proxyDownloadUrl":null,"mapStyles":null,"feature_count":0,"singleTile":false,"legendImg":null,"previewImg":null,"group":"Passive Seismic","layerMode":"NA","cswRecords":[{"name":"AusPASS - Bass Strait (BASS)","resourceProvider":"Unknown","id":"bd82372b-2b07-4251-838e-a6778572d664","recordInfoUrl":"https://portal.auscope.org.au/geonetwork/srv/eng/catalog.search#/metadata/bd82372b-2b07-4251-838e-a6778572d664","description":"AusPass is a service dedicated to the acquisition, management, and distribution of passive seismological data in Australia. Extensive fieldwork projects are conducted across the country, organized in seismic arrays (i.e. groups of seismic stations).\n\nIn 2011, 24 broadband stations were deployed in southern Victoria, northern Tasmania, and the Bass Strait Islands as part of the BASS experiment. This is a joint venture between The Australian National University and the University of Tasmania, and aims to image the crust and lithosphere beneath Bass strait by exploiting ambient seismic noise.","noCache":false,"service":false,"adminArea":"ACT","contactOrg":"ANU Research School of Earth Sciences","contactPerson":null,"funderOrg":"AuScope","authors":[],"onlineResources":[{"url":"https://auspass.edu.au","type":"IRIS","name":"1P","description":"Bass Strait (BASS), FDSN code \"1P (2011-2013)\"","version":"","applicationProfile":"","protocolRequest":""},{"url":"https://doi.org/10.7914/SN/1P_2011","type":"DOI","name":"Anya Reading, & Nick Rawlinson. (2011). Bass Strait. International Federation of Digital Seismograph Networks.","description":"Citation Information","version":"","applicationProfile":"","protocolRequest":""}],"geographicElements":[{"type":"bbox","eastBoundLongitude":156.0,"westBoundLongitude":112.0,"northBoundLatitude":-10.0,"southBoundLatitude":-45.0}],"descriptiveKeywords":["seismology","Earth Science","Earth Sciences"],"datasetURIs":[],"constraints":["https://creativecommons.org/licenses/by/4.0/"],"useLimitConstraints":["https://creativecommons.org/licenses/by/4.0/"],"accessConstraints":[],"childRecords":[],"date":"2025-06-19T00:00:00 UTC","minScale":null,"maxScale":null,"knownLayerIds":["seismology-bass"],"knownLayerNames":["BASS: Bass strait from 2011 to 2013"],"knownLayerDescriptions":["The BASS seismic array feed from AusPass: the Australian Passive Seismic Server."]}],"relatedRecords":[],"capabilityRecords":[]},{"name":"SQEAL: South Queensland Eastern Australia Linkage","hidden":false,"description":"The SQEAL seismic array feed from AusPass: the Australian Passive Seismic Server.","id":"seismology-sqeal","proxyUrl":"getIRISStations.do","proxyGetFeatureInfoUrl":null,"proxyCountUrl":null,"proxyStyleUrl":null,"proxyDownloadUrl":null,"mapStyles":null,"feature_count":0,"singleTile":false,"legendImg":null,"previewImg":null,"group":"Passive Seismic","layerMode":"NA","cswRecords":[{"name":"AusPASS - South Queensland Eastern Australia Linkage (SQEAL)","resourceProvider":"Unknown","id":"1a1b10eb-f2b3-4dee-a4de-84027ee335d4","recordInfoUrl":"https://portal.auscope.org.au/geonetwork/srv/eng/catalog.search#/metadata/1a1b10eb-f2b3-4dee-a4de-84027ee335d4","description":"AusPass is a service dedicated to the acquisition, management, and distribution of passive seismological data in Australia. Extensive fieldwork projects are conducted across the country, organized in seismic arrays (i.e. groups of seismic stations).\n\nThis array is part of the WOMBAT rolling array. This array was completed in 2 parts. 47 instruments were installed in the eastern half of the array from 2012 and 52 instruments were installed in 2013 over the western half of the array. Instruments were short-period (Lennartz 3D-Lite MkII) seismometers and LPR200 recorders. Station spacing is approximately 50 km. Funding was provided by the Australian Research Council as part of a Discovery Project DP120103673 and instrumentation was provided through ANSIR and AuScope","noCache":false,"service":false,"adminArea":"ACT","contactOrg":"ANU Research School of Earth Sciences","contactPerson":null,"funderOrg":"AuScope","authors":[],"onlineResources":[{"url":"https://auspass.edu.au","type":"IRIS","name":"8J","description":"South Queensland Eastern Australia Linkage (SQEAL), FDSN code \"8J (2012-2014)\"","version":"","applicationProfile":"","protocolRequest":""},{"url":"https://doi.org/10.7914/SN/8J_2012","type":"DOI","name":"Nicholas Rawlinson, & Yingjie Yang. (2012). South Queensland Eastern Australia Linkage - ARC Discovery Grant DP120103673 [Data set]. Australian Passive Seismic Server.","description":"Citation Information","version":"","applicationProfile":"","protocolRequest":""}],"geographicElements":[{"type":"bbox","eastBoundLongitude":156.0,"westBoundLongitude":112.0,"northBoundLatitude":-10.0,"southBoundLatitude":-45.0}],"descriptiveKeywords":["seismology","Earth Science","Earth Sciences"],"datasetURIs":[],"constraints":["https://creativecommons.org/licenses/by/4.0/"],"useLimitConstraints":["https://creativecommons.org/licenses/by/4.0/"],"accessConstraints":[],"childRecords":[],"date":"2025-06-19T00:00:00 UTC","minScale":null,"maxScale":null,"knownLayerIds":["seismology-sqeal"],"knownLayerNames":["SQEAL: South Queensland Eastern Australia Linkage"],"knownLayerDescriptions":["The SQEAL seismic array feed from AusPass: the Australian Passive Seismic Server."]}],"relatedRecords":[],"capabilityRecords":[]},{"name":"AQ3 SW Queensland and NW New South Wales","hidden":false,"description":"The AQ3 seismic array feed from AusPass: the Australian Passive Seismic Server.","id":"seismology-aq3","proxyUrl":"getIRISStations.do","proxyGetFeatureInfoUrl":null,"proxyCountUrl":null,"proxyStyleUrl":null,"proxyDownloadUrl":null,"mapStyles":null,"feature_count":0,"singleTile":false,"legendImg":null,"previewImg":null,"group":"Passive Seismic","layerMode":"NA","cswRecords":[{"name":"AusPASS - AQ3 SW Queensland and NW New South Wales","resourceProvider":"Unknown","id":"e6a9587e-1848-4370-abc0-811d96dcd9e9","recordInfoUrl":"https://portal.auscope.org.au/geonetwork/srv/eng/catalog.search#/metadata/e6a9587e-1848-4370-abc0-811d96dcd9e9","description":"AusPass is a service dedicated to the acquisition, management, and distribution of passive seismological data in Australia. Extensive fieldwork projects are conducted across the country, organized in seismic arrays (i.e. groups of seismic stations).\n\nAQ3 is part of the Australian WOMBAT transportable array. AQ3 covers a 160000 square km area across the south-west corner of Queensland and the north-west corner of New South Wales. Seismometers are Lennartz LE-3DLite MkII and are sited at approximately 55-65 km spacings. A sample rate of 50 samples per second was used for continuous recording on three channels.","noCache":false,"service":false,"adminArea":"ACT","contactOrg":"ANU Research School of Earth Sciences","contactPerson":null,"funderOrg":"AuScope","authors":[],"onlineResources":[{"url":"https://auspass.edu.au","type":"IRIS","name":"4J","description":"AQ3 SW Queensland and NW New South Wales, FDSN code \"4J (2014-2016)\"","version":"","applicationProfile":"","protocolRequest":""},{"url":"https://doi.org/10.7914/SN/4J_2014","type":"DOI","name":"AusPass. (2014). AQ3 SW Queensland and NW New South Wales. International Federation of Digital Seismograph Networks.","description":"Citation Information","version":"","applicationProfile":"","protocolRequest":""}],"geographicElements":[{"type":"bbox","eastBoundLongitude":156.0,"westBoundLongitude":112.0,"northBoundLatitude":-10.0,"southBoundLatitude":-45.0}],"descriptiveKeywords":["seismology","Earth Science","Earth Sciences"],"datasetURIs":[],"constraints":["https://creativecommons.org/licenses/by/4.0/"],"useLimitConstraints":["https://creativecommons.org/licenses/by/4.0/"],"accessConstraints":[],"childRecords":[],"date":"2025-06-19T00:00:00 UTC","minScale":null,"maxScale":null,"knownLayerIds":["seismology-aq3"],"knownLayerNames":["AQ3 SW Queensland and NW New South Wales"],"knownLayerDescriptions":["The AQ3 seismic array feed from AusPass: the Australian Passive Seismic Server."]}],"relatedRecords":[],"capabilityRecords":[]},{"name":"AQT: Western Queensland","hidden":false,"description":"The AQT seismic array feed from AusPass: the Australian Passive Seismic Server.","id":"seismology-aqt","proxyUrl":"getIRISStations.do","proxyGetFeatureInfoUrl":null,"proxyCountUrl":null,"proxyStyleUrl":null,"proxyDownloadUrl":null,"mapStyles":null,"feature_count":0,"singleTile":false,"legendImg":null,"previewImg":null,"group":"Passive Seismic","layerMode":"NA","cswRecords":[{"name":"AusPASS - Western Queensland (AQT)","resourceProvider":"Unknown","id":"394cb5cd-1ed1-401a-897d-3f670df7b023","recordInfoUrl":"https://portal.auscope.org.au/geonetwork/srv/eng/catalog.search#/metadata/394cb5cd-1ed1-401a-897d-3f670df7b023","description":"AusPass is a service dedicated to the acquisition, management, and distribution of passive seismological data in Australia. Extensive fieldwork projects are conducted across the country, organized in seismic arrays (i.e. groups of seismic stations).\n\nThis project is an AuScope funded array in Western Queensland, Australia. It consists of 93 sites including 8 Guralp CMG-3ESP, 12 Trillium compact (120s) and 73 Lennartz 3D-Lite MKII seismometers. This project is part of the WOMBAT rolling array.","noCache":false,"service":false,"adminArea":"ACT","contactOrg":"ANU Research School of Earth Sciences","contactPerson":null,"funderOrg":"AuScope","authors":[],"onlineResources":[{"url":"https://auspass.edu.au","type":"IRIS","name":"1Q","description":"Western Queensland (AQT), FDSN code \"1Q (2016-2017)\"","version":"","applicationProfile":"","protocolRequest":""},{"url":"https://doi.org/10.7914/SN/1Q_2016","type":"DOI","name":"AusPass. (2016). AQT. International Federation of Digital Seismograph Networks.","description":"Citation Information","version":"","applicationProfile":"","protocolRequest":""}],"geographicElements":[{"type":"bbox","eastBoundLongitude":156.0,"westBoundLongitude":112.0,"northBoundLatitude":-10.0,"southBoundLatitude":-45.0}],"descriptiveKeywords":["seismology","Earth Science","Earth Sciences"],"datasetURIs":[],"constraints":["https://creativecommons.org/licenses/by/4.0/"],"useLimitConstraints":["https://creativecommons.org/licenses/by/4.0/"],"accessConstraints":[],"childRecords":[],"date":"2025-06-19T00:00:00 UTC","minScale":null,"maxScale":null,"knownLayerIds":["seismology-aqt"],"knownLayerNames":["AQT: Western Queensland"],"knownLayerDescriptions":["The AQT seismic array feed from AusPass: the Australian Passive Seismic Server."]}],"relatedRecords":[],"capabilityRecords":[]},{"name":"Banda Arc: Transitions in the Banda Arc-Australia continental collision","hidden":false,"description":"The BANDA seismic array feed from AusPass: the Australian Passive Seismic Server.","id":"seismology-banda","proxyUrl":"getIRISStations.do","proxyGetFeatureInfoUrl":null,"proxyCountUrl":null,"proxyStyleUrl":null,"proxyDownloadUrl":null,"mapStyles":null,"feature_count":0,"singleTile":false,"legendImg":null,"previewImg":null,"group":"Passive Seismic","layerMode":"NA","cswRecords":[{"name":"AusPASS - Transitions in the Banda Arc-Australia continental collision (Banda Arc)","resourceProvider":"Unknown","id":"4c7b8b29-4e35-4487-9d2a-ead35a06a679","recordInfoUrl":"https://portal.auscope.org.au/geonetwork/srv/eng/catalog.search#/metadata/4c7b8b29-4e35-4487-9d2a-ead35a06a679","description":"AusPass is a service dedicated to the acquisition, management, and distribution of passive seismological data in Australia. Extensive fieldwork projects are conducted across the country, organized in seismic arrays (i.e. groups of seismic stations).\n\nEastern Indonesia is one of the least well understood geological domains of our planet, and yet the region provides a truly remarkable natural experiment for unraveling the complex dynamics of convergent tectonics. The recent, subduction-related collision of the Australian continental lithosphere with the active Banda arc effectively captures the initiation of convergence orogenesis and offers a rare glimpse into a process that has shaped Earth’s evolution over geologic time, as well as providing fresh insights into seismic hazards confronting the world’s fourth most populous country. A number of mysteries remain about the transition from subduction to arc-continental collision in the Banda arc, reflecting fundamental gaps in the general understanding of collisional tectonics.","noCache":false,"service":false,"adminArea":"ACT","contactOrg":"ANU Research School of Earth Sciences","contactPerson":null,"funderOrg":"AuScope","authors":[],"onlineResources":[{"url":"https://auspass.edu.au","type":"IRIS","name":"YS","description":"Transitions in the Banda Arc-Australia continental collision (Banda Arc), FDSN code \"YS (2014-2018)\"","version":"","applicationProfile":"","protocolRequest":""},{"url":"https://doi.org/10.7914/SN/YS_2014","type":"DOI","name":"Meghan S Miller. (2014). Transitions in the Banda Arc-Australia continental collision [Data set]. International Federation of Digital Seismograph Networks.","description":"Citation Information","version":"","applicationProfile":"","protocolRequest":""}],"geographicElements":[{"type":"bbox","eastBoundLongitude":156.0,"westBoundLongitude":112.0,"northBoundLatitude":-10.0,"southBoundLatitude":-45.0}],"descriptiveKeywords":["seismology","Earth Science","Earth Sciences"],"datasetURIs":[],"constraints":["https://creativecommons.org/licenses/by/4.0/"],"useLimitConstraints":["https://creativecommons.org/licenses/by/4.0/"],"accessConstraints":[],"childRecords":[],"date":"2025-06-19T00:00:00 UTC","minScale":null,"maxScale":null,"knownLayerIds":["seismology-banda"],"knownLayerNames":["Banda Arc: Transitions in the Banda Arc-Australia continental collision"],"knownLayerDescriptions":["The BANDA seismic array feed from AusPass: the Australian Passive Seismic Server."]}],"relatedRecords":[],"capabilityRecords":[]},{"name":"ASR","hidden":false,"description":"The ASR seismic array feed from AusPass: the Australian Passive Seismic Server.","id":"seismology-asr","proxyUrl":"getIRISStations.do","proxyGetFeatureInfoUrl":null,"proxyCountUrl":null,"proxyStyleUrl":null,"proxyDownloadUrl":null,"mapStyles":null,"feature_count":0,"singleTile":false,"legendImg":null,"previewImg":null,"group":"Passive Seismic","layerMode":"NA","cswRecords":[{"name":"AusPASS - ASR","resourceProvider":"Unknown","id":"9dca9b1f-7eac-43d8-9697-8f8450c386ba","recordInfoUrl":"https://portal.auscope.org.au/geonetwork/srv/eng/catalog.search#/metadata/9dca9b1f-7eac-43d8-9697-8f8450c386ba","description":"AusPass is a service dedicated to the acquisition, management, and distribution of passive seismological data in Australia. Extensive fieldwork projects are conducted across the country, organized in seismic arrays (i.e. groups of seismic stations).\n\nThis project was an infill network to cover areas of South Australia that have never had any seismic imaging work done. Instruments are 120s Trillium compacts.","noCache":false,"service":false,"adminArea":"ACT","contactOrg":"ANU Research School of Earth Sciences","contactPerson":null,"funderOrg":"AuScope","authors":[],"onlineResources":[{"url":"https://www.fdsn.org/networks/detail/5J_2017/","type":"WWW","name":"FDSN Network Information","description":"FDSN Network Information","version":"","applicationProfile":"","protocolRequest":""},{"url":"https://auspass.edu.au","type":"IRIS","name":"5J","description":"ASR, FDSN code \"5J\"","version":"","applicationProfile":"","protocolRequest":""}],"geographicElements":[{"type":"bbox","eastBoundLongitude":156.0,"westBoundLongitude":112.0,"northBoundLatitude":-10.0,"southBoundLatitude":-45.0}],"descriptiveKeywords":["seismology","Earth Science","Earth Sciences"],"datasetURIs":[],"constraints":["https://creativecommons.org/licenses/by/4.0/"],"useLimitConstraints":["https://creativecommons.org/licenses/by/4.0/"],"accessConstraints":[],"childRecords":[],"date":"2025-06-19T00:00:00 UTC","minScale":null,"maxScale":null,"knownLayerIds":["seismology-asr"],"knownLayerNames":["ASR"],"knownLayerDescriptions":["The ASR seismic array feed from AusPass: the Australian Passive Seismic Server."]}],"relatedRecords":[],"capabilityRecords":[]},{"name":"Marla Line","hidden":false,"description":"The MARLA LINE seismic array feed from AusPass: the Australian Passive Seismic Server.","id":"seismology-marla-line","proxyUrl":"getIRISStations.do","proxyGetFeatureInfoUrl":null,"proxyCountUrl":null,"proxyStyleUrl":null,"proxyDownloadUrl":null,"mapStyles":null,"feature_count":0,"singleTile":false,"legendImg":null,"previewImg":null,"group":"Passive Seismic","layerMode":"NA","cswRecords":[{"name":"AusPASS - Marla Line","resourceProvider":"Unknown","id":"51fe055b-616e-464c-84cb-3ebcbee98beb","recordInfoUrl":"https://portal.auscope.org.au/geonetwork/srv/eng/catalog.search#/metadata/51fe055b-616e-464c-84cb-3ebcbee98beb","description":"AusPass is a service dedicated to the acquisition, management, and distribution of passive seismological data in Australia. Extensive fieldwork projects are conducted across the country, organized in seismic arrays (i.e. groups of seismic stations).\n\nThe Marla Line is a high density seismic line across a major crustal boundary in Central Australia. The line is approximately 230km in length with average station spacing of approximately 3.4km.","noCache":false,"service":false,"adminArea":"ACT","contactOrg":"ANU Research School of Earth Sciences","contactPerson":null,"funderOrg":"AuScope","authors":[],"onlineResources":[{"url":"https://auspass.edu.au","type":"IRIS","name":"3G","description":"Marla Line, FDSN code \"3G (2018-2019)\"","