Styles":null,"feature_count":0,"singleTile":false,"legendImg":null,"previewImg":null,"group":"Geological Maps","layerMode":"NA","cswRecords":[{"name":"1:2 500 000 State interpreted dyke suites (DMIRS-077)","resourceProvider":"Unknown","id":"525e9ce0-a62f-4aa0-9559-274f340b25d1","recordInfoUrl":"https://portal.auscope.org.au/geonetwork/srv/eng/catalog.search#/metadata/525e9ce0-a62f-4aa0-9559-274f340b25d1","description":"https://catalogue.data.wa.gov.au/dataset/1-2-500-000-state-interpreted-dyke-suites-dmirs-077","noCache":false,"service":false,"adminArea":null,"contactOrg":"Data WA","contactPerson":null,"funderOrg":"Unknown","authors":[],"onlineResources":[{"url":"https://public-services.slip.wa.gov.au:443/public/services/SLIP_Public_Services/Geology_and_Soils_Map/MapServer/WMSServer?","type":"WMS","name":"21","description":"https://catalogue.data.wa.gov.au/dataset/1-2-500-000-state-interpreted-dyke-suites-dmirs-077","version":"1.1.1","applicationProfile":"","protocolRequest":""}],"geographicElements":[{"type":"bbox","eastBoundLongitude":129.0,"westBoundLongitude":114.5128,"northBoundLatitude":-13.8363,"southBoundLatitude":-35.1084}],"descriptiveKeywords":["SLIP","Soil","World","Earth Sciences"],"datasetURIs":[],"constraints":["","https://creativecommons.org/licenses/by/4.0"],"useLimitConstraints":["https://creativecommons.org/licenses/by/4.0"],"accessConstraints":[],"childRecords":[],"date":"2026-06-18T00:00:00 UTC","minScale":null,"maxScale":null,"knownLayerIds":["1-2-500-000-state-interpreted-dyke-suites"],"knownLayerNames":["WA 1:2 500 000 State Interpreted Dyke Suites"],"knownLayerDescriptions":["The digital '1:2 500 000 geological map of Western Australia' comprises four layers: the primary 1:2 500 000 State interpreted bedrock geology, the 1:2 500 000 State Cenozoic geology, the 1:2 500 000 State interpreted dyke suites, and the 1:2 500 000 State interpreted bedrock geology structural lines."]}],"relatedRecords":[],"capabilityRecords":[]},{"name":"WA Linear Structures 1:100 000","hidden":false,"description":"The digital '1:100 000 State interpreted bedrock geology of Western Australia' comprises three layers: the primary 1:100 000 State interpreted bedrock geology, the 1:100 000 State interpreted bedrock geology lines , and the 1:100 000 State linear structure layer.","id":"linear-structures-1-100-000","proxyUrl":null,"proxyGetFeatureInfoUrl":null,"proxyCountUrl":null,"proxyStyleUrl":null,"proxyDownloadUrl":null,"mapStyles":null,"feature_count":0,"singleTile":false,"legendImg":null,"previewImg":null,"group":"Geological Maps","layerMode":"NA","cswRecords":[{"name":"Linear structures 1:100 000 (DMIRS-053)","resourceProvider":"Unknown","id":"2ac763b0-678b-4058-9edf-69b6fb9ba2b2","recordInfoUrl":"https://portal.auscope.org.au/geonetwork/srv/eng/catalog.search#/metadata/2ac763b0-678b-4058-9edf-69b6fb9ba2b2","description":"The digital ‘1:100 000 State interpreted bedrock geology of Western Australia’ comprises three layers: the primary 1:100 000 State interpreted bedrock geology, the 1:100 000 State interpreted bedrock geology lines , and the 1:100 000 State linear structure layer. The product covers approximately 30% of Western Australia, with a focus on areas of exposed Archean and Proterozoic bedrock. The linear structure layer refers primarily to pre-Cenozoic bedrock structures. This compilation is based on Geological Survey of Western Australia’s (GSWA) published Geological Information Series (GIS) and Geological Exploration Packages (GEP) for which digital 1:100 000 and 1:250 000 interpreted bedrock geology is available. The data packages included are: Kimberley 2017, Tanami–Arunta 2016, West Musgrave 2017, East Albany–Fraser Orogen 2014 (1:250 000 pre-Mesozoic), West Capricorn 2016, East Yilgarn 2017, South Yilgarn 2016, Murchison 2017, and Pilbara 2014. Geological interpretation in these packages is based on extensive fieldwork and interpretation of geophysical datasets (magnetics, radiometrics and gravity), remote sensing imagery (ASTER and LANDSAT), seismic and magnetotelluric profiles, drilling, and previously published and unpublished geological mapping. With the exception of minor topological corrections, the spatial integrity of the source packages is maintained. For adjacent but separately compiled packages, seamless interpretation along the edges of project areas has not been executed in order to preserve the spatial integrity of the source information. The nomenclature and hierarchy for the lithostratigraphic units in the polygon and line layers are based on weekly updates from the Explanatory Notes System (ENS). In order to provide the most up-to-date geological information for the units in question, attribution from the original source is modified to remove superseded stratigraphic units, display correct stratigraphic relationships, and include more recent geochronology. The source package of each feature is captured as an additional attribute field. Individual packages are available via the Department of Mines, Industry Regulation and Safety’s (DMIRS) eBookshop.\n\nLicense: Creative Commons Attribution\n\nTags: 100 000, Bedrock, Geology\n\nContact: geological.survey@dmirs.wa.gov.au","noCache":false,"service":false,"adminArea":null,"contactOrg":"Data WA","contactPerson":null,"funderOrg":"Unknown","authors":[],"onlineResources":[{"url":"https://public-services.slip.wa.gov.au:443/public/services/SLIP_Public_Services/Geology_and_Soils_Map/MapServer/WMSServer?","type":"WMS","name":"23","description":"Linear structures 1:100 000 (DMIRS-053)","version":"1.1.1","applicationProfile":"","protocolRequest":""}],"geographicElements":[{"type":"bbox","eastBoundLongitude":129.0,"westBoundLongitude":115.0,"northBoundLatitude":-13.7965,"southBoundLatitude":-34.25}],"descriptiveKeywords":["SLIP","Soil","World","Earth Sciences"],"datasetURIs":[],"constraints":["","https://creativecommons.org/licenses/by/4.0"],"useLimitConstraints":["https://creativecommons.org/licenses/by/4.0"],"accessConstraints":[],"childRecords":[],"date":"2026-06-18T00:00:00 UTC","minScale":null,"maxScale":null,"knownLayerIds":["linear-structures-1-100-000"],"knownLayerNames":["WA Linear Structures 1:100 000"],"knownLayerDescriptions":["The digital '1:100 000 State interpreted bedrock geology of Western Australia' comprises three layers: the primary 1:100 000 State interpreted bedrock geology, the 1:100 000 State interpreted bedrock geology lines , and the 1:100 000 State linear structure layer."]}],"relatedRecords":[],"capabilityRecords":[]},{"name":"WA Clay Sample Analyses","hidden":false,"description":"Clay sample analyses contains geoscientific and analytical data from clay samples collected during fieldwork. The data are held in GDA 94","id":"clay-sample-analyses","proxyUrl":null,"proxyGetFeatureInfoUrl":null,"proxyCountUrl":null,"proxyStyleUrl":null,"proxyDownloadUrl":null,"mapStyles":null,"feature_count":0,"singleTile":false,"legendImg":null,"previewImg":null,"group":"Soil Chemistry","geojson":{"bbox":[[115.35,-32.6],[117.35,-31.6]]},"layerMode":"NA","cswRecords":[{"name":"Clay sample analyses (DMIRS-041)","resourceProvider":"Unknown","id":"d77d9a25-40a4-454b-991c-58e4c1e8bcbb","recordInfoUrl":"https://portal.auscope.org.au/geonetwork/srv/eng/catalog.search#/metadata/d77d9a25-40a4-454b-991c-58e4c1e8bcbb","description":"Clay sample analyses contains geoscientific and analytical data from clay samples collected during fieldwork. The data are held in GDA 94\n\nLicense: Creative Commons Attribution\n\nTags: Analyses, Clay, Geology, Geosciences, Industry, Minerals, Mining\n\nContact: landuseplanning@dmirs.wa.gov.au","noCache":false,"service":false,"adminArea":null,"contactOrg":"Data WA","contactPerson":null,"funderOrg":"Unknown","authors":[],"onlineResources":[{"url":"https://public-services.slip.wa.gov.au:443/public/services/SLIP_Public_Services/Geology_and_Soils_Map/MapServer/WMSServer?","type":"WMS","name":"24","description":"Clay sample analyses contains geoscientific and