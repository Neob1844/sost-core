ude":138.33,"northBoundLatitude":-18.0,"southBoundLatitude":-22.15}],"descriptiveKeywords":["PMD*CRC Publication","Project I2-Prests and Posters","pmd*CRC","AU-QLD","Earth Sciences","Published_External"],"datasetURIs":[],"constraints":["Creative Commons Attribution 4.0 International Licence"],"useLimitConstraints":[],"accessConstraints":[],"childRecords":[],"date":"2018-04-22T00:00:00 UTC","minScale":null,"maxScale":null,"knownLayerIds":["pmd-crc-project-i2-presentations"],"knownLayerNames":["Project I2 Presentations and Posters"],"knownLayerDescriptions":["PMD*CRC Project I2 Presentations and Posters"]},{"name":"Statistical Evaluation of potential critical ingredients for potential critical ingredients for the IOCG Deposit Model the IOCG Deposit Model & Melt inclusion Pilot Study","resourceProvider":"Unknown","id":"a05f7892-f88e-7506-e044-00144fdd4fa6","recordInfoUrl":"https://ecat.ga.gov.au/geonetwork/srv/eng/catalog.search#/metadata/a05f7892-f88e-7506-e044-00144fdd4fa6","description":"Statistical Evaluation of potential critical ingredients for potential critical ingredients for the IOCG Deposit Model the IOCG Deposit Model & Melt inclusion Pilot Study","noCache":false,"service":false,"adminArea":"ACT","contactOrg":"Commonwealth of Australia (Geoscience Australia)","contactPerson":null,"funderOrg":"Unknown","authors":["Mustard, R."],"onlineResources":[{"url":"https://d28rz98at9flks.cloudfront.net/70734/70734.pdf","type":"WWW","name":"Download the file (pdf)","description":"Download the file (pdf)","version":"","applicationProfile":"","protocolRequest":""}],"geographicElements":[{"type":"bbox","eastBoundLongitude":141.0,"westBoundLongitude":137.1,"northBoundLatitude":-18.0,"southBoundLatitude":-22.15}],"descriptiveKeywords":["PMD*CRC Publication","Project I2-Prests and Posters","pmd*CRC","AU-QLD","Earth Sciences","Published_External"],"datasetURIs":[],"constraints":["Creative Commons Attribution 4.0 International Licence"],"useLimitConstraints":[],"accessConstraints":[],"childRecords":[],"date":"2018-04-20T00:00:00 UTC","minScale":null,"maxScale":null,"knownLayerIds":["pmd-crc-project-i2-presentations"],"knownLayerNames":["Project I2 Presentations and Posters"],"knownLayerDescriptions":["PMD*CRC Project I2 Presentations and Posters"]},{"name":"The Fractal Distributions of Base and Precious Metal Systems,Mt Isa Inlier, Australia","resourceProvider":"Unknown","id":"a05f7892-f891-7506-e044-00144fdd4fa6","recordInfoUrl":"https://ecat.ga.gov.au/geonetwork/srv/eng/catalog.search#/metadata/a05f7892-f891-7506-e044-00144fdd4fa6","description":"Mandelbrot (1983) suggested that mineral deposits in the earth’s crust have a fractal distribution. Several studies of precious metal deposits have attempted to  demonstrate that Mandelbrot’s hypothesis is correct (eg. Carlson, 1991; Agterberg et. al, 1996; and Blenkinsop and Sanderson, 1999). A preliminary study has shown that base metal deposits may also exhibit a fractal distribution (Blenkinsop and Oliver, 2002). \n\nThe primary study area for this research, the Mt Isa Inlier, NW Queensland, Australia is a world  famous Proterozoic base metal province which contains a variety of base and precious metal deposit types, including deposits of Cu, Pb-Zn-Ag, Iron oxide Cu-Au, Au, and U-REE. The inlier is therefore an ideal location to test whether the precious and base metals located within have fractal distributions. The aim of this study is to evaluate whether the five classes of deposit type (Cu, Cu-Au (including IOCG), Ag-Pb-Zn, Au and U-REE) have fractal distributions, and to compare any resulting fractal dimensions. The study is part of a larger project that will compare the fractal dimensions of different mineral deposit types in several areas (eg. Georgetown Province, Broken Hill) and to investigate the processes that lead to the fractal distributions. \n\n<b>Published</b> in - Barnicoat, A.C. and Korsch, R.J. editors, 2004. Predictive Mineral Discovery Cooperative Research Centre – Exten