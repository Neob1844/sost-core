["https://creativecommons.org/licenses/by/4.0/","RestrictionCode: restricted","Creative Commons Attribution 4.0 International","RestrictionCode: license"],"useLimitConstraints":["Creative Commons Attribution 4.0 International","RestrictionCode: license"],"accessConstraints":["RestrictionCode: restricted"],"childRecords":[],"date":"2018-04-11T00:00:00 UTC","minScale":null,"maxScale":null,"knownLayerIds":["aster-opaque"],"knownLayerNames":["Opaque index"],"knownLayerDescriptions":["1. Band ratio: B1/B4Blue is low abundance, Red is high abundancepotentially includes  carbon black e.g. ash), magnetite, Mn oxides, and sulphides in unoxidised envornments"]}],"relatedRecords":[],"capabilityRecords":[]},{"name":"Ferric oxide content","hidden":false,"description":"1. Band ratio: B4/B3Blue is low abundance, Red is high abundance","id":"aster-ferric-oxide-content","proxyUrl":null,"proxyGetFeatureInfoUrl":null,"proxyCountUrl":null,"proxyStyleUrl":null,"proxyDownloadUrl":null,"mapStyles":null,"feature_count":0,"singleTile":false,"legendImg":null,"previewImg":null,"group":"ASTER Mineral Maps","layerMode":"NA","cswRecords":[{"name":"National ASTER Map Ferric oxide content","resourceProvider":"Resources Division","id":"f0613_6306_9085_9820","recordInfoUrl":"https://geonetwork.nci.org.au/geonetwork/srv/eng/catalog.search#/metadata/f0613_6306_9085_9820","description":"1. Band ratio: B4/B3 Blue is low abundance, Red is high abundance\r\n(1) Exposed iron ore (hematite-goethite). Use in combination with the \"Opaques index\" to help separate/map dark (a) surface lags (e.g. maghemite gravels) which can be misidentified in visible and false colour imagery; and (b) magnetite in BIF and/or bedded iron ore; and (3) Acid conditions: combine with FeOH Group content to help map jarosite which will have high values in both products. Mapping hematite versus goethite mapping is NOT easily achieved as ASTER's spectral bands were not designed to capture diagnostic iron oxide spectral behaviour. However, some information on visible colour relating in part to differences in hematite and/or goethite content can be obtained using a ratio of B2/B1 especially when this is masked using a B4/B3 to locate those pixels with sufficient iro oxide content.\n\n\n--\nThis record represents data published by NCI. It uses catalogue metadata modified from Geoscience Australia. See our Record Lineage Information for more details.","noCache":false,"service":false,"adminArea":null,"contactOrg":"Commonwealth Scientific & Industrial Research Organisation (CSIRO)","contactPerson":"Cudahy, T.","funderOrg":"Unknown","authors":["Cudahy, T.","Caccetta, M.","Lau, I.","Rodger, A.","Laukamp, C.","Ong, C.","Chia, J.","Collings, S.","Rankine, T.","Fraser, R.","Woodcock, R.","Vote, J.","Warren, P.","Thomas, M.","Tyler, I.","Mauger, A.","Close, D.","Jones, M.","Abrams, M.","Cudahy, T.","Caccetta, M.","Lau, I.","Rodger, A.","Laukamp, C.","Ong, C.","Chia, J.","Collings, S.","Rankine, T.","Fraser, R.","Woodcock, R.","Vote, J.","Warren, P.","Thomas, M.","Tyler, I.","Mauger, A.","Close, D.","Jones, M.","Abrams, M.","Cudahy, T.","Caccetta, M.","Lau, I.","Rodger, A.","Laukamp, C.","Ong, C.","Chia, J.","Collings, S.","Rankine, T.","Fraser, R.","Woodcock, R.","Vote, J.","Warren, P.","Thomas, M.","Tyler, I.","Mauger, A.","Close, D.","Jones, M.","Abrams, M.","Cudahy, T.","Caccetta, M.","Lau, I.","Rodger, A.","Laukamp, C.","Ong, C.","Chia, J.","Collings, S.","Rankine, T.","Fraser, R.","Woodcock, R.","Vote, J.","Warren, P.","Thomas, M.","Tyler, I.","Mauger, A.","Close, D.","Jones, M.","Abrams, M."],"onlineResources":[{"url":"https://gsky.nci.org.au/ows/aster?service=WMS&version=1.1.1&request=GetCapabilities","type":"WMS","name":"Ferric_Oxide_Content","description":"NCI GSKY Web Map Service (WMS)","version":"1.1.1","applicationProfile":"","protocolRequest":""},{"url":"https://gsky.nci.org.au/ows/aster?service=WCS&version=1.0.0&request=GetCapabilities","type":"WCS","name":"Ferric_Oxide_Content","description":