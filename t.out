"]}],"relatedRecords":[],"capabilityRecords":[]},{"name":"GA: Northern Australia AusLAMP Stations","hidden":false,"description":"Australian Lithospheric Architecture Magnetotelluric Project (AusLAMP) Stations.","id":"auslamp","proxyUrl":null,"proxyGetFeatureInfoUrl":null,"proxyCountUrl":null,"proxyStyleUrl":null,"proxyDownloadUrl":null,"mapStyles":null,"feature_count":0,"singleTile":false,"legendImg":null,"previewImg":null,"group":"Magnetotellurics","layerMode":"NA","supportsCsvDownloads":true,"cswRecords":[{"name":"Northern Australia AusLAMP Stations","resourceProvider":"Unknown","id":"3a907defdd7e1ea9dd928fa5061158c753dcf2a3","recordInfoUrl":"https://portal.auscope.org.au/geonetwork/srv/eng/catalog.search#/metadata/3a907defdd7e1ea9dd928fa5061158c753dcf2a3","description":"Point locations of the sites that were used in the northern Australia AusLAMP study.","noCache":false,"service":false,"adminArea":null,"contactOrg":"Geoscience Australia","contactPerson":null,"funderOrg":"Unknown","authors":[],"onlineResources":[{"url":"https://services.ga.gov.au/gis/magnetotellurics/wfs","type":"WFS","name":"mt:nth_aus_AusLAMP_siteloc","description":"Northern Australia AusLAMP Stations","version":"","applicationProfile":"","protocolRequest":""},{"url":"https://services.ga.gov.au/gis/magnetotellurics/ows?SERVICE=WMS&","type":"WMS","name":"mt:nth_aus_AusLAMP_siteloc","description":"Northern Australia AusLAMP Stations","version":"1.1.1","applicationProfile":"","protocolRequest":""}],"geographicElements":[{"type":"bbox","eastBoundLongitude":142.5,"westBoundLongitude":127.0,"northBoundLatitude":-13.5,"southBoundLatitude":-27.5}],"descriptiveKeywords":["Magnetotellurics","Site Locations","Earth Sciences","AusLAMP","World","Northern Australia"],"datasetURIs":[],"constraints":["","https://creativecommons.org/licenses/by/4.0"],"useLimitConstraints":["https://creativecommons.org/licenses/by/4.0"],"accessConstraints":[],"childRecords":[],"date":"2023-08-17T14:00:00 UTC","minScale":null,"maxScale":null,"knownLayerIds":["auslamp"],"knownLayerNames":["GA: Northern Australia AusLAMP Stations"],"knownLayerDescriptions":["Australian Lithospheric Architecture Magnetotelluric Project (AusLAMP) Stations."]},{"name":"Northern Australia AusLAMP Stations","resourceProvider":"Unknown","id":"675ee4e8c40140876911701fa6305111908c258a","recordInfoUrl":"https://portal.auscope.org.au/geonetwork/srv/eng/catalog.search#/metadata/675ee4e8c40140876911701fa6305111908c258a","description":"Point locations of the sites that were used in the northern Australia AusLAMP study.","noCache":false,"service":false,"adminArea":null,"contactOrg":"Geoscience Australia","contactPerson":null,"funderOrg":"Unknown","authors":[],"onlineResources":[{"url":"https://services.ga.gov.au/gis/magnetotellurics/ows?SERVICE=WMS&","type":"WMS","name":"mt:nth_aus_AusLAMP_siteloc","description":"Northern Australia AusLAMP Stations","version":"1.1.1","applicationProfile":"","protocolRequest":""},{"url":"https://services.ga.gov.au/gis/magnetotellurics/wfs","type":"WFS","name":"mt:nth_aus_AusLAMP_siteloc","description":"Northern Australia AusLAMP Stations","version":"","applicationProfile":"","protocolRequest":""}],"geographicElements":[{"type":"bbox","eastBoundLongitude":142.5,"westBoundLongitude":127.0,"northBoundLatitude":-13.5,"southBoundLatitude":-27.5}],"descriptiveKeywords":["Magnetotellurics","Site Locations","Earth Sciences","AusLAMP","World","Northern Australia"],"datasetURIs":[],"constraints":["","https://creativecommons.org/licenses/by/4.0"],"useLimitConstraints":["https://creativecommons.org/licenses/by/4.0"],"accessConstraints":[],"childRecords":[],"date":"2023-08-18T00:00:00 UTC","minScale":null,"maxScale":null,"knownLayerIds":["auslamp"],"knownLayerNames":["GA: Northern Australia AusLAMP Stations"],"knownLayerDescriptions":["Australian Lithospheric Architecture Magnetotelluric Project (AusLAMP) Stations."]}],"relatedRecords":[],"capabilityRecords":[]},{"name":"AuScope MT: W/NW Tas Broadband","hidden":false,"description":"This forms part of the AuScope Magnetotelluric Collection, created by the GeoPhysics 2030 Project, hosted by NCI. Two broadband MT traverses were acquired for shallower investigations of the lithosphere beneath western and north western Tasmania. These surveys transected major crustal boundaries between Precambrian Tyennan basement and the highly metalliferous Cambrian to Devonian Dundas-Fossey Trough.","id":"auscope-mt-collection-1","proxyUrl":null,"proxyGetFeatureInfoUrl":null,"proxyCountUrl":null,"proxyStyleUrl":null,"proxyDownloadUrl":null,"mapStyles":null,"feature_count":0,"singleTile":false,"legendImg":null,"previewImg":null,"group":"Magnetotellurics","layerMode":"NA","cswRecords":[{"name":"Magnetotelluric Broadband Surveys of Western and North-Western Tasmania, 2016","resourceProvider":"Unknown","id":"f7076_0484_4068_7591","recordInfoUrl":"https://geonetwork.nci.org.au/geonetwork/srv/eng/catalog.search#/metadata/f7076_0484_4068_7591","description":"Two broadband MT traverses were acquired for shallower investigations of the lithosphere beneath western and north western Tasmania. These surveys transected major crustal boundaries between Precambrian Tyennan basement and the highly metalliferous Cambrian to Devonian Dundas-Fossey Trough.\r\n\r\nThe MT instruments used for these broadband transects were sourced through the Australian National Seismic Imaging Resource (ANSIR) national Earth sounding instrument pool. Co-funded by AuScope and maintained by the University of Adelaide, the instrumental capability results from a collaboration between the University of Adelaide and Geoscience Australia.\r\n\r\nEach instrument consists of a 24-bit 6-channel PR6-24 Earth Data Logger housed in a reinforced Pelican case. The logger records GPS-synchronised time series electric field data from an array of three Petiau-type lead chloride non-polarisable electrodes. Magnetic field time series data are recorded from LEMI-120 induction coil output when in broadband survey mode. Powered by a 70 amp-hour 12 volt battery, the unit can log broadband data for ∼3 days without a recharge or battery replacement.\r\n\r\nBased out of Queenstown, data acquisition on the eastern end of the western transect commenced on 22nd January 2016. A remote reference site was established 5 km east of the easternmost proposed transect site. Occupation time at each site was in the order of 36-48 hours with crews deploying and retrieving two sites per day. Acquisition of all western transect sites was completed by the 6th of February, at which point field crews rotated staff and relocated to Gowrie Park in northern Tasmania to commence acquisition on the northern transect.\r\n\r\nData acquisition on the northern transect commenced on the 8th of February 2016 starting at the northernmost site near Forth following the establishment of a remote reference site some 4 km south of Beulah and 20 km east of the transect line. Acquisition on the northern transect was hindered by wildlife chewing and severing electrode cables early in deployment at four sites, three requiring a single redeployment and one requiring two re-deployments with progressively deeper burial of cables, electrodes and magnetometers. Acquisition on the northern transect was completed on the 19th of February.","noCache":false,"service":false,"adminArea":null,"contactOrg":"University of Tasmania","contactPerson":"Ostersen, Thomas","funderOrg":"Unknown","authors":["Ostersen, Thomas","Reading, Anya","Duffett, Mark","Graham Heinson","Ostersen, Thomas","Reading, Anya","Duffett, Mark","Graham Heinson","Ostersen, Thomas","Reading, Anya","Duffett, Mark","Graham Heinson","Ostersen, Thomas","Reading, Anya","Duffett, Mark","Graham Heinson"],"onlineResources":[{"url":"https://thredds.nci.org.au/thredds/catalog/catalogs/my80/AuScope_Broadband/States_and_Territories/Tasmania/Northern_and_Western_Tasmania_Broadband_MT_Transect_Surveys_2016/catalog.html","type":"WWW","name":"NCI THREDDS Data Server","description":"","version":"","applicationProfile":"","protocolRequest":""},{"url":"https://doi.org/10.25959/100.00037925","type":"WWW","name":"Ostersen, TCH (2021), 'Geoelectric structure of the Tasmanian lithosphere from multi-scale magnetotelluric data', PhD thesis, University of Tasmania.","description":"","version":"","applicationProfile":"","protocolRequest":""},{"url":"https://www.mrt.tas.gov.au/webdoc2/app/default/document_domrept_detail?id=119226","type":"WWW","name":"Ostersen, T. (2016), 'Tasmanian MT Acquisition Report', Mineral Resources Tasmania.","description":"","version":"","applicationProfile":"","protocolRequest":""},{"url":"https://data.thelist.tas.gov.au/datagn?uuid=337012ef-cf94-4495-965b-8feaab0c02cc","type":"WWW","name":"The LIST (Land Information System Tasmania) Source Record","description":"","version":"","applicationProfile":"","protocolRequest":""}],"geographicElements":[{"type":"bbox","eastBoundLongitude":146.3,"westBoundLongitude":144.9,"northBoundLatitude":-41.1,"southBoundLatitude":-42.2}],"descriptiveKeywords":["Broadband MT, Tasmania, TAS, Magnetotelluric, MT, Time Series",""],"datasetURIs":["10.25914/3erf-dn38"],"constraints":["https://creativecommons.org/licenses/by/3.0/au/","RestrictionCode: license","Creative Commons Attribution 3.0 Australia"],"useLimitConstraints":["Creative Commons Attribution 3.0 Australia","RestrictionCode: license"],"accessConstraints":["RestrictionCode: license"],"childRecords":[],"date":"2023-05-02T00:00:00 UTC","minScale":null,"maxScale":null,"knownLayerIds":["auscope-mt-collection-1"],"knownLayerNames":["AuScope MT: W/NW Tas Broadband"],"knownLayerDescriptions":["This forms part of the AuScope Magnetotelluric Collection, created by the GeoPhysics 2030 Project, hosted by NCI. Two broadband MT traverses were acquired for shallower investigations of the lithosphere beneath western and north western Tasmania. These surveys transected major crustal boundaries between Precambrian Tyennan basement and the highly metalliferous Cambrian to Devonian Dundas-Fossey Trough."]}],"relatedRecords":[],"capabilityRecords":[]},{"name":"AuScope MT: AusLAMP Surveys","hidden":false,"description":"This forms part of the AuScope Magnetotelluric Collection, created by the GeoPhysics 2030 Project, hosted by NCI. Magnetotelluric surveys conducted as part of the Australian Lithospheric Architecture Magnetotelluric Project (AusLAMP)","id":"auscope-mt-collection-3","proxyUrl":null,"proxyGetFeatureInfoUrl":null,"proxyCountUrl":null,"proxyStyleUrl":null,"proxyDownloadUrl":null,"mapStyles":null,"feature_count":0,"singleTile":false,"legendImg":null,"previewImg":null,"group":"Magnetotellurics","layerMode":"NA","cswRecords":[{"name":"Magnetotelluric surveys from the Australian Lithospheric Architecture Magnetotelluric Project (AusLAMP)","resourceProvider":"Unknown","id":"f6307_9112_1484_3827","recordInfoUrl":"https://geonetwork.nci.org.au/geonetwork/srv/eng/catalog.search#/metadata/f6307_9112_1484_3827","description":"Magnetotelluric surveys conducted as part of the Australian Lithospheric Architecture Magnetotelluric Project (AusLAMP)","noCache":false,"service":false,"adminArea":null,"contactOrg":"University of Adelaide","contactPerson":null,"funderOrg":"Unknown","authors":["Graham Heinson","Graham Heinson","Graham Heinson","Graham Heinson"],"onlineResources":[{"url":"https://thredds.nci.org.au/thredds/catalog/catalogs/my80/AuScope_AusLAMP/catalog.html","type":"WWW","name":"NCI THREDDS Data Server","description":"","version":"","applicationProfile":"","protocolRequest":""}],"geographicElements":[{"type":"bbox","eastBoundLongitude":153.57,"westBoundLongitude":113.33,"northBoundLatitude":-10.67,"southBoundLatitude":-43.63}],"descriptiveKeywords":["magnetotellurics, electrical resistivity, time series, long period, impedance, AusLAMP",""],"datasetURIs":["10.25914/5eaa30cc934d0"],"constraints":["https://creativecommons.org/licenses/by/4.0/","RestrictionCode: license","Creative Commons Attribution 4.0 International"],"useLimitConstraints":["Creative Commons Attribution 4.0 International","RestrictionCode: license"],"accessConstraints":["RestrictionCode: license"],"childRecords":[],"date":"2020-04-09T00:00:00 UTC","minScale":null,"maxScale":null,"knownLayerIds":["auscope-mt-collection-3"],"knownLayerNames":["AuScope MT: AusLAMP Surveys"],"knownLayerDescriptions":["This forms part of the AuScope Magnetotelluric Collection, created by the GeoPhysics 2030 Project, hosted by NCI. Magnetotelluric surveys conducted as part of the Australian Lithospheric Architecture Magnetotelluric Project (AusLAMP)"]}],"relatedRecords":[],"capabilityRecords":[]},{"name":"AuScope MT: Uni of Adelaide Legacy","hidden":false,"description":"Magnetotelluric survey data taken from the University of Adelaide Legacy Collection, created by the GeoPhysics 2030 Project, hosted by NCI. The collection contains individual survey grids of MT data derived conducted by The University of Adelaide or associated contractors. The datasets were collected predominantly under various grants/projects including: AuScope, AWAGS, AGOS, ARC LIEF, AusLAMP and NCRIS.","id":"auscope-mt-collection-4","proxyUrl":null,"proxyGetFeatureInfoUrl":null,"proxyCountUrl":null,"proxyStyleUrl":null,"proxyDownloadUrl":null,"mapStyles":null,"feature_count":0,"singleTile":false,"legendImg":null,"previewImg":null,"group":"Magnetotellurics","layerMode":"NA","cswRecords":[{"name":"Magnetotelluric surveys in Victoria","resourceProvider":"Unknown","id":"f1746_7402_6625_3811","recordInfoUrl":"https://geonetwork.nci.org.au/geonetwork/srv/eng/catalog.search#/metadata/f1746_7402_6625_3811","description":"Magnetotelluric surveys conducted in Victoria","noCache":false,"service":false,"adminArea":null,"contactOrg":"University of Adelaide","contactPerson":null,"funderOrg":"Unknown","authors":["Graham Heinson","Graham Heinson","Graham Heinson","Graham Heinson"],"onlineResources":[{"url":"https://thredds.nci.org.au/thredds/catalog/my80/AuScope_MT_collection/The_University_of_Adelaide_Legacy_MT_collection/States_and_Territories/Vic/catalog.html","type":"WWW","name":"NCI THREDDS Data Server","description":"","version":"","applicationProfile":"","protocolRequest":""}],"geographicElements":[{"type":"bbox","eastBoundLongitude":149.98,"westBoundLongitude":140.95,"northBoundLatitude":-34.0,"southBoundLatitude":-39.15}],"descriptiveKeywords":["magnetotellurics, electrical resistivity, impedance, long period, Victoria",""],"datasetURIs":["10.4225/41/5a7a2c8449efc"],"constraints":["https://creativecommons.org/licenses/by/4.0/","RestrictionCode: license","Creative Commons Attribution 4.0 International"],"useLimitConstraints":["Creative Commons Attribution 4.0 International","RestrictionCode: license"],"accessConstraints":["RestrictionCode: license"],"childRecords":[],"date":"2019-07-19T00:00:00 UTC","minScale":null,"maxScale":null,"knownLayerIds":["auscope-mt-collection-4"],"knownLayerNames":["AuScope MT: Uni of Adelaide Legacy"],"knownLayerDescriptions":["Magnetotelluric survey data taken from the University of Adelaide Legacy Collection, created by the GeoPhysics 2030 Project, hosted by NCI. The collection contains individual survey grids of MT data derived conducted by The University of Adelaide or associated contractors. The datasets were collected predominantly under various grants/projects including: AuScope, AWAGS, AGOS, ARC LIEF, AusLAMP and NCRIS."]},{"name":"Magnetotelluric surveys in Tasmania","resourceProvider":"Unknown","id":"f4430_5784_1652_3308","recordInfoUrl":"https://geonetwork.nci.org.au/geonetwork/srv/eng/catalog.search#/metadata/f4430_5784_1652_3308","description":"Magnetotelluric surveys conducted in Tasmania","noCache":false,"service":false,"adminArea":null,"contactOrg":"University of Adelaide","contactPerson":null,"funderOrg":"Unknown","authors":["Graham Heinson","Graham Heinson","Graham Heinson","Graham Heinson"],"onlineResources":[{"url":"https://thredds.nci.org.au/thredds/catalog/my8