icElements":[{"type":"bbox","eastBoundLongitude":180.0,"westBoundLongitude":-180.0,"northBoundLatitude":90.0,"southBoundLatitude":-90.0}],"descriptiveKeywords":["features","Earth Sciences","EarthBank","samples_gc","Geochemistry","GC","World","Lithodat"],"datasetURIs":[],"constraints":["","https://creativecommons.org/licenses/by/4.0"],"useLimitConstraints":["https://creativecommons.org/licenses/by/4.0"],"accessConstraints":[],"childRecords":[],"date":"2023-08-18T00:00:00 UTC","minScale":null,"maxScale":null,"knownLayerIds":["earthbank-gc"],"knownLayerNames":["EarthBank Geochemistry"],"knownLayerDescriptions":["Locations of samples which have undergone geochemistry analysis. Samples were taken by members of the AuScope Geochemistry Network (AGN) https://www.auscope.org.au/agn. The sample data can be accessed from EarthBank portal https://ausgeochem.auscope.org.au/#/ which is hosted by Lithodat Pty Ltd. Projects were funded by AuScope Pty Ltd. https://ror.org/04s1m4564"]}],"relatedRecords":[],"capabilityRecords":[]},{"name":"Map of Indigenous Australia","hidden":false,"description":"Native Land Digital strives to create and foster conversations about the history of colonialism, Indigenous ways of knowing, and settler-Indigenous relations, through educational resources such as our map and Territory Acknowledgement Guide. We strive to go beyond old ways of talking about Indigenous people and to develop a platform where Indigenous communities can represent themselves and their histories on their own terms. In doing so, Native Land Digital creates spaces where non-Indigenous people can be invited and challenged to learn more about the lands they inhabit, the history of those lands, and how to actively be part of a better future going forward together. This map does not represent or intend to represent official or legal boundaries of any Indigenous nations. It is not suitable for native title or any land claim.","id":"indigenous-nativeland","proxyUrl":null,"proxyGetFeatureInfoUrl":null,"proxyCountUrl":null,"proxyStyleUrl":null,"proxyDownloadUrl":null,"mapStyles":null,"feature_count":0,"singleTile":false,"legendImg":null,"previewImg":null,"group":"Indigenous Data","geojson":{"endPoint":"https://native-land.ca/api/index.php","polygon":[[146.26,-10.53],[132.45,-8.23],[111.64,-17.61],[110.29,-34.29],[147.95,-45.25],[159.37,-24.57],[146.26,-10.53]]},"layerMode":"NA","apikey":"_7AyXpOSiefzoaCbUaPOM","maps":"territories","cswRecords":[{"name":"Native Land Digital Map Of Indigenous Australia","resourceProvider":"Unknown","id":"ec3f88de-5538-48b4-8cfc-8b1b0ae5effe","recordInfoUrl":"https://portal.auscope.org.au/geonetwork/srv/eng/catalog.search#/metadata/ec3f88de-5538-48b4-8cfc-8b1b0ae5effe","description":"Native Land Digital strives to create and foster conversations about the history of colonialism, Indigenous ways of knowing, and settler-Indigenous relations, through educational resources such as our map and Territory Acknowledgement Guide. We strive to go beyond old ways of talking about Indigenous people and to develop a platform where Indigenous communities can represent themselves and their histories on their own terms. In doing so, Native Land Digital creates spaces where non-Indigenous people can be invited and challenged to learn more about the lands they inhabit, the history of those lands, and how to actively be part of a better future going forward together.\n\nThis map does not represent or intend to represent official or legal boundaries of any Indigenous nations. It is not suitable for native title or any land claim.","noCache":false,"service":false,"adminArea":null,"contactOrg":"Native Land Digital","contactPerson":null,"funderOrg":"Unknown","authors":[],"onlineResources":[{"url":"https://native-land.ca/wp-json/nativeland/v1/api/index.php","type":"VMF","name":"Indigenous Map","description":"Indigenous Land Map as a GeoJson file","version":"","applicationProfile":"","protocolRequest":""},{"url":"https://aiatsis.gov.au/explore/map-indigenous-australia","type":"WWW","name":"A map of the resource","description":"This map attempts to represent the language, social or nation groups of Aboriginal Australia. It shows only the general locations of larger groupings of people which may include clans, dialects or individual languages in a group. It used published resources from the eighteenth century-1994 and is not intended to be exact, nor the boundaries fixed. It is not suitable for native title or other land claims. David R Horton (creator), © AIATSIS, 1996. No reproduction without permission.","version":"","applicationProfile":"","protocolRequest":""}],"geographicElements":[{"type":"bbox","eastBoundLongitude":156.0,"westBoundLongitude":112.0,"northBoundLatitude":-10.0,"southBoundLatitude":-45.0}],"descriptiveKeywords":["indigenous"],"datasetURIs":[],"constraints":["https://creativecommons.org/publicdomain/zero/1.0/"],"useLimitConstraints":["https://creativecommons.org/publicdomain/zero/1.0/"],"accessConstraints":[],"childRecords":[],"date":"2025-06-19T00:00:00 UTC","minScale":null,"maxScale":null,"knownLayerIds":["indigenous-nativeland"],"knownLayerNames":["Map of Indigenous Australia"],"knownLayerDescriptions":["Native Land Digital strives to create and foster conversations about the history of colonialism, Indigenous ways of knowing, and settler-Indigenous relations, through educational resources such as our map and Territory Acknowledgement Guide. We strive to go beyond old ways of talking about Indigenous people and to develop a platform where Indigenous communities can represent themselves and their histories on their own terms. In doing so, Native Land Digital creates spaces where non-Indigenous people can be invited and challenged to learn more about the lands they inhabit, the history of those lands, and how to actively be part of a better future going forward together. This map does not represent or intend to represent official or legal boundaries of any Indigenous nations. It is not suitable for native title or any land claim."]}],"relatedRecords":[],"capabilityRecords":[]},{"name":"Depth of Regolith - Soil and Landscape Grid National Soil Attribute Maps","hidden":false,"description":"This is Version 2 of the Depth of Regolith product of the Soil and Landscape Grid of Australia (produced 2015-06-01).","id":"regolith-depth-layer","proxyUrl":null,"proxyGetFeatureInfoUrl":null,"proxyCountUrl":null,"proxyStyleUrl":null,"proxyDownloadUrl":null,"mapStyles":null,"feature_count":0,"singleTile":false,"legendImg":null,"previewImg":null,"group":"Regolith","layerMode":"NA","cswRecords":[{"name":"Depth of Regolith - Soil and Landscape Grid National Soil Attribute Maps","resourceProvider":"Unknown","id":"d64175ed-628a-496f-a86b-25b04e8cf24c","recordInfoUrl":"https://portal.auscope.org.au/geonetwork/srv/eng/catalog.search#/metadata/d64175ed-628a-496f-a86b-25b04e8cf24c","description":"The Soil and Landscape Grid of Australia is a comprehensive fine spatial resolution grid of functional soil attributes and key landscape features across Australia. The landscape attributes are derived from the data collected by the Shuttle Radar Topography Mission, whilst the soil attribute surfaces are modelled from existing soils information. These surfaces provide a consistent base upon which a broad range of analyses can be conducted. This provides essential information, not previously available, that is needed for modelling and managing Australian landscapes and ecosystems.","noCache":false,"service":false,"adminArea":null,"contactOrg":"Unknown","contactPerson":null,"funderOrg":"Unknown","authors":[],"onlineResources":[{"url":"https://www.asris.csiro.au/arcgis//services/TERN/DER_ACLEP_AU_NAT_C/MapServer/WMSServer?","type":"WMS","name":"DER_000_999_EV_N_P_AU_NAT_C","description":"DER_000_999_EV_N_P_AU_NAT_C","version":"1.1.1","applicationProfile":"","protocolRequest":""},{"url":"https://www.asris.csiro.au/arcgis//services/TERN/DER_ACLEP_AU_NAT_C/MapServer/WMSServer?","type":"W