ription":"NCI NetCDF Subset Service - mainland Australia","version":"","applicationProfile":"","protocolRequest":""},{"url":"https://thredds.nci.org.au/thredds/ncss/grid/wx7/aster/vnir/Tasmania/Tas_AlOH_Group_content_reprojected.nc4/dataset.html","type":"WWW","name":"AlOH_group_content","description":"NCI NetCDF Subset Service - Tasmania","version":"","applicationProfile":"","protocolRequest":""},{"url":"https://thredds.nci.org.au/thredds/fileServer/wx7/aster/vnir/Aus_Mainland/Aus_Mainland_AlOH_group_content_reprojected.nc4","type":"WWW","name":"AlOH_group_content","description":"NCI NetCDF file download via HTTP - mainland Australia","version":"","applicationProfile":"","protocolRequest":""},{"url":"https://thredds.nci.org.au/thredds/fileServer/wx7/aster/vnir/Tasmania/Tas_AlOH_Group_content_reprojected.nc4","type":"WWW","name":"AlOH_group_content","description":"NCI NetCDF file download via HTTP - Tasmania","version":"","applicationProfile":"","protocolRequest":""},{"url":"https://doi.org/10.4225/08/51400D6F7B335","type":"WWW","name":"CSIRO Data Access Portal Record","description":"","version":"","applicationProfile":"","protocolRequest":""}],"geographicElements":[{"type":"bbox","eastBoundLongitude":155.0,"westBoundLongitude":111.5,"northBoundLatitude":-9.0,"southBoundLatitude":-44.5}],"descriptiveKeywords":["Earth Sciences",""],"datasetURIs":["10.25914/5f224f2e1180e"],"constraints":["https://creativecommons.org/licenses/by/4.0/","RestrictionCode: restricted","Creative Commons Attribution 4.0 International","RestrictionCode: license"],"useLimitConstraints":["Creative Commons Attribution 4.0 International","RestrictionCode: license"],"accessConstraints":["RestrictionCode: restricted"],"childRecords":[],"date":"2018-04-11T00:00:00 UTC","minScale":null,"maxScale":null,"knownLayerIds":["aster-aloh-group-content"],"knownLayerNames":["AlOH group content"],"knownLayerDescriptions":["1. Band ratio: (B5+B7)/B6Blue is low abundance, Red is high abundance potentially includes