e,"legendImg":null,"previewImg":"https://drdzuf3dxzz1h.cloudfront.net/preview/GSV_Geological_Unit_(50k)_Age.png","group":"Geological Maps","layerMode":"NA","cswRecords":[{"name":"GSV Geological Unit (50K) - Age","resourceProvider":"Unknown","id":"489fd5e45c254cab46714473538a141b94f46a44","recordInfoUrl":"https://portal.auscope.org.au/geonetwork/srv/eng/catalog.search#/metadata/489fd5e45c254cab46714473538a141b94f46a44","description":"Geological units represented as two dimensional polygons, designed for portrayal at 1:50 000 scale. The polygon edges are constructed from the corresponding geological contacts and faults layer. Theme based on the 2008 version of the IUGS International stratigraphic chart (International Commission on Stratigraphy : http://www.stratigraphy.org/).","noCache":false,"service":false,"adminArea":null,"contactOrg":"Geological Survey of Victoria - Resources Victoria","contactPerson":"Cameron Cairns","funderOrg":"Unknown","authors":[],"onlineResources":[{"url":"https://gsv.vic.gov.au/web-mapping_vsdl/ows?SERVICE=WMS&","type":"WMS","name":"gsv:GSV_SG_50K_GEOLUNIT_AGE","description":"GSV Geological Unit (50K) - Age","version":"1.1.1","applicationProfile":"","protocolRequest":""},{"url":"https://gsv.vic.gov.au/web-mapping_vsdl/wfs","type":"WFS","name":"gsv:GSV_SG_50K_GEOLUNIT_AGE","description":"GSV Geological Unit (50K) - Age","version":"","applicationProfile":"","protocolRequest":""}],"geographicElements":[{"type":"bbox","eastBoundLongitude":149.50125122070312,"westBoundLongitude":140.97091674804688,"northBoundLatitude":-35.92854312580955,"southBoundLatitude":-38.85769657131002}],"descriptiveKeywords":["features","sg_geological_unit_50k","Earth Sciences","World"],"datasetURIs":[],"constraints":["","https://creativecommons.org/licenses/by/4.0"],"useLimitConstraints":["https://creativecommons.org/licenses/by/4.0"],"accessConstraints":[],"childRecords":[],"date":"2023-08-18T00:00:00 UTC","minScale":null,"maxScale":null,"knownLayerIds":["gsv-geological-unit-50k-age"],"knownLayerNames":["Vic Geological Unit 50K Age"],"knownLayerDescriptions":["Geological units represented as two dimensional polygons, designed for portrayal at 1:50 000 scale."]}],"relatedRecords":[],"capabilityRecords":[]},{"name":"L180 Mt Isa Deep Crustal Seismic Survey Qld 2006 Stacked And Migrated Data And Images For Lines 06Ga M1 To 06Ga M6","hidden":false,"description":"Processed seismic data SEG-Y format) and TIFF images for the 2006 Mt Isa Deep C","id":"l180-mt-isa-deep-crus-seis-surv-qld-2006-stac-and-migr-data-and-imag-for-line-06ga-to-06ga","proxyUrl":null,"proxyGetFeatureInfoUrl":null,"proxyCountUrl":null,"proxyStyleUrl":null,"proxyDownloadUrl":null,"mapStyles":null,"feature_count":0,"singleTile":false,"legendImg":null,"previewImg":null,"group":"Reports - Geoscience Australia","layerMode":"NA","cswRecords":[{"name":"L180 Mt Isa Deep Crustal Seismic Survey, QLD, 2006. Stacked and migrated data and images for lines 06GA-M1 to 06GA-M6","resourceProvider":"Unknown","id":"a05f7892-ee53-7506-e044-00144fdd4fa6","recordInfoUrl":"https://ecat.ga.gov.au/geonetwork/srv/eng/catalog.search#/metadata/a05f7892-ee53-7506-e044-00144fdd4fa6","description":"Processed seismic data (SEG-Y format) and TIFF images for the 2006 Mt Isa Deep Crustal Seismic Survey (L180), acquired by Geoscience Australia (GA) under the Onshore Energy Security Program (OESP), in collaboration with the Queensland Geological Survey, the pmd*CRC and Zinifex Ltd. Stack and migrated data for lines 06GA-M1 to 06GA-M6 as well as CDP coordinates and maps.\n\nRaw data for this survey are available on request from clientservices@ga.gov.au","noCache":false,"service":false,"adminArea":"ACT","contactOrg":"Commonwealth of Australia (Geoscience Australia)","contactPerson":null,"funderOrg":"Unknown","authors":["Maher, J.L."],"onlineResources":[{"url":"https://d28rz98at9flks.cloudfront.net/69674/L180_Processed_Seismic_Package_2.zip","type":"WWW","name":"Processed Seismic Package","description":"Processed Seismic Package","version":"","applicationProfile":"","protocolRequest":""}],"geographicElements":[{"type":"bbox","eastBoundLongitude":141.5,"westBoundLongitude":138.0,"northBoundLatitude":-18.0,"southBoundLatitude":-22.5}],"descriptiveKeywords":["Seismology and Seismic Exploration","HVC_144637","Seismic Data seismic survey","seismic sections","mineral exploration","geophysics","AU-QLD","Published_External"],"datasetURIs":[],"constraints":["Creative Commons Attribution 4.0 International Licence","RestrictionCode: license"],"useLimitConstraints":["RestrictionCode: license"],"accessConstraints":["RestrictionCode: license"],"childRecords":[],"date":"2018-04-20T00:00:00 UTC","minScale":null,"maxScale":null,"knownLayerIds":["l180-mt-isa-deep-crus-seis-surv-qld-2006-stac-and-migr-data-and-imag-for-line-06ga-to-06ga"],"knownLayerNames":["L180 Mt Isa Deep Crustal Seismic Survey Qld 2006 Stacked And Migrated Data And Images For Lines 06Ga M1 To 06Ga M6"],"knownLayerDescriptions":["Processed seismic data SEG-Y format) and TIFF images for the 2006 Mt Isa Deep C"]}],"relatedRecords":[],"capabilityRecords":[]},{"name":"Are There Any Sandstone Hosted Uranium Systems In The Eromanga Basin","hidden":false,"description":"As part of Geoscience Australia's Onshore Energy Security Program the authors ha","id":"are-ther-any-sand-uran-syst-in-the-erom-basi","proxyUrl":null,"proxyGetFeatureInfoUrl":null,"proxyCountUrl":null,"proxyStyleUrl":null,"proxyDownloadUrl":null,"mapStyles":null,"feature_count":0,"singleTile":false,"legendImg":null,"previewImg":null,"group":"Reports - Geoscience Australia","layerMode":"NA","cswRecords":[{"name":"Are there any sandstone-hosted uranium systems in the Eromanga Basin?","resourceProvider":"Unknown","id":"a05f7892-f9c4-7506-e044-00144fdd4fa6","recordInfoUrl":"https://ecat.ga.gov.au/geonetwork/srv/eng/catalog.search#/metadata/a05f7892-f9c4-7506-e044-00144fdd4fa6","description":"As part of Geoscience Australia's Onshore Energy Security Program the authors have investigated whether there is any evidence that a sandstone hosted uranium system has operated in the Eromanga Basin and assessed the basin's potential to host significant uranium mineralisation.\n\nThe Eromanga Basin is a Mesozoic, intracratonic, sag basin that covers ~1,000,000 km2 of central-eastern Australia and it onlaps several surrounding Proterozoic provinces that have elevated uranium contents. The Eromanga Basin has been subdivided into three major stratigraphic sequences: a lower non-marine sequence, a middle marine sequence and an upper non-marine sequence. Each sequence is characterised by basal sands that fine upwards into shales and silts, suggesting a gradual change from high- to low-energy sedimentary environments. The overall structural trend of the basin is oriented north-east, with a series of north-east striking troughs and ridges that locally controlled sediment deposition. Subsequent folding has produced broad, regional domes.\n\nTo assess the uranium potential in the Eromanga Basin, the pmd*CRC five-questions framework was adopted. This framework attempts to understand the whole mineralising system by addressing (1) the geodynamic and pressure temperature histories; (2) the architecture of the system; (3) the fluid reservoirs; (4) the fluid flow drivers and pathways; and (5) the metal transport and deposition mechanisms. To answer these five questions, the following studies were made:\n\n - a literature review of the geodynamic setting for the Eromanga Basin and that of existing sandstone hosted uranium provinces. Data have been summarised in a series of space time plots\n - construction of a 3D map from publicly available datasets to better understand the basin architecture and fluid flow pathways\n - compilation of water chemistry to map potential fluid reservoirs and transport mechanisms\n - whole rock and multi element geochemistry together with detailed petrology, to understand uranium deposition mechanisms.\n\nA review of the geodynamic setting suggests that there are potentially three discrete mineralising events in the western portion the Eromanga Basin, which correspond to periods of known uplift and erosion. In the east there is potential for a single, long period, uranium mineralising event associated with the uplift of the Eastern Highlands. The 3D map of basin architecture shows that there are large, permeable sandstone packages that are bounded above and below by impermeable shales and that the sandstones are also exposed at the surface along the margins of the basin. This juxtaposition of lithologies is the most favourable architecture and fluid pathway for the formation of sandstone hosted uranium deposits, because fluids can enter the sandstone through outcropping aquifers and be contained above and below by aquitards. Groundwater hydrochemistry datasets show regional redox and pH fronts along the margins of the Eromanga Basin related to the movement of oxidised, acidic meteoric waters through porous sandstone layers. Uranium is commonly precipitated at redox gradients, particularly in areas close to a uranium source (i.e. sandstones with elevated background concentrations of uranium and/or uranium rich Proterozoic rocks exposed at the surface as in the case of Mt Isa and Mt Painter Inliers).","noCache":false,"service":false,"adminArea":"ACT","contactOrg":"Commonwealth of Australia (Geoscience Australia)","contactPerson":null,"funderOrg":"Unknown","authors":["van der Wielen, S.E.","Britt, A.","Kirkby, A.L.","Skirrow, R.G.","Schofield, A."],"onlineResources":[{"url":"https://d28rz98at9flks.cloudfront.net/71019/71019.pdf","type":"WWW","name":"Download the file (pdf)","description":"Download the file (pdf)","version":"","applicationProfile":"","protocolRequest":""}],"geographicElements":[{"type":"bbox","eastBoundLongitude":148.0,"westBoundLongitude":131.5,"northBoundLatitude":-18.5,"southBoundLatitude":-31.5}],"descriptiveKeywords":["PowerPoint","3D model","prospectivity","geoscience","AU-NSW","AU-QLD","AU-SA","Earth Sciences","Published_External"],"datasetURIs":[],"constraints":["Creative Commons Attribution 4.0 International Licence"],"useLimitConstraints":[],"accessConstraints":[],"childRecords":[],"date":"2018-04-20T00:00:00 UTC","minScale":null,"maxScale":null,"knownLayerIds":["are-ther-any-sand-uran-syst-in-the-erom-basi"],"knownLayerNames":["Are There Any Sandstone Hosted Uranium Systems In The Eromanga Basin"],"knownLayerDescriptions":["As part of Geoscience Australia's Onshore Energy Security Program the authors ha"]}],"relatedRecords":[],"capabilityRecords":[]},{"name":"L164 Curnamona Seismic Survey Sa 2003 2004 Stacked And Migrated Seismic Data And Images For Lines 03Ga Cu1","hidden":false,"description":"A seismic survey using the Australian National Seismic Imaging Resource ANSIR)","id":"l164-curn-seis-surv-sa-2003-2004-stac-and-migr-seis-data-and-imag-for-line-03ga","proxyUrl":null,"proxyGetFeatureInfoUrl":null,"proxyCountUrl":null,"proxyStyleUrl":null,"proxyDownloadUrl":null,"mapStyles":null,"feature_count":0,"singleTile":false,"legendImg":null,"previewImg":null,"group":"Reports - Geoscience Australia","layerMode":"NA","cswRecords":[{"name":"L164 Curnamona Seismic Survey, SA, 2003 & 2004 Stacked and migrated seismic data and images for lines 03GA-CU1","resourceProvider":"Unknown","id":"cd697530-5b75-3811-e044-00144fdd4fa6","recordInfoUrl":"https://ecat.ga.gov.au/geonetwork/srv/eng/catalog.search#/metadata/cd697530-5b75-3811-e044-00144fdd4fa6","description":"A seismic survey using the Australian National Seismic Imaging Resource (ANSIR) Hemi 60 Vibroseis vehicles, ARAM24 acquisition equipment and Pelton controllers was carried out in the Curnamona Province of South Australia. A total of 197.6 km of 2-D seismic reflection data were collected to 18 seconds two way time over a single line at a nominal 60 fold CDP coverage. These data were acquired under contract by Trace Energy Services (2003) and by Terrex Seismic (2004). The survey commenced in August 2003 but was abandoned due to wet weather. Survey operations were recommenced and completed in July 2004.\n\nThe project was undertaken to meet the objectives of ANSIR proposal 03-02R as lodged by researchers from PIRSA, Office of Minerals, Energy and Petroleum, SA. The principal scientific objective of this survey was to provide a regional crustal seismic image of the Curnamona Province. This dataset will assist in the understanding of the geological architecture and resource potential of the region particularly in areas under cover.\nThis line links with a seismic transect in the Broken Hill Block undertaken by Australian Geological Survey Organisation (AGSO, now Geoscience Australia) in 1996 and provides a future opportunity for an eventual east-west continuation across the Adelaide Geosyncline and the Gawler Craton. The survey was funded by PIRSA, Office of Minerals, Energy and Petroleum, SA and the pmd*CRC with project supervision undertaken by ANSIR and in-kind support from Geoscience Australia (GA).","noCache":false,"service":false,"adminArea":"ACT","contactOrg":"Commonwealth of Australia (Geoscience Australia)","contactPerson":null,"funderOrg":"Unknown","authors":["Goleby, B.R.","Korsch, R.J."],"onlineResources":[{"url":"https://d28rz98at9flks.cloudfront.net/74868/L164_Processed_Seismic_Package.zip","type":"WWW","name":"Processed Seismic Package [476.9 MB]","description":"Processed Seismic Package [476.9 MB]","version":"","applicationProfile":"","protocolRequest":""},{"url":"https://d28rz98at9flks.cloudfront.net/74868/L164_Raw_Seismic_Package.zip","type":"WWW","name":"Raw Seismic Package [19.6 GB]","description":"Raw Seismic Package [19.6 GB]","version":"","applicationProfile":"","protocolRequest":""}],"geographicElements":[{"type":"bbox","eastBoundLongitude":141.0,"westBoundLongitude":139.0,"northBoundLatitude":-31.7,"southBoundLatitude":-31.8}],"descriptiveKeywords":["Seismology and Seismic Exploration","HVC_144637","Seismic Data seismic survey","seismic reflection","seismic sections","geophysics","AU-SA","Published_External"],"datasetURIs":[],"constraints":["Creative Commons Attribution 4.0 International Licence","© Commonwealth of Australia (Geoscience Australia) 2024"],"useLimitConstraints":[],"accessConstraints":[],"childRecords":[],"date":"2018-04-22T00:00:00 UTC","minScale":null,"maxScale":null,"knownLayerIds":["l164-curn-seis-surv-sa-2003-2004-stac-and-migr-seis-data-and-imag-for-line-03ga"],"knownLayerNames":["L164 Curnamona Seismic Survey Sa 2003 2004 Stacked And Migrated Seismic Data And Images For Lines 03Ga Cu1"],"knownLayerDescriptions":["A seismic survey using the Australian National Seismic Imaging Resource ANSIR)"]}],"relatedRecords":[],"capabilityRecords":[]},{"name":"Lawn Hill Platform And Leichhardt River Fault Trough Measured Stratigraphic Section Online Gis","hidden":false,"description":"This GIS web browser contains stratigraphic information from the southern flank","id":"lawn-hill-plat-and-leic-rive-faul-trou-meas-stra-sect-onli-gis","proxyUrl":null,"proxyGetFeatureInfoUrl":null,"proxyCountUrl":null,"proxyStyleUrl":null,"proxyDownloadUrl":null,"mapStyles":null,"feature_count":0,"singleTile":false,"legendImg":null,"previewImg":null,"group":"Reports - Geoscience Australia","layerMode":"NA","cswRecords":[{"name":"Lawn Hill Platform and Leichhardt River Fault Trough measured stratigraphic section online GIS","resourceProvider":"Unknown","id":"a05f7892-b7a0-7506-e044-00144fdd4fa6","recordInfoUrl":"https://ecat.ga.gov.au/geonetwork/srv/eng/catalog.search#/metadata/a05f7892-b7a0-7506-e044-00144fdd4fa6","description":"This GIS web browser contains stratigraphic information from the southern flank of the Murphy Inlier, Lawn Hill Platform and Leichhardt River Fault Trough in the Western Succession of the Mount Isa Block. The principal lithostratigraphic units covered by this dataset include the Surprise Creek Formation, Mount Isa and McNamara Groups. The images are pixilated versions of those contained on CD Records AGSO Record 1999/10, AGSO Record 1999/15, GA Record 2002/3. The data contained on the CD's is more comprehensive, at a better resolution and also contains cross sections that are not available over the web. No drill hole data is supplied in this viewer. The data compiled for this viewer was collected during the course of the NABRE, AMIRA P552 and pmd*CRC projects. The respective CD's also provide measured sections at different scales with slightly varying information available at 1:400, 1:1000, 1:2500 and 1:5000 scales. The information at each scale is slightly different. Plot files ready for printing also accompany the measured sections. \nEach of the measured sections contains primary observational data (grainsize, lithology, bed thickness, sedimentary structure and gamma ray curve) map-based lithostratigraphic units as shown on the 1:100,000 geological sheets, interpreted facies and sequence stratigraphic surfaces. \nSections were measured using a Jacobs Staff and Abney Level and the rocks were marked in 1.5 m intervals of true thickness. Gamma ray data was collected at either 50 cm or 75 cm intervals of true thickness using hand-held Scintrex GRS 500 spectrometers that measured total gamma ray counts. A beryllium standard was used to calibrate each spectrometer. Each machine was calibrated at intervals of two to three hours. Each gamma reading was averaged over an interval of ten seconds. \nOutcrop discontinuities prevented the collection of stratigraphic data in a line of continuous section. As a result most of the sections present in this data set comprise a series of segments combined to form a single composite section. The single sections were all measured within a radius of several kilometres of each other. Individual sections were spliced together at prominent marker beds (outcrop tracing of strata), or by the use of overlapping gamma ray curves in conjunction with facies descriptions. Section locations shown in the web browser depict the base of each composite section. Grid coordinates for the base each composite section can be found in the header block of the appropriate section. \nThe geological maps used in this web browser depict the approximate position of supersequence boundaries. Not all the geology for the region has been included and only the geology relevant to the measured sections has been used. The supersequences provided are based on the most appropriate lithostratigraphic boundaries and no new geological polygons have been created. It should be noted that the Torpedo Creek and Warrina Park Quartzites have been placed in the Prize Supersequence. However, we acknowledge that due to mis-mapping of these sand bodies the Torpedo Creek and Warrina Park Quartzites from the basal part of the Gun Supersequence at some locations.","noCache":false,"service":false,"adminArea":"ACT","contactOrg":"Commonwealth of Australia (Geoscience Australia)","contactPerson":null,"funderOrg":"Unknown","authors":["Lech, M.E."],"onlineResources":[{"url":"https://www.ga.gov.au/about/projects/resources/fluid-flow-modelling","type":"Unsupported","name":"Link to Related Product","description":"Fluid Flow Modelling in the Mt Isa and McArthur Basins Project","version":"","applicationProfile":"","protocolRequest":""},{"url":"https://d28rz98at9flks.cloudfront.net/42496/Mount_Isa_Online_GIS_PDF_Catalogue.zip","type":"Unsupported","name":"Download the data (misc) [77.5 MB]","description":"Download the data (misc) [77.5 MB]","version":"","applicationProfile":"","protocolRequest":""}],"geographicElements":[{"type":"bbox","eastBoundLongitude":141.0,"westBoundLongitude":136.3,"northBoundLatitude":-17.3,"southBoundLatitude":-22.3}],"descriptiveKeywords":["GIS Dataset","Regional","geology","stratigraphy","GIS","AU-SA","Earth Sciences","Published_External"],"datasetURIs":[],"constraints":["Creative Commons Attribution 4.0 International Licence","© Commonwealth of Australia (Geoscience Australia) 2003"],"useLimitConstraints":[],"accessConstraints":[],"childRecords":[],"date":"2025-12-07T00:00:00 UTC","minScale":null,"maxScale":null,"knownLayerIds":["lawn-hill-plat-and-leic-rive-faul-trou-meas-stra-sect-onli-gis"],"knownLayerNames":["Lawn Hill Platform And Leichhardt River Fault Trough Measured Stratigraphic Section Online Gis"],"knownLayerDescriptions":["This GIS web browser contains stratigraphic information from the southern flank"]}],"relatedRecords":[],"capabilityRecords":[]},{"name":"Predictive Mineral Discovery In The Eastern Yilgarn Craton An Example Of District Scale Targeting Of An Orogenic Gold Mineral System","hidden":false,"description":"Predictive mineral discovery is concerned with the application of a whole of sys","id":"pred-mine-disc-in-the-east-yilg-crat-an-exam-of-dist-targ-of-an-orog-gold-mine-syst","proxyUrl":null,"proxyGetFeatureInfoUrl":null,"proxyCountUrl":null,"proxyStyleUrl":null,"proxyDownloadUrl":null,"mapStyles":null,"feature_count":0,"singleTile":false,"legendImg":null,"previewImg":null,"group":"Reports - Geoscience Australia","layerMode":"NA","cswRecords":[{"name":"Predictive mineral discovery in the eastern Yilgarn Craton: an example of district-scale targeting of an orogenic gold mineral system","resourceProvider":"Unknown","id":"a05f7892-eafd-7506-e044-00144fdd4fa6","recordInfoUrl":"https://ecat.ga.gov.au/geonetwork/srv/eng/catalog.search#/metadata/a05f7892-eafd-7506-e044-00144fdd4fa6","description":"Predictive mineral discovery is concerned with the application of a whole of system process understanding to mineral exploration as opposed to an empirical deposit type approach. A mineral system process understanding can be derived from a consideration of five key questions, namely what is/are the: 1) geodynamic setting; 2) architecture; 3) sources and reservoirs; 4) drivers and pathways, and; 5) depositional mechanisms. The answers to these questions result in the identification of critical processes necessary for the function of a mineral system within a particular terrane, and permit the development of a targeting model. In this contribution we identify district scale critical orogenic gold mineral system processes for the late Archaean eastern Yilgarn Craton of Western Australia. During the geodynamic history of a terrane the critical processes which result in mineralisation change with time resulting in variations in mineralisation style. Proxies for critical processes have been mapped in an integrated GIS and are termed mappable mineral system process proxies (or MMSPP). In recognition of this, three separate time slices and a geochemical theme were analysed. Each MMSPP is given a weighting factor (WF) which reflects the spatial accuracy/coverage of the data and process criticality. For each theme/time-slice, a separate prospectivity map was created by summing the overlay or union of the spatial extent of each MMSPP, and adding the WF. A final target or prospectivity map was generated by a union of the four theme/time-slice prospectivity maps, and is tested against the known major deposits. The map 'discovered' the main gold camps and accounts for over 75% of the known gold in 5% of the area. This test verifies the process-based understanding and the appropriate mapping of the critical proxies. A further outcome from the map was the identification of a number of new target areas not known for significant gold mineralisation in what otherwise is thought to represent a mature terrane for gold exploration. The approach taken here has been to consider the Late Archaean gold deposits as a holistic system. Despite the recurring areas of uncertainty, this systems view has resulted in new findings that have generic applications to other mineral systems.","noCache":false,"service":false,"adminArea":"ACT","contactOrg":"Commonwealth of Australia (Geoscience Australia)","contactPerson":null,"funderOrg":"Unknown","authors":["Czarnota, K.","Blewett, R.S.","Goscombe, B."],"onlineResources":[{"url":"http://dx.doi.org/10.1016/j.precamres.2010.08.014","type":"WWW","name":"Link to Publication","description":"Link to Publication","version":"","applicationProfile":"","protocolRequest":""}],"geographicElements":[{"type":"bbox","eastBoundLongitude":126.0,"westBoundLongitude":120.0,"northBoundLatitude":-26.0,"southBoundLatitude":-34.0}],"descriptiveKeywords":["External Publication","mineral exploration","pmd*CRC","AU-WA","Earth Sciences","Published_External"],"datasetURIs":[],"constraints":["Non-Exclusive licence to publish copyright (please provide TRIM link)"],"useLimitConstraints":[],"accessConstraints":[],"childRecords":[],"date":"2018-04-22T00:00:00 UTC","minScale":null,"maxScale":null,"knownLayerIds":["pred-mine-disc-in-the-east-yilg-crat-an-exam-of-dist-targ-of-an-orog-gold-mine-syst"],"knownLayerNames":["Predictive Mineral Discovery In The Eastern Yilgarn Craton An Example Of District Scale Targeting Of An Orogenic Gold Mineral System"],"knownLayerDescriptions":["Predictive mineral discovery is concerned with the application of a whole of sys"]}],"relatedRecords":[],"capabilityRecords":[]},{"name":"Final Report 3D Geological Models Of The Eastern Yilgarn Craton Project Pmd Crc Y2 September 2001 December 2004","hidden":false,"description":"The pmd*CRC Y2 project operated for a little over three years, and in this time","id":"fina-repo-3d-geol-mode-of-the-east-yilg-crat-proj-pmd-y2-sept-2001-dece-2004","proxyUrl":null,"proxyGetFeatureInfoUrl":null,"proxyCountUrl":null,"proxyStyleUrl":null,"proxyDownloadUrl":null,"mapStyles":null,"feature_count":0,"singleTile":false,"legendImg":null,"previewImg":null,"group":"Reports - Geoscience Australia","layerMode":"NA","cswRecords":[{"name":"Final report, 3D geological models of the eastern Yilgarn Craton, Project pmd*CRC Y2, September 2001 - December 2004","resourceProvider":"Unknown","id":"a05f7892-ccc9-7506-e044-00144fdd4fa6","recordInfoUrl":"https://ecat.ga.gov.au/geonetwork/srv/eng/catalog.search#/metadata/a05f7892-ccc9-7506-e044-00144fdd4fa6","description":"<p>The pmd*CRC Y2 project operated for a little over three years, and in this time has more than met its goal and deliverables. This final report brings together a vast wealth of new knowledge, information and data, and is accompanied by a comprehensive DVD with all the source and derivative data, various presentations, papers, animations and posters etc.\n\n<p>At the start of the project the Y2 team was inexperienced in building 3D maps, and the early attempts were relatively crude and clumsy. Now, after more than three years of learning and testing, the project team has achieved an excellent result and methodology for building rigorous 3D maps. \nThe main achievement of the Y2 project has been the building of comprehensive 3D maps of Kalgoorlie-Kambalda and the Norseman-Wiluna region. The maps were built on a foundation of 2D solid geology maps from government agencies, universities and industry. These data were integrated with various geophysical data sets (seismic reflection, refraction, broadband recording, receiver function, gravity and magnetic data, plus various derivatives such as 'worms'), geochemical data sets (e.g., from P624), and geochronological data sets (from AMIRA P624 and earlier projects as well as published data). \n\n<p>The result of this integration is a more-holistic understanding of the EYC from a five questions approach. This understanding is outlined both in the maps and associated data sets, as well as this final report. The Y2 project has had its principal impact on answering the architecture question (Q2). The project has contributed to the geodynamics (Q1), drivers and pathways (Q3), fluids and their sources/reservoirs (Q4), and metal transport and deposition (Q5) questions.\n\n<p>The report is structured around the six key deliverables. Chapter 1 sets the geological scene and defines the tectono-stratigraphic nomenclature used throughout. Chapter 2 describes the work flow process devised to build the 3D maps. Chapter 3 discusses the seismic reflection and wide-angle reflection data and interpretations. Chapter 4 incorporates the mapping of the lithosphere and its velocity structure by using broadband seismic recording (tomography) and receiver function data (velocity profiles). Chapter 5 concerns the mapping of the chalcophile elements. Chapter 6 assesses the utility of 3D as opposed to 2D methodology, and discusses the structural history. Chapter 7 is a brief outline of the prospectivity analysis conducted by the pmd*CRC A1 project using Y2 project data. Chapter 8 is a synthesis chapter arranged by the five questions. Many of the new ideas and understanding built on the data and observations of the earlier chapters are developed. Chapter 9 has the project conclusions. Chapter 10 presents the scope of the next phase of the CRC as recommendations for future work. Extensive appendices (available only in the pdf file [DVD]) follow each chapter, including all pertinent publications and deliverables. \n\n<p>Acknowledgements as well as an outline of all data sources and intellectual property, and references complete the report.\n\n<p>Many authors contributed; Blewett and Hitchman edited the volume.","noCache":false,"service":false,"adminArea":"ACT","contactOrg":"Commonwealth of Australia (Geoscience Australia)","contactPerson":null,"funderOrg":"Unknown","authors":["Blewett, R.S.","Hitchman, A.P."],"onlineResources":[{"url":"https://d28rz98at9flks.cloudfront.net/64019/Rec2006_005.pdf","type":"WWW","name":"Download the Record (pdf)","description":"Download the Record (pdf)","version":"","applicationProfile":"","protocolRequest":""},{"url":"https://d28rz98at9flks.cloudfront.net/64019/Rec2006_005_appendices.zip","type":"WWW","name":"Appendices","description":"Appendices","version":"","applicationProfile":"","protocolRequest":""}],"geographicElements":[{"type":"bbox","eastBoundLongitude":125.0,"westBoundLongitude":116.0,"northBoundLatitude":-26.0,"southBoundLatitude":-32.0}],"descriptiveKeywords":["GA Publication","Record","mineral exploration","economic geology","pmd*CRC","AU-WA","Earth Sciences","Published_External"],"datasetURIs":[],"constraints":["Creative Commons Attribution 4.0 International Licence"],"useLimitConstraints":[],"accessConstraints":[],"childRecords":[],"date":"2025-10-15T00:00:00 UTC","minScale":null,"maxScale":null,"knownLayerIds":["fina-repo-3d-geol-mode-of-the-east-yilg-crat-proj-pmd-y2-sept-2001-dece-2004"],"knownLayerNames":["Final Report 3D Geological Models Of The Eastern Yilgarn Craton Project Pmd Crc Y2 September 2001 December 2004"],"knownLayerDescriptions":["The pmd*CRC Y2 project operated for a little over three years, and in this time"]}],"relatedRecords":[],"capabilityRecords":[]},{"name":"Cat 1 Exploration Licences Of Tasmania","hidden":false,"description":"Category 1 Exploration Licence polygons and Exploration Release Areas across Tasmania.","id":"cate-1-expl-lice-poly-of-tasm-min-reso-tasm","proxyUrl":null,"proxyGetFeatureInfoUrl":null,"proxyCountUrl":null,"proxyStyleUrl":null,"proxyDownloadUrl":null,"mapStyles":null,"feature_count":0,"singleTile":false,"legendImg":null,"previewImg":null,"group":"Tenements","layerMode":"NA","supportsCsvDownloads":true,"cswRecords":[{"name":"Category 1 Exploration Licence Polygons of Tasmania (Mineral Resources Tasmania)","resourceProvider":"Unknown","id":"662c6a13d506a7e3d6ea624cd17ae8e48cbb389d","recordInfoUrl":"https://portal.auscope.org.au/geonetwork/srv/eng/catalog.search#/metadata/662c6a13d506a7e3d6ea624cd17ae8e48cbb389d","description":"Category 1 Exploration Licence polygons and Exploration Release Areas across Tasmania, with tenement information derived from the Tasmanian Information on Geoscience and Exploration Resources (TIGER) system; administered by Mineral Resources Tasmania (MRT), Department of State Growth. Category 1 comprises any metallic mineral or atomic substance.","noCache":false,"service":false,"adminArea":null,"contactOrg":"Mineral Resources Ta