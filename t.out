uth Australia State Radiometry Total Count","id":"sa-rad-tc","proxyUrl":null,"proxyGetFeatureInfoUrl":null,"proxyCountUrl":null,"proxyStyleUrl":null,"proxyDownloadUrl":null,"mapStyles":null,"feature_count":0,"singleTile":false,"legendImg":null,"previewImg":null,"group":"Geophysics","layerMode":"NA","cswRecords":[{"name":"SA State Radiometrics Total Count","resourceProvider":"Unknown","id":"8f751c2c-a5e4-4a2b-84bf-621bf20b0835","recordInfoUrl":"https://portal.auscope.org.au/geonetwork/srv/eng/catalog.search#/metadata/8f751c2c-a5e4-4a2b-84bf-621bf20b0835","description":"","noCache":false,"service":false,"adminArea":null,"contactOrg":"Department for Energy and Mining, South Australia","contactPerson":"Geological Survey of South Australia","funderOrg":"Unknown","authors":[],"onlineResources":[{"url":"https://services.sarig.sa.gov.au/raster/GeophysicalStateImages/ows?SERVICE=WMS&","type":"WMS","name":"rad_tc","description":"rad_tc","version":"1.1.1","applicationProfile":"","protocolRequest":""},{"url":"https://services.sarig.sa.gov.au/raster/GeophysicalStateImages/ows?SERVICE=WCS&","type":"WCS","name":"rad_tc","description":"rad_tc","version":"","applicationProfile":"","protocolRequest":""}],"geographicElements":[{"type":"bbox","eastBoundLongitude":140.9964,"westBoundLongitude":128.6976,"northBoundLatitude":-25.9486,"southBoundLatitude":-38.1612}],"descriptiveKeywords":["rad_tc","WCS","GeoTIFF","World","Earth Sciences"],"datasetURIs":[],"constraints":["https://creativecommons.org/licenses/by/4.0"],"useLimitConstraints":["https://creativecommons.org/licenses/by/4.0"],"accessConstraints":[],"childRecords":[],"date":"2025-04-30T00:00:00 UTC","minScale":null,"maxScale":null,"knownLayerIds":["sa-rad-tc"],"knownLayerNames":["SA Radiometry Total Count"],"knownLayerDescriptions":["South Australia State Radiometry Total Count"]}],"relatedRecords":[],"capabilityRecords":[]},{"name":"Mine Waste - Geochemistry","hidden":false,"description":"This layer delivers geochemical analytical data for samples collected from Australian mine waste sites including tailings, wastes from mineral excavation, slag, fly ash and related mine waste materials. The mineral deposit models used in this layer are modified from the Critical Mineral Mapping Initiative mineral deposit classification scheme (Hofstra et al., 2021). Geoscience Australia partnered with researchers at the Sustainable Minerals Institute at The University of Queensland and the School of Engineering at RMIT University to combine world-class mineral systems understanding with world-leading mine waste research to provide vital data on critical minerals and strategic materials concentrations in mine waste, forming the foundation for secondary resource potential. The layer has been produced in collaboration with the Geological Survey of Queensland, the Geological Survey of New South Wales, the Northern Territory Geological Survey, the Geological Survey of Victoria, the Geological Survey of South Australia, the Geological Survey of Western Australia and Mineral Resources Tasmania.","id":"ama:MineWasteGeochem","proxyUrl":null,"proxyGetFeatureInfoUrl":null,"proxyCountUrl":null,"proxyStyleUrl":null,"proxyDownloadUrl":null,"mapStyles":null,"feature_count":0,"singleTile":false,"legendImg":null,"previewImg":null,"group":"Geochemistry","layerMode":"NA","cswRecords":[{"name":"Mine Waste - Geochemistry","resourceProvider":"Unknown","id":"c25e18446f07861a01f63c7547ccae9c8c40fec2","recordInfoUrl":"https://portal.auscope.org.au/geonetwork/srv/eng/catalog.search#/metadata/c25e18446f07861a01f63c7547ccae9c8c40fec2","description":"This layer delivers geochemical analytical data for samples collected from Australian mine waste sites including tailings, wastes from mineral excavation, slag, fly ash and related mine waste materials. The mineral deposit models used in this layer are modified from the Critical Mineral Mapping Initiative mineral deposit classification scheme (Hofstra et al., 2021).\n\nGeoscience Australia partnered with researchers at the Sustainable Minerals Institute at The University of Queensland and the School of Engineering at RMIT University to combine world-class mineral systems understanding with world-leading mine waste research to provide vital data on critical minerals and strategic materials concentrations in mine waste, forming the foundation for secondary resource potential.\n\nThe layer has been produced in collaboration with the Geological Survey of Queensland, the Geological Survey of New South Wales, the Northern Territory Geological Survey, the Geological Survey of Victoria, the Geological Survey of South Australia, the Geological Survey of Western Australia and Mineral Resources Tasmania.","noCache":false,"service":false,"adminArea":null,"contactOrg":"Geoscience Australia","contactPerson":null,"funderOrg":"Unknown","authors":[],"onlineResources":[{"url":"https://services.ga.gov.au/gis/earthresource/ows?SERVICE=WMS&","type":"WMS","name":"ama:MineWasteGeochem","description":"Mine Waste - Geochemistry","version":"1.1.1","applicationProfile":"","protocolRequest":""},{"url":"https://services.ga.gov.au/gis/earthresource/wfs","type":"WFS","name":"ama:MineWasteGeochem","description":"Mine Waste - Geochemistry","version":"","applicationProfile":"","protocolRequest":""}],"geographicElements":[{"type":"bbox","eastBoundLongitude":170.0,"westBoundLongitude":109.0,"northBoundLatitude":-7.0,"southBoundLatitude":-43.0}],"descriptiveKeywords":["Earth Sciences","mining waste","geochemistry","tailings","World","mine waste"],"datasetURIs":[],"constraints":["","https://creativecommons.org/licenses/by/4.0"],"useLimitConstraints":["https://creativecommons.org/licenses/by/4.0"],"accessConstraints":[],"childRecords":[],"date":"2023-08-18T00:00:00 UTC","minScale":null,"maxScale":null,"knownLayerIds":["ama:MineWasteGeochem"],"knownLayerNames":["Mine Waste - Geochemistry"],"knownLayerDescriptions":["This layer delivers geochemical analytical data for samples collected from Australian mine waste sites including tailings, wastes from mineral excavation, slag, fly ash and related mine waste materials. The mineral deposit models used in this layer are modified from the Critical Mineral Mapping Initiative mineral deposit classification scheme (Hofstra et al., 2021). Geoscience Australia partnered with researchers at the Sustainable Minerals Institute at The University of Queensland and the School of Engineering at RMIT University to combine world-class mineral systems understanding with world-leading mine waste research to provide vital data on critical minerals and strategic materials concentrations in mine waste, forming the foundation for secondary resource potential. The layer has been produced in collaboration with the Geological Survey of Queensland, the Geological Survey of New South Wales, the Northern Territory Geological Survey, the Geological Survey of Victoria, the Geological Survey of South Australia, the Geological Survey of Western Australia and Mineral Resources Tasmania."]}],"relatedRecords":[],"capabilityRecords":[]}],"msg":"","success":true}