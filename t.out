ent"]}],"relatedRecords":[],"capabilityRecords":[]},{"name":"TIR Quartz index","hidden":false,"description":"1. Band ratio: B11/(B10+B12)Blue is low quartz contentRed is high quartz content","id":"aster-quartz-index","proxyUrl":null,"proxyGetFeatureInfoUrl":null,"proxyCountUrl":null,"proxyStyleUrl":null,"proxyDownloadUrl":null,"mapStyles":null,"feature_count":0,"singleTile":false,"legendImg":null,"previewImg":null,"group":"ASTER Mineral Maps","layerMode":"NA","cswRecords":[{"name":"National ASTER Map TIR Quartz index","resourceProvider":"Resources Division","id":"f1011_7875_7538_2807","recordInfoUrl":"https://geonetwork.nci.org.au/geonetwork/srv/eng/catalog.search#/metadata/f1011_7875_7538_2807","description":"1. Band ratio: B11/(B10+B12) Blue is low quartz content Red is high quartz content\r\nGeoscience Applications: Use in combination with Silica index to more accurately map \"crystalline\" quartz rather than poorly ordered silica (e.g. opal), feldspars and compacted clays.\n\n\n--\nThis record represents data published by NCI. It uses catalogue metadata modified from Geoscience Australia. See our Record Lineage Information for more details.","noCache":false,"service":false,"adminArea":null,"contactOrg":"Commonwealth Scientific & Industrial Research Organisation (CSIRO)","contactPerson":"Cudahy, T.","funderOrg":"Unknown","authors":["Cudahy, T.","Caccetta, M.","Lau, I.","Rodger, A.","Laukamp, C.","Ong, C.","Chia, J.","Collings, S.","Rankine, T.","Fraser, R.","Woodcock, R.","Vote, J.","Warren, P.","Thomas, M.","Tyler, I.","Mauger, A.","Close, D.","Jones, M.","Abrams, M.","Cudahy, T.","Caccetta, M.","Lau, I.","Rodger, A.","Laukamp, C.","Ong, C.","Chia, J.","Collings, S.","Rankine, T.","Fraser, R.","Woodcock, R.","Vote, J.","Warren, P.","Thomas, M.","Tyler, I.","Mauger, A.","Close, D.","Jones, M.","Abrams, M.","Cudahy, T.","Caccetta, M.","Lau, I.","Rodger, A.","Laukamp, C.","Ong, C.","Chia, J.","Collings, S.","Rankine, T.","Fraser, R.","Woodcock, R.","Vote, J.","Warr