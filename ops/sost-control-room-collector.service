[Unit]
Description=SOST Control Room collector (read-only; single source of /api/control_room.json)
After=network-online.target sost-rpc-proxy.service
Wants=sost-rpc-proxy.service

[Service]
ExecStart=/usr/bin/python3 /opt/sost/ops/control-room-collector.py --rpc http://127.0.0.1:18299/ --out /var/www/sost-website/website/api/control_room.json --series-path /var/www/sost-website/website/api/block_series.json
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/sost-website/website/api
Nice=10

[Install]
WantedBy=multi-user.target
