{
  "vectors_version": 1,
  "description": "Official SOST Asset Registry v2 canonicalization contract (RFC-8785-lite). For every case, canon(input) MUST equal canon_expected and sha256Hex(canon_expected) MUST equal sha256_expected. Rules: object keys sorted by UTF-16 code unit ascending; null/undefined optional fields stripped before canon; strings via JSON.stringify escaping (Unicode preserved, hashed as UTF-8); numbers MUST be integers (non-integers throw -> money/decimals/timestamps are strings); arrays preserved in order; a passport claims[] is pre-sorted by claim id. Any external implementation reproducing these verifies manifestHash byte-for-byte.",
  "cases": [
    {
      "name": "empty_object",
      "input": {},
      "canon_expected": "{}",
      "sha256_expected": "44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a"
    },
    {
      "name": "ordering_keys",
      "input": {
        "2": 5,
        "10": 4,
        "b": 1,
        "a": 2,
        "Z": 3
      },
      "canon_expected": "{\"10\":4,\"2\":5,\"Z\":3,\"a\":2,\"b\":1}",
      "sha256_expected": "bbdfafaa7c09c3907d5410f8bbceb074436e290784be6670c326f1724e89cb98"
    },
    {
      "name": "ordering_unicode_keys",
      "input": {
        "é": 1,
        "z": 2,
        "A": 3,
        "_": 4
      },
      "canon_expected": "{\"A\":3,\"_\":4,\"z\":2,\"é\":1}",
      "sha256_expected": "9f6a34c8698c0f4b0de07ce7e8ca9de7cccbfa8e1b4737158f9b526a6e29084f"
    },
    {
      "name": "nested_and_array",
      "input": {
        "z": [
          3,
          1,
          2
        ],
        "a": {
          "y": "x",
          "b": null
        }
      },
      "canon_expected": "{\"a\":{\"b\":null,\"y\":\"x\"},\"z\":[3,1,2]}",
      "sha256_expected": "e907f0a4cf628b2d8cb04f081cd6db6e9ca67e07dd0eb85410f15d5010f24d0d"
    },
    {
      "name": "optional_null_stripped",
      "input": {
        "a": 1,
        "c": {
          "e": 2
        }
      },
      "canon_expected": "{\"a\":1,\"c\":{\"e\":2}}",
