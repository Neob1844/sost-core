    },
    {
      "name": "unicode_string",
      "input": {
        "s": "caña—€—日本語—😀"
      },
      "canon_expected": "{\"s\":\"caña—€—日本語—😀\"}",
      "sha256_expected": "77c8473f3ea664ae4578f7163123b5a8329eb9b76f05cdcdf0a5ff963b728388"
    },
    {
      "name": "booleans_and_integers",
      "input": {
        "t": true,
        "f": false,
        "zero": 0,
        "neg": -7,
        "big": 100000000
      },
      "canon_expected": "{\"big\":100000000,\"f\":false,\"neg\":-7,\"t\":true,\"zero\":0}",
      "sha256_expected": "eef4174d3ba14256db05049a3ce48a122d88194df8e10a270d28bd4afd0f8e53"
    },
    {
      "name": "money_strings",
      "input": {
        "amount": "1234.56",
        "currency": "EUR",
        "range_low": "0.00010000"
      },
      "canon_expected": "{\"amount\":\"1234.56\",\"currency\":\"EUR\",\"range_low\":\"0.00010000\"}",
      "sha256_expected": "d0da7c0cd886ed137c65148f39607c1ef23f0292e0c4cbaaa29fb6c9788efd30"
    },
    {
      "name": "arrays_in_order",
      "input": {
        "arr": [
          {
            "id": "c2"
          },
          {
            "id": "c1"
          },
          {
            "id": "c10"
          }
        ]
      },
      "canon_expected": "{\"arr\":[{\"id\":\"c2\"},{\"id\":\"c1\"},{\"id\":\"c10\"}]}",
      "sha256_expected": "f08b632ca6567ae2f0f0bb7e214be1d7bea63225f4c9ffd545ecf7ea6323e060"
    },
    {
      "name": "empty_array_kept",
