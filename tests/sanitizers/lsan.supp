# LeakSanitizer suppressions for the sanitizer build (ASan+UBSan+LSan):
#   ASAN_OPTIONS=detect_leaks=1 LSAN_OPTIONS=suppressions=tests/sanitizers/lsan.supp ctest
# secp256k1 verify/sign contexts are created once per process (function-local statics in
# src/gv_g5.cpp, src/popc_v15.cpp; plain locals in a few tests) and intentionally live until
# exit. 208 bytes each, never grows. Nothing else is suppressed.
leak:secp256k1_context_create
